        border: 0;
        border-radius: 999px;
        background: var(--chip-bg, transparent);
        /* 胶囊不叠 backdrop-filter：Firefox 会采样并饱和放大背后的首屏照片，造成跨浏览器色差 */
        box-shadow: inset 0 1px 0 var(--chip-highlight, transparent);
        transition: color 0.3s var(--ease), background 0.3s var(--ease),
          box-shadow 0.3s var(--ease);
      }

      .nav-link:hover,
      .nav-link.is-active {
        color: var(--text);
        background: var(--chip-bg-hover, transparent);
        box-shadow: inset 0 1px 0 var(--chip-highlight, transparent),
          0 6px 16px -12px rgba(0, 0, 0, 0.55);
      }

      .head-tools {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-left: auto;
        flex-shrink: 0;
      }

      .site-nav + .head-tools {
        margin-left: 0;
      }

      .track-switch {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 12.5px;
        color: var(--text-dim);
        padding: 6px 12px;
        border: 0;
        border-radius: 999px;
        background: var(--chip-bg, transparent);
        box-shadow: inset 0 1px 0 var(--chip-highlight, transparent);
        transition: color 0.3s var(--ease), background 0.3s var(--ease);
      }

      .track-switch:hover {
        color: var(--text);
        background: var(--chip-bg-hover, var(--accent-soft, rgba(59, 130, 246, 0.12)));
      }

      .track-icon {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--accent, var(--warm));
      }

      .site-nav.world-nav,
      .track-switch.world-track {
        display: none;
      }

      html[data-world='photo'] .site-nav.world-nav[data-world-nav='photo'],
      html[data-world='dev'] .site-nav.world-nav[data-world-nav='dev'],
      html[data-world='neutral'] .site-nav.world-nav[data-world-nav='neutral'] {
        display: flex;
      }

      html[data-world='photo'] .track-switch.world-track[data-world-track='photo'],
      html[data-world='dev'] .track-switch.world-track[data-world-track='dev'] {
        display: inline-flex;
      }

      html[data-world='dev'] .site-head.preserve-world-nav {
        --accent: var(--cool);
        --accent-soft: var(--cool-soft);
      }

      /* 关于 / 联系：内容强调色跟随工程主线 */
      html[data-world='dev'] body.world-aware {
        --accent: var(--cool);
        --accent-soft: var(--cool-soft);
      }

      .lang-switch {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        color: var(--text-faint);
        padding: 5px 9px;
        border-radius: 999px;
        background: var(--chip-bg, transparent);
        transition: color 0.3s var(--ease), background 0.3s var(--ease);
      }

      .lang-switch:hover {
        color: var(--text);
        background: var(--chip-bg-hover, transparent);
      }

      .site-foot {
        border-top: 1px solid var(--line);
        padding-block: 44px 52px;
        margin-top: 40px;
      }

      .foot-inner {
        display: grid;
        gap: 22px;
      }

      .foot-brand {
        display: flex;
        align-items: baseline;
        gap: 14px;
        flex-wrap: wrap;
      }

      .foot-links {
        display: flex;
        flex-wrap: wrap;
        gap: 26px;
        font-size: 13px;
        color: var(--text-dim);
      }

      .foot-links a {
        transition: color 0.3s var(--ease);
      }

      .foot-links a:hover {
        color: var(--text);
      }

      .foot-note {
        color: var(--text-faint);
      }

      .accent-warm {
        --accent: var(--warm);
        --accent-soft: var(--warm-soft);
      }

      .accent-cool {
        --accent: var(--cool);
        --accent-soft: var(--cool-soft);
      }

      @media (max-width: 880px) {
        .site-head {
          height: auto;
        }
        .head-inner {
          flex-wrap: wrap;
          justify-content: space-between;
          padding-block: 12px 8px;
          gap: 8px 16px;
        }
        .site-nav {
          display: flex;
          order: 3;
          width: 100%;
          margin-left: 0;
          gap: 8px;
          overflow-x: auto;
          padding-bottom: 4px;
          scrollbar-width: none;
        }
        .site-nav::-webkit-scrollbar {
          display: none;
        }
        .nav-link {
          white-space: nowrap;
        }
        .head-tools {
          margin-left: 0;
        }
      }
    </style>
  </body>
</html>
