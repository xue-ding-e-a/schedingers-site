---
import '../styles/global.css';
import ContactFooter from '../components/ContactFooter.astro';
import { SITE, NAV, PHOTO_NAV, DEV_NAV } from '../consts';
import { useTranslations, localizePath, withBase, stripBase } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  section?: 'photo' | 'dev' | 'neutral';
  chrome?: boolean;
  image?: string;
  accent?: 'warm' | 'cool';
  preserveWorldNav?: boolean;
}

const {
  lang,
  title,
  description = lang === 'zh' ? SITE.role.zh : SITE.role.en,
  section = 'neutral',
  chrome = true,
  image = '/images/works/galactic-arch-snow-mountain-thumb.webp',
  accent = section === 'dev' ? 'cool' : 'warm',
  preserveWorldNav = false,
} = Astro.props;

const t = useTranslations(lang);
const adoptStoredWorld = chrome && section === 'neutral';
const themeColor = section === 'dev' ? '#fffdf8' : section === 'photo' ? '#000000' : '#0f172a';

const path = stripBase(Astro.url.pathname);
const basePath = path.startsWith('/en') ? path.slice(3) || '/' : path;
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
const switchHref = withBase(otherLang === 'en' ? (basePath === '/' ? '/en/' : `/en${basePath}`) : basePath);

const getCrossTrack = (world: 'photo' | 'dev' | 'neutral') =>
  world === 'photo'
    ? { href: '/dev', label: lang === 'zh' ? '工程' : 'Engineering', icon: '</>' }
    : world === 'dev'
      ? { href: '/photo', label: lang === 'zh' ? '摄影' : 'Photography', icon: '✦' }
      : null;

const worlds = preserveWorldNav ? (['photo', 'dev', 'neutral'] as const) : [section];
const navVariants = worlds.map((world) => {
  const items: readonly { key: string; href: string }[] =
    world === 'photo' ? PHOTO_NAV : world === 'dev' ? DEV_NAV : NAV;
  return { world, items, crossTrack: getCrossTrack(world) };
});

const siteName = SITE.name[lang];
const fullTitle = path === '/' || path === '/en/' ? `${siteName} — ${t('site.tagline')}` : `${title} · ${siteName}`;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-world={section}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(withBase(basePath), Astro.site)} />
    <link rel="alternate" hreflang={otherLang === 'zh' ? 'zh-CN' : 'en'} href={new URL(switchHref, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(withBase(image), Astro.site)} />
    <meta name="theme-color" content={themeColor} />
    <slot name="head" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <script is:inline define:vars={{ section, adoptStoredWorld }}>
      (function () {
        var root = document.documentElement;
        try {
          if (section === 'photo' || section === 'dev') {
            localStorage.setItem('sch-world', section);
            root.dataset.world = section;
          } else if (adoptStoredWorld) {
            var stored = localStorage.getItem('sch-world');
            if (stored === 'dev' || stored === 'photo') root.dataset.world = stored;
          }
          // 从过渡动画跳转过来时：先停在「图案 + 目标页背景」的画面，
          // 等首屏绘制完成后再展开回文字，避免整页重绘的生硬切换
          var arrived = sessionStorage.getItem('sch-logo-arrived');
          if (arrived && arrived === section) {
            sessionStorage.removeItem('sch-logo-arrived');
            // 来源页在导航期间写入的起步进度，目标页从这里接续，保证轨道画面不跳变
            var startProgress = 0;
            try {
              startProgress = parseFloat(sessionStorage.getItem('sch-logo-progress')) || 0;
              sessionStorage.removeItem('sch-logo-progress');
            } catch (e) {}
            if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
              root.classList.add('logo-arrived');
              var playArrival = function () {
                var warp = document.querySelector('.arrive-warp');
                var mark = warp ? warp.querySelector('.world-warp-mark') : null;
                var dot = warp ? warp.querySelector('.warp-dot') : null;
                var arc = warp ? warp.querySelector('.warp-orbit--' + section) : null;
                var slot = document.querySelector('.brand-slot--mark');

                // 轨道几何，与来源页完全一致
                var CENTER = 32;
                var RX = 27;
                var RY = 10.5;
                var TAU = Math.PI * 2;
                var WORLDS = {
                  photo: { dot: [228, 171, 99] },
                  dev: { dot: [124, 103, 228] }
                };
                var source = section === 'dev' ? 'photo' : 'dev';
                var rad = function (deg) { return (deg * Math.PI) / 180; };
                var easeInOut = function (t) {
                  return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
                };
                var mix = function (a, b, t) { return a + (b - a) * t; };
                var ellipsePoint = function (rot, angle) {
                  var c = Math.cos(rad(rot));
                  var s = Math.sin(rad(rot));
                  var x = RX * Math.cos(angle);
                  var y = RY * Math.sin(angle);
                  return { x: CENTER + x * c - y * s, y: CENTER + x * s + y * c };
                };
                var angleOnTrack = function (rot, x, y) {
                  var c = Math.cos(rad(rot));
                  var s = Math.sin(rad(rot));
                  var dx = x - CENTER;
                  var dy = y - CENTER;
                  var lx = dx * c + dy * s;
                  var ly = -dx * s + dy * c;
                  return Math.atan2(ly / RY, lx / RX);
                };
                var topY = CENTER - 11.83;
                var bottomY = CENTER + 11.83;
                var plans = {
                  'photo-dev': {
                    from: { rot: 30, a: -Math.PI, b: angleOnTrack(30, CENTER, bottomY) - TAU },
                    to: { rot: -30, a: angleOnTrack(-30, CENTER, bottomY), b: 0 }
                  },
                  'dev-photo': {
                    from: { rot: -30, a: 0, b: angleOnTrack(-30, CENTER, topY) },
                    to: { rot: 30, a: angleOnTrack(30, CENTER, topY), b: -Math.PI }
                  }
                };
                var plan = plans[source + '-' + section];
                var crossed = false;

                var paintAlong = function (p) {
                  if (!plan || !dot) return;
                  var point;
                  var colorT = 0;
                  if (p < 0.42) {
                    point = ellipsePoint(plan.from.rot, mix(plan.from.a, plan.from.b, easeInOut(p / 0.42)));
                  } else if (p < 0.56) {
                    point = ellipsePoint(plan.to.rot, plan.to.a);
                    if (!crossed) {
                      crossed = true;
                      warp.dataset.world = section;
                    }
                  } else {
                    var t = easeInOut(Math.min(1, (p - 0.56) / 0.44));
                    point = ellipsePoint(plan.to.rot, mix(plan.to.a, plan.to.b, t));
                    colorT = Math.min(1, t / 0.55);
                  }
                  dot.setAttribute('cx', point.x.toFixed(2));
                  dot.setAttribute('cy', point.y.toFixed(2));
                  var from = WORLDS[source].dot;
                  var to = WORLDS[section].dot;
                  dot.style.color = 'rgb(' + Math.round(mix(from[0], to[0], colorT)) + ',' +
                    Math.round(mix(from[1], to[1], colorT)) + ',' + Math.round(mix(from[2], to[2], colorT)) + ')';
                  // 目标轨道即进度条：描边随进度画出
                  if (arc) arc.setAttribute('stroke-dashoffset', (100 - p * 100).toFixed(2));
                };

                // 真实加载里程碑 → 目标进度（懒加载图片不阻塞 load，不计入）
                var fontsDone = 0;
                var loadDone = 0;
                var heroDone = section === 'photo' ? 0 : 1;
                var imgs = Array.prototype.slice.call(document.images).filter(function (im) {
                  return im.loading !== 'lazy';
                });
                var imgRatio = imgs.length ? 0 : 1;
                var countImg = function () {
                  if (!imgs.length) {
                    imgRatio = 1;
                    return;
                  }
                  var done = 0;
                  imgs.forEach(function (im) { if (im.complete) done++; });
                  imgRatio = done / imgs.length;
                };
                countImg();
                imgs.forEach(function (im) {
                  if (im.complete) return;
                  im.addEventListener('load', countImg);
                  im.addEventListener('error', countImg);
                });
                if (document.fonts && document.fonts.ready) {
                  document.fonts.ready.then(function () { fontsDone = 1; }, function () { fontsDone = 1; });
                } else {
                  fontsDone = 1;
                }
                if (document.readyState === 'complete') {
                  loadDone = 1;
                } else {
                  window.addEventListener('load', function () { loadDone = 1; }, { once: true });
                }
                if (section === 'photo') {
                  var hero = document.querySelector('[data-hero]');
                  if (!hero) {
                    heroDone = 1;
                  } else {
                    var isSettled = function () {
                      return hero.hasAttribute('data-photo-settled') ||
                        (!hero.hasAttribute('data-photo-initialized') && !hero.hasAttribute('data-photo-loading'));
                    };
                    if (isSettled()) {
                      heroDone = 1;
                    } else {
                      var observer = new MutationObserver(function () {
                        if (!isSettled()) return;
                        observer.disconnect();
                        heroDone = 1;
                      });
                      observer.observe(hero, {
                        attributes: true,
                        attributeFilter: ['data-photo-settled', 'data-photo-initialized', 'data-photo-loading']
                      });
                    }
                  }
                }

                var revealed = false;
                var reveal = function () {
                  if (revealed) return;
                  revealed = true;
                  requestAnimationFrame(function () {
                    requestAnimationFrame(function () {
                      root.classList.add('logo-arrived--play');
                      setTimeout(function () {
                        root.classList.remove('logo-arrived');
                        root.classList.remove('logo-arrived--play');
                        root.classList.remove('logo-arrived--settled');
                        if (warp) warp.remove();
                      }, 1000);
                    });
                  });
                };

                var finished = false;
                // 进度满格后：全屏 logo 收缩回顶部 logo，再展开文字与正文
                var shrinkAndReveal = function () {
                  var finish = function () {
                    root.classList.add('logo-arrived--settled');
                    reveal();
                  };
                  if (!mark || !slot) {
                    finish();
                    return;
                  }
                  var from = mark.getBoundingClientRect();
                  var to = slot.getBoundingClientRect();
                  if (!from.width || !to.width) {
                    finish();
                    return;
                  }
                  var scale = to.width / from.width;
                  var dx = to.left + to.width / 2 - (from.left + from.width / 2);
                  var dy = to.top + to.height / 2 - (from.top + from.height / 2);
                  mark.style.transformOrigin = 'center';
                  mark.style.transition = 'transform 0.34s cubic-bezier(0.22, 1, 0.36, 1)';
                  mark.style.transform = 'translate(' + dx + 'px,' + dy + 'px) scale(' + scale + ')';
                  setTimeout(finish, 340);
                };

                // 统一用 0–100 的百分比推进；真实进度允许跳跃，画面按固定速率逐份补齐
                var initialProgress = Math.max(0, Math.min(100, startProgress * 100));
                var displayed = initialProgress;
                var last = performance.now();
                var animStart = last;
                // 全程匀分为 100 份，避免少数资源里程碑完成时 Logo 突然跳过一大段；
                // 加载慢时 cap 可以先到 100，但画面仍等待真实进度，不会提前满格
                var MIN_TRAVEL = 1200;
                var MS_PER_PERCENT = MIN_TRAVEL / 100;
                var tick = function (now) {
                  if (finished) return;
                  // DOMContentLoaded 占 15%，其余由图片、字体、load、首屏图共同推进
                  var loaded = Math.max(initialProgress, Math.min(100, Math.round(
                    (0.15 + 0.45 * imgRatio + 0.15 * fontsDone + 0.15 * loadDone + 0.10 * heroDone) * 100
                  )));
                  var cap = initialProgress + (100 - initialProgress) * Math.min(1, (now - animStart) / MIN_TRAVEL);
                  var target = Math.min(loaded, cap);
                  var elapsed = Math.max(0, now - last);
                  last = now;
                  displayed = Math.min(target, displayed + elapsed / MS_PER_PERCENT);
                  paintAlong(Math.min(1, displayed / 100));
                  if (loaded >= 100 && cap >= 100 && displayed >= 99.999) {
                    finished = true;
                    paintAlong(1);
                    shrinkAndReveal();
                    return;
                  }
                  requestAnimationFrame(tick);
                };
                paintAlong(initialProgress / 100);
                requestAnimationFrame(tick);

                // 资源异常时兜底：直接补满进度并展开，不让正文一直隐藏
                setTimeout(function () {
                  fontsDone = 1;
                  loadDone = 1;
                  heroDone = 1;
                  imgRatio = 1;
                }, 4000);
                setTimeout(function () {
                  if (finished) return;
                  finished = true;
                  root.classList.add('logo-arrived--settled');
                  reveal();
                }, 5000);
              };
              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', playArrival);
              } else {
                playArrival();
              }
            }
          }
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) {
            meta.setAttribute(
              'content',
              root.dataset.world === 'dev' ? '#fffdf8' : root.dataset.world === 'photo' ? '#000000' : '#0f172a'
            );
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class:list={['page', `accent-${accent}`, { 'world-aware': preserveWorldNav }]}>
    {
      /* 主线切换抵达时的过渡层：首帧接续来源页轨道画面，轨道描边即真实加载进度条 */
      chrome && (
        <div
          class="world-warp arrive-warp is-on is-armed"
          data-world={section === 'dev' ? 'photo' : 'dev'}
          data-target={section}
          aria-hidden="true"
        >
          <svg class="world-warp-mark" viewBox="0 0 64 64" focusable="false">
            <g transform="rotate(30 32 32)">
              <ellipse
                class="warp-orbit warp-orbit--photo"
                cx="32"
                cy="32"
                rx="27"
                ry="10.5"
                pathLength="100"
                stroke-dasharray={section === 'photo' ? '100' : undefined}
                stroke-dashoffset={section === 'photo' ? '100' : undefined}
              />
            </g>
            <g transform="rotate(-30 32 32)">
              <ellipse
                class="warp-orbit warp-orbit--dev"
                cx="32"
                cy="32"
                rx="27"
                ry="10.5"
                pathLength="100"
                stroke-dasharray={section === 'dev' ? '100' : undefined}
                stroke-dashoffset={section === 'dev' ? '100' : undefined}
              />
            </g>
            <circle class="warp-core" cx="32" cy="32" r="8" />
            <circle
              class="warp-dot"
              cx={section === 'dev' ? '8.62' : '55.38'}
              cy="18.5"
              r="3.4"
              style={`color: ${section === 'dev' ? '#e4ab63' : '#7c67e4'}`}
            />
          </svg>
        </div>
      )
    }
    {
      chrome && (
        <header
          class:list={['site-head', { 'preserve-world-nav': preserveWorldNav }]}
          data-section={section}
        >
          <div class="head-inner">
            <a class="brand" href={localizePath('/', lang)} aria-label={siteName}>
              <span class="brand-slot brand-slot--mark">
                <svg
                  class="brand-mark"
                  viewBox="0 0 64 64"
                  width="26"
                  height="26"
                  aria-hidden="true"
                  focusable="false"
                >
                  <g class="mark-track mark-track--photo" transform="rotate(30 32 32)">
                    <ellipse class="mark-orbit" cx="32" cy="32" rx="27" ry="10.5" />
                    <g class="mark-dot-swing">
                      <circle class="mark-dot mark-dot--photo" cx="5" cy="32" r="3.4" />
                    </g>
                  </g>
                  <g class="mark-track mark-track--dev" transform="rotate(-30 32 32)">
                    <ellipse class="mark-orbit" cx="32" cy="32" rx="27" ry="10.5" />
                    <g class="mark-dot-swing">
                      <circle class="mark-dot mark-dot--dev" cx="59" cy="32" r="3.4" />
                    </g>
                  </g>
                  <circle class="mark-core" cx="32" cy="32" r="8" />
                </svg>
              </span>
              <span class="brand-slot brand-slot--word">
                <span class="brand-word" aria-hidden="true"><span class="brand-glyph" style="--i:0">S</span><span class="brand-glyph" style="--i:1"><span class="brand-cut">C</span></span><span class="brand-glyph" style="--i:2">H</span><span class="brand-glyph" style="--i:3"><span class="brand-cut">E</span></span><span class="brand-glyph" style="--i:4">D</span><span class="brand-glyph" style="--i:5">I</span><span class="brand-glyph" style="--i:6">N</span><span class="brand-glyph" style="--i:7">G</span><span class="brand-glyph" style="--i:8">E</span><span class="brand-glyph" style="--i:9">R</span></span>
              </span>
            </a>

            {navVariants.map(({ world, items }) => (
              <nav
                class:list={['site-nav', { 'world-nav': preserveWorldNav }]}
                data-world-nav={world}
                aria-label="Primary"
              >
                {items.map((item) => {
                  const href = localizePath(item.href, lang);
                  // 静态目录索引的 URL 带尾部斜杠（/dev/about/），而导航 href 不带（/dev/about），
                  // 归一化后再比较，保证当前页导航项能正确高亮
                  const active =
                    basePath.replace(/\/+$/, '') === item.href.replace(/\/+$/, '');
                  return (
                    <a href={href} class:list={['nav-link', { 'is-active': active }]}>
                      {t(`nav.${item.key}` as any)}
                    </a>
                  );
                })}
              </nav>
            ))}

            <div class="head-tools">
              {navVariants.map(({ world, crossTrack }) =>
                crossTrack ? (
                  <a
                    class:list={['track-switch', { 'world-track': preserveWorldNav }]}
                    data-world-track={world}
                    href={localizePath(crossTrack.href, lang)}
                  >
                    <span class="track-icon" aria-hidden="true">{crossTrack.icon}</span>
                    {crossTrack.label}
                  </a>
                ) : null
              )}
              <a class="lang-switch" href={switchHref} hreflang={otherLang} lang={otherLang}>
                {otherLang === 'zh' ? '中文' : 'EN'}
              </a>
            </div>
          </div>
        </header>
      )
    }

    <main>
      <slot />
    </main>

    {
      chrome && (
        <footer class="site-foot">
          <div class="container-wide">
            <ContactFooter lang={lang} engineering={section === 'dev'} />
            <div class="foot-inner">
              <div class="foot-brand">
                <span class="brand-text">{siteName}</span>
                <span class="mono">{t('site.tagline')}</span>
              </div>
              <div class="foot-links">
                <a href={localizePath('/', lang)}>{t('footer.back')}</a>
                <a href={localizePath('/index', lang)}>{t('footer.index')}</a>
                <a href={localizePath('/credits', lang)}>{t('footer.credit')}</a>
              </div>
              <p class="foot-note mono">
                © {new Date().getFullYear()} {SITE.author[lang]} · {t('footer.rights')}
              </p>
            </div>
          </div>
        </footer>
      )
    }

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduced) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-in'));
      }

      // logo：顶部为文字，悬停或下拉后文字左滚卷起、图案横向展开
      const brandEl = document.querySelector('.brand');
      let brandHovered = false;
      const syncBrand = () => {
        if (!brandEl) return;
        brandEl.classList.toggle('is-marked', brandHovered || window.scrollY > 24);
      };
      if (brandEl) {
        brandEl.addEventListener('pointerenter', (event) => {
          if (event.pointerType !== 'mouse') return;
          brandHovered = true;
          syncBrand();
        });
        brandEl.addEventListener('pointerleave', () => {
          brandHovered = false;
          syncBrand();
        });
      }

      const head = document.querySelector('.site-head');
      if (head) {
        const onScroll = () => {
          head.classList.toggle('is-scrolled', window.scrollY > 24);
          syncBrand();
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        // 暴露真实导航高度（移动端为两行），供首屏图向上延伸使用
        const root = document.documentElement;
        const syncHeadH = () => root.style.setProperty('--head-h', `${head.offsetHeight}px`);
        syncHeadH();
        window.addEventListener('resize', syncHeadH, { passive: true });
        window.addEventListener('load', syncHeadH);
      }

      // 轨道切换：全屏轨道过渡，动画期间预加载目标页面
      const brandMark = document.querySelector('.brand-mark');
      if (brandMark) {
        const switchLinks = document.querySelectorAll('.track-switch');
        const CENTER = 32;
        const RX = 27;
        const RY = 10.5;
        const TAU = Math.PI * 2;
        const WORLDS = {
          photo: { dot: [228, 171, 99] },
          dev: { dot: [124, 103, 228] }
        };
        let switching = false;
        let warpEl = null;
        const warmed = new Map();

        const rad = (deg) => (deg * Math.PI) / 180;
        const easeInOut = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
        const mix = (a, b, t) => a + (b - a) * t;

        const ellipsePoint = (rot, angle) => {
          const c = Math.cos(rad(rot));
          const s = Math.sin(rad(rot));
          const x = RX * Math.cos(angle);
          const y = RY * Math.sin(angle);
          return {
            x: CENTER + x * c - y * s,
            y: CENTER + x * s + y * c
          };
        };

        const angleOnTrack = (rot, x, y) => {
          const c = Math.cos(rad(rot));
          const s = Math.sin(rad(rot));
          const dx = x - CENTER;
          const dy = y - CENTER;
          const lx = dx * c + dy * s;
          const ly = -dx * s + dy * c;
          return Math.atan2(ly / RY, lx / RX);
        };

        // 两条椭圆在上、下方各有一个真实交点
        const topY = CENTER - 11.83;
        const bottomY = CENTER + 11.83;
        const photoBottom = angleOnTrack(30, CENTER, bottomY);
        const photoTop = angleOnTrack(30, CENTER, topY);
        const devBottom = angleOnTrack(-30, CENTER, bottomY);
        const devTop = angleOnTrack(-30, CENTER, topY);

        // 摄影 → 工程走下方交点，工程 → 摄影走上方交点
        const plans = {
          'photo-dev': {
            from: { rot: 30, a: -Math.PI, b: photoBottom - TAU },
            to: { rot: -30, a: devBottom, b: 0 }
          },
          'dev-photo': {
            from: { rot: -30, a: 0, b: devTop },
            to: { rot: 30, a: photoTop, b: -Math.PI }
          }
        };

        // 抓取目标页面 HTML，并预加载其中靠前的图片
        const warmTarget = (href) => {
          if (warmed.has(href)) return warmed.get(href);
          const job = (async () => {
            let html = '';
            try {
              const res = await fetch(href, { credentials: 'same-origin' });
              if (res.ok) html = await res.text();
            } catch (e) {}
            if (!html) return;

            const doc = new DOMParser().parseFromString(html, 'text/html');
            const urls = [];
            doc.querySelectorAll('img:not(noscript img)').forEach((img) => {
              const src = img.getAttribute('src');
              if (src) urls.push(src);
              const srcset = img.getAttribute('srcset');
              if (srcset) {
                const first = srcset.split(',')[0].trim().split(/\s+/)[0];
                if (first) urls.push(first);
              }
            });
            doc.querySelectorAll('link[rel="preload"][as="image"]').forEach((link) => {
              const src = link.getAttribute('href');
              if (src) urls.push(src);
            });

            const unique = Array.from(new Set(urls)).slice(0, 8);
            await Promise.all(
              unique.map(
                (src) =>
                  new Promise((resolve) => {
                    const img = new Image();
                    img.onload = resolve;
                    img.onerror = resolve;
                    img.fetchPriority = 'high';
                    img.src = src;
                  })
              )
            );
          })();
          warmed.set(href, job);
          return job;
        };

        const buildWarp = () => {
          if (warpEl) return warpEl;
          warpEl = document.createElement('div');
          warpEl.className = 'world-warp';
          warpEl.setAttribute('aria-hidden', 'true');
          warpEl.innerHTML = [
            '<svg class="world-warp-mark" viewBox="0 0 64 64" focusable="false">',
            '<g transform="rotate(30 32 32)"><ellipse class="warp-orbit warp-orbit--photo" cx="32" cy="32" rx="27" ry="10.5" pathLength="100" /></g>',
            '<g transform="rotate(-30 32 32)"><ellipse class="warp-orbit warp-orbit--dev" cx="32" cy="32" rx="27" ry="10.5" pathLength="100" /></g>',
            '<circle class="warp-core" cx="32" cy="32" r="8" />',
            '<circle class="warp-dot" cx="8.62" cy="18.5" r="3.4" />',
            '</svg>'
          ].join('');
          document.body.appendChild(warpEl);
          return warpEl;
        };

        const startSwitch = (event, link) => {
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey ||
            (link.target && link.target !== '_self')
          ) {
            return;
          }

          const current = document.documentElement.dataset.world;
          if (current !== 'photo' && current !== 'dev') return;
          if (switching) {
            event.preventDefault();
            return;
          }

          const target = current === 'photo' ? 'dev' : 'photo';
          const plan = plans[`${current}-${target}`];
          if (!plan) return;

          event.preventDefault();
          switching = true;
          document.documentElement.style.overflow = 'hidden';
          if (brandEl) brandEl.classList.add('is-marked');

          const warp = buildWarp();
          const dot = warp.querySelector('.warp-dot');
          // 目标轨道本身就是进度条：用 dashoffset 随真实加载进度描出轨道
          const arc = warp.querySelector(`.warp-orbit--${target}`);
          arc.setAttribute('stroke-dasharray', '100');
          arc.setAttribute('stroke-dashoffset', '100');
          warp.classList.add('is-reset');
          warp.dataset.world = current;
          warp.dataset.target = target;
          void warp.offsetWidth;
          warp.classList.remove('is-reset');

          const paintDot = (point, colorT) => {
            dot.setAttribute('cx', point.x.toFixed(2));
            dot.setAttribute('cy', point.y.toFixed(2));
            const from = WORLDS[current].dot;
            const to = WORLDS[target].dot;
            dot.style.color = `rgb(${Math.round(mix(from[0], to[0], colorT))},${Math.round(
              mix(from[1], to[1], colorT)
            )},${Math.round(mix(from[2], to[2], colorT))})`;
          };

          let crossed = false;
          // 进度 → 轨道画面：三段路径保持不变（滑向交点 → 悬停换轨 → 滑到目标端点）
          const paintAlong = (p) => {
            let point;
            let colorT = 0;
            if (p < 0.42) {
              point = ellipsePoint(plan.from.rot, mix(plan.from.a, plan.from.b, easeInOut(p / 0.42)));
            } else if (p < 0.56) {
              point = ellipsePoint(plan.to.rot, plan.to.a);
              if (!crossed) {
                crossed = true;
                warp.dataset.world = target;
              }
            } else {
              const t = easeInOut(Math.min(1, (p - 0.56) / 0.44));
              point = ellipsePoint(plan.to.rot, mix(plan.to.a, plan.to.b, t));
              colorT = Math.min(1, t / 0.55);
            }
            paintDot(point, colorT);
            arc.setAttribute('stroke-dashoffset', (100 - p * 100).toFixed(2));
          };

          paintAlong(0);

          void warp.offsetWidth;
          warp.classList.add('is-on');
          requestAnimationFrame(() => warp.classList.add('is-armed'));

          // 真实导航立即发起：轨道一边走，目标页一边加载。
          // 来源页只让色点缓慢起步，进度持续写入 sessionStorage，由目标页接续真实进度。
          const begin = performance.now();
          let lastWrite = 0;
          const crawl = (now) => {
            const p = 0.12 * (1 - Math.exp(-(now - begin) / 500));
            paintAlong(p);
            if (now - lastWrite > 80) {
              lastWrite = now;
              try {
                sessionStorage.setItem('sch-logo-progress', p.toFixed(4));
              } catch (e) {}
            }
            requestAnimationFrame(crawl);
          };
          requestAnimationFrame(crawl);

          try {
            sessionStorage.setItem('sch-logo-arrived', target);
            sessionStorage.setItem('sch-logo-progress', '0');
          } catch (e) {}
          window.location.assign(link.href);
        };

        if (!reduced) {
          switchLinks.forEach((link) => {
            link.addEventListener('click', (event) => startSwitch(event, link));
            link.addEventListener('pointerenter', () => warmTarget(link.href), { passive: true });
            link.addEventListener('focus', () => warmTarget(link.href));
          });

          // bfcache 返回时清理过渡层
          window.addEventListener('pageshow', (event) => {
            if (!event.persisted) return;
            switching = false;
            document.documentElement.style.overflow = '';
            if (warpEl) {
              warpEl.remove();
              warpEl = null;
            }
          });
        }
      }
    </script>

