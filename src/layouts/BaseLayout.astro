---
import '../styles/global.css';
import ContactFooter from '../components/ContactFooter.astro';
import { SITE, NAV, PHOTO_NAV, DEV_NAV } from '../consts';
import { useTranslations, localizePath, withBase, stripBase } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  section?: 'photo' | 'dev' | 'neutral';
  chrome?: boolean;
  image?: string;
  accent?: 'warm' | 'cool';
  preserveWorldNav?: boolean;
}

const {
  lang,
  title,
  description = lang === 'zh' ? SITE.role.zh : SITE.role.en,
  section = 'neutral',
  chrome = true,
  image = '/images/works/galactic-arch-snow-mountain-thumb.webp',
  accent = section === 'dev' ? 'cool' : 'warm',
  preserveWorldNav = false,
} = Astro.props;

const t = useTranslations(lang);
const crossProgress = 0.42;
const crossOffset = 1 / Math.hypot(0.5 / 27, Math.sqrt(0.75) / 10.5);
const adoptStoredWorld = chrome && section === 'neutral';
const themeColor = section === 'dev' ? '#fffdf8' : section === 'photo' ? '#000000' : '#0f172a';

const path = stripBase(Astro.url.pathname);
const basePath = path.startsWith('/en') ? path.slice(3) || '/' : path;
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
const switchHref = withBase(otherLang === 'en' ? (basePath === '/' ? '/en/' : `/en${basePath}`) : basePath);

const getCrossTrack = (world: 'photo' | 'dev' | 'neutral') =>
  world === 'photo'
    ? { href: '/dev', label: lang === 'zh' ? '工程' : 'Engineering', icon: '</>' }
    : world === 'dev'
      ? { href: '/photo', label: lang === 'zh' ? '摄影' : 'Photography', icon: '✦' }
      : null;

const worlds = preserveWorldNav ? (['photo', 'dev', 'neutral'] as const) : [section];
const navVariants = worlds.map((world) => {
  const items: readonly { key: string; href: string }[] =
    world === 'photo' ? PHOTO_NAV : world === 'dev' ? DEV_NAV : NAV;
  return { world, items, crossTrack: getCrossTrack(world) };
});

const siteName = SITE.name[lang];
const fullTitle = path === '/' || path === '/en/' ? `${siteName} — ${t('site.tagline')}` : `${title} · ${siteName}`;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-world={section}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(withBase(basePath), Astro.site)} />
    <link rel="alternate" hreflang={otherLang === 'zh' ? 'zh-CN' : 'en'} href={new URL(switchHref, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(withBase(image), Astro.site)} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <script is:inline define:vars={{ section, adoptStoredWorld, chrome, crossProgress, crossOffset }}>
      (function () {
        var root = document.documentElement;
        try {
          if (section === 'photo' || section === 'dev') {
            localStorage.setItem('sch-world', section);
            root.dataset.world = section;
          } else if (adoptStoredWorld) {
            var stored = localStorage.getItem('sch-world');
            if (stored === 'dev' || stored === 'photo') root.dataset.world = stored;
          }
          var arrived = sessionStorage.getItem('sch-logo-arrived');
          if (arrived) sessionStorage.removeItem('sch-logo-arrived');
          if (chrome && arrived && arrived === location.pathname.replace(/\/$/, '') &&
              !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            root.classList.add('logo-arrived');
            var playArrival = function () {
              var warp = document.querySelector('.arrive-warp');
              var mark = warp ? warp.querySelector('.world-warp-mark') : null;
              var dot = warp ? warp.querySelector('.warp-dot') : null;
              var arc = warp ? warp.querySelector('.warp-orbit--' + section) : null;
              var slot = document.querySelector('.brand-slot--mark');
              var isPhoto = section === 'photo';
              var tilt = isPhoto ? Math.PI / 6 : -Math.PI / 6;
              var crossY = isPhoto ? -crossOffset : crossOffset;
              var startAngle = Math.atan2(crossY * Math.cos(tilt) / 10.5, crossY * Math.sin(tilt) / 27);
              var endAngle = isPhoto ? -Math.PI : 0;
              var fromColor = isPhoto ? [124, 103, 228] : [228, 171, 99];
              var toColor = isPhoto ? [228, 171, 99] : [124, 103, 228];

              var reveal = function () {
                root.classList.add('logo-arrived--settled');
                requestAnimationFrame(function () {
                  root.classList.add('logo-arrived--play');
                  document.dispatchEvent(new Event('sch-track-reveal'));
                  setTimeout(function () {
                    root.classList.remove('logo-arrived', 'logo-arrived--play', 'logo-arrived--settled');
                  }, 1000);
                });
              };

              var shrinkAndReveal = function () {
                if (!mark || !slot) {
                  reveal();
                  return;
                }
                var from = mark.getBoundingClientRect();
                var to = slot.getBoundingClientRect();
                if (!from.width || !to.width) {
                  reveal();
                  return;
                }
                var scale = to.width / from.width;
                var dx = to.left + to.width / 2 - (from.left + from.width / 2);
                var dy = to.top + to.height / 2 - (from.top + from.height / 2);
                mark.style.transformOrigin = 'center';
                mark.style.transition = 'transform 0.34s cubic-bezier(0.22, 1, 0.36, 1)';
                mark.style.transform = 'translate(' + dx + 'px,' + dy + 'px) scale(' + scale + ')';
                setTimeout(reveal, 340);
              };

              if (!dot || !arc) return reveal();
              var paintOrbit = function (progress) {
                var travel = progress * progress * (2 - progress);
                var angle = startAngle + (endAngle - startAngle) * travel;
                var x = 27 * Math.cos(angle);
                var y = 10.5 * Math.sin(angle);
                dot.setAttribute('cx', (32 + x * Math.cos(tilt) - y * Math.sin(tilt)).toFixed(2));
                dot.setAttribute('cy', (32 + x * Math.sin(tilt) + y * Math.cos(tilt)).toFixed(2));
                var color = fromColor.map(function (value, i) {
                  return Math.round(value + (toColor[i] - value) * travel);
                });
                dot.style.color = 'rgb(' + color.join(',') + ')';
                arc.setAttribute('stroke-dashoffset', ((1 - crossProgress) * (1 - progress) * 100).toFixed(2));
              };
              var start = performance.now();
              var tick = function (now) {
                var progress = Math.max(0, Math.min(1, (now - start) / 420));
                paintOrbit(progress);
                if (progress < 1) requestAnimationFrame(tick);
                else shrinkAndReveal();
              };
              requestAnimationFrame(tick);
            };
            if (document.readyState === 'loading') {
              document.addEventListener('readystatechange', playArrival, { once: true });
            } else {
              playArrival();
            }
          }
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) {
            meta.setAttribute(
              'content',
              root.dataset.world === 'dev' ? '#fffdf8' : root.dataset.world === 'photo' ? '#000000' : '#0f172a'
            );
          }
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
    {chrome && (
      <script is:inline>
        (() => {
          const root = document.documentElement;
          if (!('IntersectionObserver' in window)) return;

          const observer = new IntersectionObserver(
            (entries) => {
              for (const { target, isIntersecting } of entries) {
                if (!isIntersecting) continue;
                target.classList.add('is-in');
                observer.unobserve(target);
              }
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
          );

          // Set the starting state before the first paint, including on cold navigations.
          root.classList.add('reveal-enabled');
          document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
          }, { once: true });
        })();
      </script>
    )}
  </head>
  <body class:list={['page', `accent-${accent}`, { 'world-aware': preserveWorldNav }]}>
    {
      /* 抵达页的首帧直接接续来源页的轨道交点 */
      chrome && (
        <div
          class="world-warp arrive-warp is-on is-armed"
          data-world={section}
          data-target={section}
          data-cross-progress={crossProgress}
          data-cross-offset={crossOffset}
          aria-hidden="true"
        >
          <svg class="world-warp-mark" viewBox="0 0 64 64" focusable="false">
            <g transform="rotate(30 32 32)">
              <ellipse
                class="warp-orbit warp-orbit--photo"
                cx="32"
                cy="32"
                rx="27"
                ry="10.5"
                pathLength="100"
                stroke-dasharray={section === 'photo' ? '100' : undefined}
                stroke-dashoffset={section === 'photo' ? ((1 - crossProgress) * 100).toFixed(2) : undefined}
              />
            </g>
            <g transform="rotate(-30 32 32)">
              <ellipse
                class="warp-orbit warp-orbit--dev"
                cx="32"
                cy="32"
                rx="27"
                ry="10.5"
                pathLength="100"
                stroke-dasharray={section === 'dev' ? '100' : undefined}
                stroke-dashoffset={section === 'dev' ? ((1 - crossProgress) * 100).toFixed(2) : undefined}
              />
            </g>
            <circle class="warp-core" cx="32" cy="32" r="8" />
            <circle
              class="warp-dot"
              cx="32"
              cy={(32 + (section === 'dev' ? crossOffset : -crossOffset)).toFixed(2)}
              r="3.4"
              style={`color: ${section === 'dev' ? '#e4ab63' : '#7c67e4'}`}
            />
          </svg>
        </div>
      )
    }
    {
      chrome && (
        <header
          class:list={['site-head', { 'preserve-world-nav': preserveWorldNav }]}
          data-section={section}
        >
          <div class="head-inner">
            <a class="brand" href={localizePath('/', lang)} aria-label={siteName}>
              <span class="brand-slot brand-slot--mark">
                <svg
                  class="brand-mark"
                  viewBox="0 0 64 64"
                  width="26"
                  height="26"
                  aria-hidden="true"
                  focusable="false"
                >
                  <g class="mark-track mark-track--photo" transform="rotate(30 32 32)">
                    <ellipse class="mark-orbit" cx="32" cy="32" rx="27" ry="10.5" />
                    <g class="mark-dot-swing">
                      <circle class="mark-dot mark-dot--photo" cx="5" cy="32" r="3.4" />
                    </g>
                  </g>
                  <g class="mark-track mark-track--dev" transform="rotate(-30 32 32)">
                    <ellipse class="mark-orbit" cx="32" cy="32" rx="27" ry="10.5" />
                    <g class="mark-dot-swing">
                      <circle class="mark-dot mark-dot--dev" cx="59" cy="32" r="3.4" />
                    </g>
                  </g>
                  <circle class="mark-core" cx="32" cy="32" r="8" />
                </svg>
              </span>
              <span class="brand-slot brand-slot--word">
                <span class="brand-word" aria-hidden="true"><span class="brand-glyph" style="--i:0">S</span><span class="brand-glyph" style="--i:1"><span class="brand-cut">C</span></span><span class="brand-glyph" style="--i:2">H</span><span class="brand-glyph" style="--i:3"><span class="brand-cut">E</span></span><span class="brand-glyph" style="--i:4">D</span><span class="brand-glyph" style="--i:5">I</span><span class="brand-glyph" style="--i:6">N</span><span class="brand-glyph" style="--i:7">G</span><span class="brand-glyph" style="--i:8">E</span><span class="brand-glyph" style="--i:9">R</span></span>
              </span>
            </a>

            {navVariants.map(({ world, items }) => (
              <nav
                class:list={['site-nav', { 'world-nav': preserveWorldNav }]}
                data-world-nav={world}
                aria-label="Primary"
              >
                {items.map((item) => {
                  const href = localizePath(item.href, lang);
                  // 静态目录索引的 URL 带尾部斜杠（/dev/about/），而导航 href 不带（/dev/about），
                  // 归一化后再比较，保证当前页导航项能正确高亮
                  const active =
                    basePath.replace(/\/+$/, '') === item.href.replace(/\/+$/, '');
                  return (
                    <a href={href} class:list={['nav-link', { 'is-active': active }]}>
                      {t(`nav.${item.key}` as any)}
                    </a>
                  );
                })}
              </nav>
            ))}

            <div class="head-tools">
              {navVariants.map(({ world, crossTrack }) =>
                crossTrack ? (
                  <a
                    class:list={['track-switch', { 'world-track': preserveWorldNav }]}
                    data-world-track={world}
                    href={localizePath(crossTrack.href, lang)}
                  >
                    <span class="track-icon" aria-hidden="true">{crossTrack.icon}</span>
                    {crossTrack.label}
                  </a>
                ) : null
              )}
              <a class="lang-switch" href={switchHref} hreflang={otherLang} lang={otherLang}>
                {otherLang === 'zh' ? '中文' : 'EN'}
              </a>
            </div>
          </div>
        </header>
      )
    }

    <main>
      <slot />
    </main>

    {
      chrome && (
        <footer class:list={['site-foot', { reveal: section === 'dev' }]}>
          <div class="container-wide">
            <ContactFooter lang={lang} engineering={section === 'dev'} />
            <div class="foot-inner">
              <div class="foot-brand">
                <span class="brand-text">{siteName}</span>
                <span class="mono">{t('site.tagline')}</span>
              </div>
              <div class="foot-links">
                <a href={localizePath('/', lang)}>{t('footer.back')}</a>
                <a href={localizePath('/index', lang)}>{t('footer.index')}</a>
                <a href={localizePath('/credits', lang)}>{t('footer.credit')}</a>
              </div>
              <p class="foot-note mono">
                © {new Date().getFullYear()} {SITE.author[lang]} · {t('footer.rights')}
              </p>
            </div>
          </div>
        </footer>
      )
    }

    <script>
      // logo：顶部为文字，悬停或下拉后文字左滚卷起、图案横向展开
      const brandEl = document.querySelector('.brand');
      let brandHovered = false;
      const syncBrand = () => {
        if (!brandEl) return;
        brandEl.classList.toggle('is-marked', brandHovered || window.scrollY > 24);
      };
      if (brandEl) {
        brandEl.addEventListener('pointerenter', (event) => {
          if (event.pointerType !== 'mouse') return;
          brandHovered = true;
          syncBrand();
        });
        brandEl.addEventListener('pointerleave', () => {
          brandHovered = false;
          syncBrand();
        });
      }

      const head = document.querySelector('.site-head');
      if (head) {
        const onScroll = () => {
          head.classList.toggle('is-scrolled', window.scrollY > 24);
          syncBrand();
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        // 暴露真实导航高度（移动端为两行），供首屏图向上延伸使用
        const root = document.documentElement;
        const syncHeadH = () => root.style.setProperty('--head-h', `${head.offsetHeight}px`);
        syncHeadH();
        window.addEventListener('resize', syncHeadH, { passive: true });
        window.addEventListener('load', syncHeadH);
      }

      // 先走到交点再发起导航，让慢连接的等待也停在换轨位置。
      const arrivalWarp = document.querySelector<HTMLElement>('.arrive-warp');
      if (arrivalWarp) {
        const switchLinks = document.querySelectorAll<HTMLAnchorElement>('.track-switch');
        const crossProgress = Number(arrivalWarp.dataset.crossProgress);
        const crossOffset = Number(arrivalWarp.dataset.crossOffset);
        const warmed = new Set<string>();
        let switching = false;
        let warpEl: HTMLDivElement | null = null;

        const warmTarget = (href: string) => {
          if (warmed.has(href)) return;
          warmed.add(href);
          const prefetch = document.createElement('link');
          prefetch.rel = 'prefetch';
          prefetch.href = href;
          document.head.appendChild(prefetch);
        };

        const buildWarp = () => {
          if (warpEl) return warpEl;
          warpEl = document.createElement('div');
          warpEl.className = 'world-warp';
          warpEl.setAttribute('aria-hidden', 'true');
          warpEl.innerHTML = [
            '<svg class="world-warp-mark" viewBox="0 0 64 64" focusable="false">',
            '<g transform="rotate(30 32 32)"><ellipse class="warp-orbit warp-orbit--photo" cx="32" cy="32" rx="27" ry="10.5" pathLength="100" /></g>',
            '<g transform="rotate(-30 32 32)"><ellipse class="warp-orbit warp-orbit--dev" cx="32" cy="32" rx="27" ry="10.5" pathLength="100" /></g>',
            '<circle class="warp-core" cx="32" cy="32" r="8" />',
            '<circle class="warp-dot" cx="8.62" cy="18.5" r="3.4" />',
            '</svg>'
          ].join('');
          document.body.appendChild(warpEl);
          return warpEl;
        };

        const startSwitch = (event: MouseEvent, link: HTMLAnchorElement) => {
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey ||
            matchMedia('(prefers-reduced-motion: reduce)').matches ||
            (link.target && link.target !== '_self')
          ) {
            return;
          }

          const current = document.documentElement.dataset.world;
          if (current !== 'photo' && current !== 'dev') return;
          if (switching) {
            event.preventDefault();
            return;
          }

          const target = current === 'photo' ? 'dev' : 'photo';
          const pathname = new URL(link.href).pathname.replace(/\/$/, '');
          const isPhoto = target === 'photo';
          const tilt = isPhoto ? -Math.PI / 6 : Math.PI / 6;
          const startAngle = isPhoto ? 0 : -Math.PI;
          const crossY = isPhoto ? -crossOffset : crossOffset;
          const crossAngle = Math.atan2(crossY * Math.cos(tilt) / 10.5, crossY * Math.sin(tilt) / 27);
          const endAngle = isPhoto ? crossAngle : crossAngle - 2 * Math.PI;

          event.preventDefault();
          switching = true;
          document.documentElement.style.overflow = 'hidden';
          brandEl?.classList.add('is-marked');

          const warp = buildWarp();
          const dot = warp.querySelector<SVGCircleElement>('.warp-dot')!;
          const arc = warp.querySelector<SVGEllipseElement>(`.warp-orbit--${target}`)!;
          arc.setAttribute('stroke-dasharray', '100');
          warp.dataset.world = current;
          warp.dataset.target = target;
          dot.style.color = isPhoto ? '#7c67e4' : '#e4ab63';

          const paintApproach = (progress: number) => {
            const travel = progress * progress * (3 - 2 * progress);
            const angle = startAngle + (endAngle - startAngle) * travel;
            const x = 27 * Math.cos(angle);
            const y = 10.5 * Math.sin(angle);
            dot.setAttribute('cx', (32 + x * Math.cos(tilt) - y * Math.sin(tilt)).toFixed(2));
            dot.setAttribute('cy', (32 + x * Math.sin(tilt) + y * Math.cos(tilt)).toFixed(2));
            arc.setAttribute('stroke-dashoffset', ((1 - crossProgress * progress) * 100).toFixed(2));
          };

          paintApproach(0);
          void warp.offsetWidth;
          warp.classList.add('is-on', 'is-armed');
          const begin = performance.now();
          const approach = (now: number) => {
            const progress = Math.max(0, Math.min(1, (now - begin) / 480));
            paintApproach(progress);
            if (progress < 1) {
              requestAnimationFrame(approach);
              return;
            }
            warp.dataset.world = target;
            try {
              sessionStorage.setItem('sch-logo-arrived', pathname);
            } catch (e) {}
            window.location.assign(link.href);
          };
          requestAnimationFrame(approach);
        };

        switchLinks.forEach((link) => {
          link.addEventListener('click', (event) => startSwitch(event, link));
          link.addEventListener('pointerenter', () => warmTarget(link.href), { passive: true });
          link.addEventListener('focus', () => warmTarget(link.href));
        });
        // bfcache 返回时清理过渡层
        window.addEventListener('pageshow', (event) => {
          if (!event.persisted) return;
          switching = false;
          document.documentElement.style.overflow = '';
          syncBrand();
          if (warpEl) {
            warpEl.remove();
            warpEl = null;
          }
        });
      }
    </script>

    <style is:global>
      /* 导航容器：沿用参考页参数，无底部分隔线与阴影，仅靠背景与模糊过渡 */
      .site-head {
        position: sticky;
        top: 0;
        z-index: 60;
        height: var(--nav-h);
        display: flex;
        align-items: center;
        isolation: isolate;
        background: var(--glass-bg);
        -webkit-backdrop-filter: blur(20px);
        backdrop-filter: blur(20px);
        border-bottom: 0;
        box-shadow: none;
        transition: background 0.2s ease, backdrop-filter 0.2s ease;
      }

      .site-head.is-scrolled {
        background: var(--glass-bg-scrolled);
        -webkit-backdrop-filter: blur(20px);
        backdrop-filter: blur(20px);
      }

      /* 首屏：摄影 / 工程主线导航完全透明，下拉后恢复磨砂玻璃 */
      .site-head[data-section='photo']:not(.is-scrolled),
      .site-head[data-section='dev']:not(.is-scrolled),
      html[data-world='photo'] .site-head.preserve-world-nav:not(.is-scrolled),
      html[data-world='dev'] .site-head.preserve-world-nav:not(.is-scrolled) {
        background: transparent;
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
      }

      /* 导航按钮的磨砂玻璃底 */
      .site-head[data-section='photo'] {
        --chip-bg: rgba(255, 255, 255, 0.06);
        --chip-bg-hover: rgba(255, 255, 255, 0.13);
        --chip-highlight: rgba(255, 255, 255, 0.16);
      }

      .site-head[data-section='dev'] {
        --chip-bg: rgba(255, 255, 255, 0.55);
        --chip-bg-hover: #ffffff;
        --chip-highlight: rgba(255, 255, 255, 0.9);
      }

      /* 关于 / 联系：完全沿用当前主线的导航栏外观 */
      html[data-world='photo'] .site-head.preserve-world-nav {
        --chip-bg: rgba(255, 255, 255, 0.06);
        --chip-bg-hover: rgba(255, 255, 255, 0.13);
        --chip-highlight: rgba(255, 255, 255, 0.16);
      }

      html[data-world='dev'] .site-head.preserve-world-nav {
        --chip-bg: rgba(255, 255, 255, 0.55);
        --chip-bg-hover: #ffffff;
        --chip-highlight: rgba(255, 255, 255, 0.9);
      }

      .site-head[data-section='neutral'] {
        --chip-bg: rgba(255, 255, 255, 0.05);
        --chip-bg-hover: rgba(255, 255, 255, 0.1);
        --chip-highlight: rgba(255, 255, 255, 0.14);
      }

      @supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
        /* 不支持背景模糊时沿用主线玻璃的半透明值，避免整条导航变成实色块 */
        .site-head {
          background: var(--glass-bg-scrolled);
        }
      }

      .head-inner {
        position: relative;
        z-index: 1;
        width: min(1600px, 100% - var(--gutter) * 2);
        margin-inline: auto;
        display: flex;
        align-items: center;
        gap: 32px;
      }

      .brand {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0;
        flex-shrink: 0;
        min-width: 100px;
        color: var(--text);
      }

      /* 稳定的悬停命中区：文字收起为图案时宽度变化也不会丢失 hover，避免反复滚动 */
      .brand::after {
        content: '';
        position: absolute;
        inset: -10px -8px;
      }

      .brand-mark {
        width: 26px;
        height: 26px;
        display: block;
        flex-shrink: 0;
        overflow: visible;
      }

      /* logo：文字左滚卷起，图案从左侧横向展开 */
      .brand-slot {
        display: inline-flex;
        align-items: center;
        overflow: hidden;
      }

      .brand-slot--mark {
        width: 0;
        height: 26px;
        flex-shrink: 0;
        opacity: 0;
        transition: width 0.42s var(--ease), opacity 0.3s var(--ease);
      }

      .brand-slot--word {
        max-width: 120px;
        transition: max-width 0.34s var(--ease) 0.16s;
      }

      .brand-mark {
        transform: scale(0.4) rotate(-70deg);
        transition: transform 0.5s var(--ease);
      }

      .brand-glyph {
        display: inline-block;
        transition: transform 0.34s var(--ease), opacity 0.26s var(--ease);
        transition-delay: calc(var(--i, 0) * 20ms);
      }

      .brand.is-marked .brand-slot--mark {
        width: 26px;
        opacity: 1;
      }

      .brand.is-marked .brand-slot--word {
        max-width: 0;
      }

      .brand.is-marked .brand-mark {
        transform: none;
      }

      .brand.is-marked .brand-glyph {
        transform: translateX(-16px) scaleX(0.7) scaleY(0.5);
        opacity: 0;
      }

      /* 主线切换抵达后：先停在图案态，等到首屏绘制后再展开回文字（只播放一次） */
      html.logo-arrived:not(.logo-arrived--play) .brand-slot--mark {
        width: 26px;
        opacity: 0;
        transition: none;
      }

      /* 全屏 logo 收缩到顶部后就位，瞬间换成顶部 logo，避免双影 */
      html.logo-arrived--settled:not(.logo-arrived--play) .brand-slot--mark {
        width: 26px;
        opacity: 1;
        transition: none;
      }

      html.logo-arrived:not(.logo-arrived--play) .brand-slot--word {
        max-width: 0;
      }

      html.logo-arrived:not(.logo-arrived--play) .brand-mark {
        transform: none;
      }

      html.logo-arrived:not(.logo-arrived--play) .brand-glyph {
        transform: translateX(-16px) scaleX(0.7) scaleY(0.5);
        opacity: 0;
      }

      html.logo-arrived:not([data-world='photo']):not(.logo-arrived--play) main {
        opacity: 0;
      }

      html.logo-arrived--play .brand-slot--mark {
        animation: logo-mark-collapse 0.42s var(--ease) backwards;
      }

      html.logo-arrived--play .brand-slot--word {
        animation: logo-word-unfold 0.34s var(--ease) 0.16s backwards;
      }

      html.logo-arrived--play .brand-mark {
        animation: logo-mark-unfold 0.5s var(--ease) backwards;
      }

      html.logo-arrived--play .brand-glyph {
        animation: logo-glyph-unfold 0.34s var(--ease) backwards;
        animation-delay: calc(180ms + var(--i, 0) * 22ms);
      }

      html.logo-arrived--play main {
        animation: page-arrive 0.5s var(--ease) 0.1s backwards;
      }

      @keyframes logo-mark-collapse {
        from {
          width: 26px;
          opacity: 1;
        }
        to {
          width: 0;
          opacity: 0;
        }
      }

      @keyframes logo-word-unfold {
        from {
          max-width: 0;
        }
        to {
          max-width: 120px;
        }
      }

      @keyframes logo-mark-unfold {
        from {
          transform: none;
        }
        to {
          transform: scale(0.4) rotate(-70deg);
        }
      }

      @keyframes logo-glyph-unfold {
        from {
          transform: translateX(-16px) scaleX(0.7) scaleY(0.5);
          opacity: 0;
        }
        to {
          transform: none;
          opacity: 1;
        }
      }

      @keyframes page-arrive {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      .mark-orbit {
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-width: 2.4;
        opacity: 0.3;
        transition: opacity 0.45s var(--ease), stroke-width 0.45s var(--ease);
      }

      .mark-core {
        fill: currentColor;
      }

      .mark-dot {
        opacity: 0;
        transition: opacity 0.45s var(--ease);
      }

      .mark-dot--photo {
        fill: #e4ab63;
      }

      .mark-dot--dev {
        fill: #7c67e4;
      }

      /* 摄影高亮左轨道，工程保留原轨道；门户页取两条高亮轨道的叠加 */
      html[data-world='photo'] .mark-track--photo .mark-orbit,
      html[data-world='dev'] .mark-track--dev .mark-orbit,
      html[data-world='neutral'] .mark-track .mark-orbit {
        opacity: 0.86;
        stroke-width: 3;
      }

      html[data-world='photo'] .mark-track--photo .mark-dot,
      html[data-world='dev'] .mark-track--dev .mark-dot,
      html[data-world='neutral'] .mark-track .mark-dot {
        opacity: 1;
      }

      .mark-dot-swing {
        transform-box: view-box;
        transform-origin: 32px 32px;
        animation: brand-dot-settle 1.5s var(--ease) both;
      }

      .mark-track--photo .mark-dot-swing {
        --logo-enter: -26deg;
      }

      .mark-track--dev .mark-dot-swing {
        --logo-enter: 26deg;
      }

      @keyframes brand-dot-settle {
        from {
          transform: rotate(var(--logo-enter));
          opacity: 0.2;
        }
        to {
          transform: rotate(0deg);
          opacity: 1;
        }
      }

      .brand-word {
        font-family: var(--font-heading);
        font-size: 12.5px;
        font-weight: 600;
        letter-spacing: 0.16em;
        line-height: 1;
        white-space: nowrap;
      }

      /* 与主轨道同角度的开口：只切 C 与 E，不破坏字标整体识别 */
      .brand-cut {
        display: inline-block;
        -webkit-mask-image: linear-gradient(60deg, #000 0 45%, transparent 45.1% 55%, #000 55.1%);
        mask-image: linear-gradient(60deg, #000 0 45%, transparent 45.1% 55%, #000 55.1%);
      }

      html.logo-arrived .mark-dot-swing {
        animation: none;
      }

      /* ---------- 全屏轨道过渡 ---------- */
      .world-warp {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: grid;
        place-items: center;
        background-color: #000000;
        color: #f6f4f0;
        opacity: 0;
        pointer-events: none;
        will-change: opacity;
        transition: opacity 0.26s var(--ease), color 0.9s cubic-bezier(0.45, 0, 0.25, 1);
      }

      /* 过渡层底色直接用目标页面的背景色，避免切换时出现色差 */
      .world-warp[data-target='dev'] {
        background-color: #fbf7ef;
      }

      .world-warp.is-on {
        opacity: 1;
        pointer-events: auto;
      }

      .world-warp[data-world='photo'] {
        color: #f6f4f0;
      }

      .world-warp[data-world='dev'] {
        color: #1d1a2b;
      }

      .world-warp-mark {
        position: relative;
        z-index: 1;
        width: min(46vmin, 420px);
        height: auto;
        overflow: visible;
        opacity: 0;
        transform: scale(0.94);
        transition: opacity 0.5s var(--ease), transform 0.95s var(--ease);
      }

      .world-warp.is-armed .world-warp-mark {
        opacity: 1;
        transform: scale(1);
      }

      .warp-orbit {
        fill: none;
        stroke: currentColor;
        stroke-width: 2.4;
        stroke-linecap: round;
        opacity: 0.24;
        transition: opacity 0.75s cubic-bezier(0.45, 0, 0.25, 1);
      }

      .world-warp[data-world='photo'] .warp-orbit--photo,
      .world-warp[data-world='dev'] .warp-orbit--dev {
        opacity: 0.75;
      }

      .warp-core {
        fill: currentColor;
        opacity: 0.9;
      }

      .warp-dot {
        fill: currentColor;
        filter: drop-shadow(0 0 1.2vmin currentColor);
      }

      /* 抵达页的过渡层与来源页共用 .world-warp 样式：仅切换抵达时显示，logo 就位后隐藏 */
      .arrive-warp {
        display: none;
      }

      html.logo-arrived .arrive-warp {
        display: grid;
      }

      html.logo-arrived--settled .arrive-warp {
        display: none;
      }

      .brand-text {
        font-family: var(--font-heading);
        font-size: 14px;
        letter-spacing: 0.04em;
        font-weight: 600;
      }

      .site-nav {
        display: flex;
        gap: 8px;
        margin-left: auto;
      }

      /* 导航按钮：磨砂玻璃胶囊，无描边、无强调线 */
      .nav-link {
        font-size: 13px;
        color: var(--text-dim);
        padding: 6px 13px;
        border: 0;
        border-radius: 999px;
        background: var(--chip-bg, transparent);
        /* 胶囊不叠 backdrop-filter：Firefox 会采样并饱和放大背后的首屏照片，造成跨浏览器色差 */
        box-shadow: inset 0 1px 0 var(--chip-highlight, transparent);
        transition: color 0.3s var(--ease), background 0.3s var(--ease),
          box-shadow 0.3s var(--ease);
      }

      .nav-link:hover,
      .nav-link.is-active {
        color: var(--text);
        background: var(--chip-bg-hover, transparent);
        box-shadow: inset 0 1px 0 var(--chip-highlight, transparent),
          0 6px 16px -12px rgba(0, 0, 0, 0.55);
      }

      .head-tools {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-left: auto;
        flex-shrink: 0;
      }

      .site-nav + .head-tools {
        margin-left: 0;
      }

      .track-switch {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 12.5px;
        color: var(--text-dim);
        padding: 6px 12px;
        border: 0;
        border-radius: 999px;
        background: var(--chip-bg, transparent);
        box-shadow: inset 0 1px 0 var(--chip-highlight, transparent);
        transition: color 0.3s var(--ease), background 0.3s var(--ease);
      }

      .track-switch:hover {
        color: var(--text);
        background: var(--chip-bg-hover, var(--accent-soft, rgba(59, 130, 246, 0.12)));
      }

      .track-icon {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--accent, var(--warm));
      }

      .site-nav.world-nav,
      .track-switch.world-track {
        display: none;
      }

      html[data-world='photo'] .site-nav.world-nav[data-world-nav='photo'],
      html[data-world='dev'] .site-nav.world-nav[data-world-nav='dev'],
      html[data-world='neutral'] .site-nav.world-nav[data-world-nav='neutral'] {
        display: flex;
      }

      html[data-world='photo'] .track-switch.world-track[data-world-track='photo'],
      html[data-world='dev'] .track-switch.world-track[data-world-track='dev'] {
        display: inline-flex;
      }

      html[data-world='dev'] .site-head.preserve-world-nav {
        --accent: var(--cool);
        --accent-soft: var(--cool-soft);
      }

      /* 关于 / 联系：内容强调色跟随工程主线 */
      html[data-world='dev'] body.world-aware {
        --accent: var(--cool);
        --accent-soft: var(--cool-soft);
      }

      .lang-switch {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        color: var(--text-faint);
        padding: 5px 9px;
        border-radius: 999px;
        background: var(--chip-bg, transparent);
        transition: color 0.3s var(--ease), background 0.3s var(--ease);
      }

      .lang-switch:hover {
        color: var(--text);
        background: var(--chip-bg-hover, transparent);
      }

      .site-foot {
        border-top: 1px solid var(--line);
        padding-block: 44px 52px;
        margin-top: 40px;
      }

      .foot-inner {
        display: grid;
        gap: 22px;
      }

      .foot-brand {
        display: flex;
        align-items: baseline;
        gap: 14px;
        flex-wrap: wrap;
      }

      .foot-links {
        display: flex;
        flex-wrap: wrap;
        gap: 26px;
        font-size: 13px;
        color: var(--text-dim);
      }

      .foot-links a {
        transition: color 0.3s var(--ease);
      }

      .foot-links a:hover {
        color: var(--text);
      }

      .foot-note {
        color: var(--text-faint);
      }

      .accent-warm {
        --accent: var(--warm);
        --accent-soft: var(--warm-soft);
      }

      .accent-cool {
        --accent: var(--cool);
        --accent-soft: var(--cool-soft);
      }

      @media (max-width: 880px) {
        .site-head {
          height: auto;
        }
        /* 两行栅格：第一行品牌 + 语言，第二行主线切换（左紧邻）+ 导航（右紧邻） */
        .head-inner {
          display: grid;
          /* 品牌横跨前两列，首列只由主线切换按钮决定宽度，把剩余空间全部让给导航，避免导航折行 */
          grid-template-columns: max-content minmax(0, 1fr) auto;
          grid-template-areas:
            'brand brand lang'
            'track nav nav';
          align-items: center;
          column-gap: clamp(8px, 2.4vw, 10px);
          row-gap: 8px;
          padding-block: 12px 8px;
        }
        .brand {
          grid-area: brand;
          justify-self: start;
        }
        /* 拆掉工具区外壳，让语言切换与主线切换各自落到对应栅格 */
        .head-tools {
          display: contents;
        }
        .lang-switch {
          grid-area: lang;
          justify-self: end;
        }
        /* 导航不再横向滑动：常规宽度保持原按钮尺寸，只有屏幕确实放不下时才略微收缩 */
        .site-nav {
          display: flex;
          flex-wrap: wrap;
          justify-content: flex-end;
          grid-area: nav;
          width: 100%;
          min-width: 0;
          margin-left: 0;
          gap: clamp(2px, 1vw, 4px);
        }
        .nav-link {
          white-space: nowrap;
          font-size: clamp(11px, 3.2vw, 12.5px);
          padding: clamp(5px, 1.5vw, 6px) clamp(6px, 2.8vw, 11px);
        }
        .track-switch {
          grid-area: track;
          justify-self: start;
          white-space: nowrap;
          font-size: clamp(11px, 3.4vw, 12.5px);
          padding: clamp(5px, 1.55vw, 6px) clamp(7px, 3.1vw, 12px);
        }
        .track-icon {
          font-size: clamp(9px, 2.7vw, 10px);
        }
      }

      /* 超窄屏（≤350px）才进一步收缩按钮，避免「关于」被挤到第三行 */
      @media (max-width: 350px) {
        .head-inner {
          column-gap: 6px;
        }
        .nav-link {
          font-size: 11px;
          padding: 4px 8px;
        }
        .track-switch {
          font-size: 10.5px;
          padding: 4px 8px;
        }
        .track-icon {
          font-size: 9px;
        }
      }
    </style>
  </body>
</html>
