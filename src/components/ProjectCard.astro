---
import type { Project } from '../data/projects';
import type { Lang } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';

interface Props {
  project: Project;
  lang: Lang;
  index: number;
}

const { project, lang, index } = Astro.props;
const t = useTranslations(lang);
const href = localizePath(`/projects/${project.slug}`, lang);
const monogram = project.name[lang].slice(0, 1);
---

<a class="project-card reveal" href={href} style={`--tint:${project.color}`}>
  <span class="frame">
    <span class="bar" aria-hidden="true">
      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
      <span class="url mono">{project.slug}</span>
    </span>
    <span class="screen">
      <span class="mark" aria-hidden="true">{monogram}</span>
      <span class="mock" aria-hidden="true">
        <span class="mock-line l1"></span>
        <span class="mock-line l2"></span>
      </span>
      {project.status === 'draft' && <span class="badge mono">{t('projects.draft')}</span>}
    </span>
  </span>

  <span class="info">
    <span class="line">
      <span class="index mono numeric">{String(index + 1).padStart(2, '0')}</span>
      <span class="name">{project.name[lang]}</span>
      <span class="year mono numeric">{project.year}</span>
    </span>
    <span class="tagline">{project.tagline[lang]}</span>
    <span class="stack">
      {project.stack.map((s) => <span class="tag mono">{s}</span>)}
    </span>
  </span>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    -webkit-tap-highlight-color: transparent;
  }

  .project-card:focus,
  .project-card:focus-visible,
  .project-card:active {
    outline: none;
  }

  .frame {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #ffffff;
    box-shadow: var(--card-shadow);
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }

  .project-card:hover .frame {
    transform: translateY(-6px);
    box-shadow: 0 2px 4px rgba(29, 26, 43, 0.05), 0 32px 60px -32px rgba(29, 26, 43, 0.5);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--line);
    background: #faf6ee;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #d9d2c6;
  }

  .dot:nth-child(1) {
    background: #ffa8b8;
  }

  .dot:nth-child(2) {
    background: #ffd98a;
  }

  .dot:nth-child(3) {
    background: #9fe3cb;
  }

  .url {
    margin-left: 10px;
    font-size: 10px;
    color: var(--text-faint);
    letter-spacing: 0.06em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .screen {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    aspect-ratio: 16 / 10;
    background:
      radial-gradient(80% 90% at 30% 0%, rgba(255, 255, 255, 0.92), transparent 62%),
      linear-gradient(160deg, color-mix(in srgb, var(--tint) 22%, #ffffff) 0%, #fffdf8 84%);
    overflow: hidden;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border: 1px solid rgba(29, 26, 43, 0.1);
    border-radius: 18px;
    background: #ffffff;
    box-shadow: 0 8px 20px -12px rgba(29, 26, 43, 0.4);
    font-size: 22px;
    font-weight: 500;
    color: var(--text-dim);
    transition: border-color 0.4s var(--ease), color 0.4s var(--ease),
      transform 0.6s var(--ease);
  }

  .project-card:hover .mark {
    border-color: var(--line-strong);
    color: var(--text);
    transform: translateY(-3px) rotate(-3deg);
  }

  .mock {
    display: grid;
    gap: 7px;
    width: 116px;
  }

  .mock-line {
    height: 4px;
    border-radius: 999px;
    background: rgba(29, 26, 43, 0.12);
  }

  .mock-line.l1 {
    width: 100%;
  }

  .mock-line.l2 {
    width: 64%;
  }

  .badge {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 9.5px;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    padding: 4px 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 253, 248, 0.78);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .line {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .index {
    font-size: 10.5px;
    color: var(--text-faint);
  }

  .name {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 900;
    letter-spacing: 0.01em;
  }

  .year {
    margin-left: auto;
    font-size: 10.5px;
    color: var(--text-faint);
  }

  .tagline {
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--text-dim);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 2px;
  }

  .tag {
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    background: #ffffff;
    border: 1px solid var(--line);
    padding: 4px 10px;
    border-radius: 999px;
  }
</style>
