---
import type { Work } from '../data/works';
import type { Lang } from '../i18n/ui';
import { localizePath, withBase } from '../i18n/utils';
interface Props { scope: string; lang: Lang; photos: { work: Work; path?: string; title?: string }[] }
const { scope, photos, lang } = Astro.props;
const zh = lang === 'zh';
---
<photo-arranger data-scope={scope} data-lang={lang}>
  <div class="tools" hidden>
    <button type="button" data-toggle aria-pressed="false" class="chip">{zh ? '调整排版' : 'Arrange photos'}</button>
    <button type="button" data-export class="chip" hidden>{zh ? '导出草稿' : 'Export draft'}</button>
    <button type="button" data-reset class="chip" hidden>{zh ? '恢复默认' : 'Reset layout'}</button>
    <span data-status role="status"></span>
  </div>
  <p class="hint" hidden>{zh ? '拖照片移动，拉右下角等比缩放。键盘可用方向键移动，＋ / − 缩放。' : 'Drag a photo to move it or pull its lower-right corner to resize. Use arrow keys to move and + / − to resize.'}</p>
  <div class="board" hidden>
    {photos.map(({work, path, title}) => <div class="piece" data-id={work.slug} data-series={work.series} data-ratio={work.width / work.height}>
      <a href={localizePath(path ?? `/works/${work.slug}`, lang)} draggable="false">
        <span class="picture"><img data-src={withBase(work.thumb)} alt="" width={work.width} height={work.height} draggable="false" />
          <span class="grip" aria-hidden="true">↘</span>
        </span>
        <span class="caption">{title ?? work.title[lang]}</span>
      </a>
    </div>)}
  </div>
</photo-arranger>
<script>
  import '../scripts/photo-arranger';
</script>
<style>
  photo-arranger { display: block; }
  [hidden] { display: none !important; }
  .tools { display: flex; gap: 8px 12px; flex-wrap: wrap; align-items: center; margin-block: 20px; }
  .hint, [data-status] { font-size: 13px; color: var(--text-dim); }
  .hint { margin-block: 0 16px; }
  .board { position: relative; isolation: isolate; --photo-gap: 32px; }
  [data-works-baseline] .caption {
    padding-top: 4px;
    line-height: 18px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 640px) {
    .board { --photo-gap: 24px; }
  }
  [data-editing] .board { outline: 1px dashed var(--line); background: radial-gradient(circle, var(--line) 1px, transparent 1px) 0 0 / 20px 20px; }
  .piece { position: absolute; }
  .piece a, .picture, img, .caption { display: block; }
  .picture { position: relative; }
  img { width: 100%; height: auto; }
  .caption { padding-top: 8px; font-size: 14px; }
  .grip { display: none; }
  [data-editing] .piece { cursor: grab; touch-action: none; user-select: none; }
  [data-editing] .piece a { cursor: inherit; }
  [data-editing] .piece:active { cursor: grabbing; }
  [data-editing] .piece:is(:hover,:focus-within) { outline: 1px solid var(--warm); z-index: 1; }
  [data-editing] .grip { position: absolute; display: grid; place-items: center; right: 0; bottom: 0; width: 32px; height: 32px; color: white; background: #15151cdd; cursor: nwse-resize; }
  :global(main:has(photo-arranger[data-active]) [data-arranger-original]) { display: none; }
</style>
