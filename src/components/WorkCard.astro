---
import '../styles/work-card-interactions.css';
import DeferredPreview from './DeferredPreview.astro';
import type { Work } from '../data/works';
import type { Lang } from '../i18n/ui';
import { localizePath, withBase } from '../i18n/utils';

interface Props {
  work: Work;
  lang: Lang;
  eager?: boolean;
  deferPreview?: boolean;
  reveal?: boolean;
}

const { work, lang, eager = false, deferPreview = false, reveal = true } = Astro.props;
const href = localizePath(`/works/${work.slug}`, lang);
const year = work.date.slice(0, 4);
---

<a class:list={['work-card', 'work-card-interaction', { reveal }]} href={href} style={`--tint:${work.color}`}>
  <span class="media" style={`aspect-ratio:${work.width} / ${work.height}`}>
    <DeferredPreview deferred={deferPreview}>
      <img
        src={withBase(work.thumb)}
        alt={work.title[lang]}
        width={work.width}
        height={work.height}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    </DeferredPreview>
  </span>
  <span class="meta">
    <span class="name">
      {work.title[lang]}
      <span class="arrow" aria-hidden="true">↗</span>
    </span>
    <span class="sub mono">{work.location[lang]}</span>
    <span class="sub mono dim">{year}</span>
  </span>
</a>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: transparent;
  }

  .media { background: var(--tint); }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .meta {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  .name {
    font-size: 15px;
    letter-spacing: 0.01em;
    color: var(--text);
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  .sub {
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.04em;
  }

  .sub.dim {
    margin-left: auto;
    opacity: 0.75;
  }

  @media (max-width: 640px) {
    .sub.dim {
      margin-left: 0;
    }
  }
</style>
