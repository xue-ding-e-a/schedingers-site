---
import '../styles/work-card-interactions.css';
import type { Work } from '../data/works';
import type { Lang } from '../i18n/ui';
import { localizePath, withBase } from '../i18n/utils';

interface Props {
  work: Work;
  lang: Lang;
  eager?: boolean;
  reveal?: boolean;
  titleOnly?: boolean;
  vars?: string;
}

const { work, lang, eager = false, reveal = true, titleOnly = false, vars } = Astro.props;
const href = localizePath(`/works/${work.slug}`, lang);
const year = work.date.slice(0, 4);
---

<a
  class:list={['work-card', 'work-card-interaction', { reveal, 'title-only': titleOnly }]}
  href={href}
  style={`--tint:${work.color}${vars ? `;${vars}` : ''}`}
>
  <span class="media" style={`aspect-ratio:${work.width} / ${work.height}`}>
    <img
      src={withBase(work.thumb)}
      alt={work.title[lang]}
      width={work.width}
      height={work.height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </span>
  <span class="meta">
    <span class="name">
      {work.title[lang]}
      {!titleOnly && <span class="arrow" aria-hidden="true">↗</span>}
    </span>
    {!titleOnly && <>
      <span class="sub mono">{work.location[lang]}</span>
      <span class="sub mono dim">{year}</span>
    </>}
  </span>
</a>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: transparent;
  }

  .title-only {
    min-width: 0;
    gap: var(--caption-gap, 4px);
  }

  .title-only .meta { display: block; }

  .title-only .name {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 14px;
    line-height: var(--caption-line-height, 18px);
    letter-spacing: normal;
  }

  .media { background: var(--tint); }
  .title-only .media img { object-fit: contain; }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .meta {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  .name {
    font-size: 15px;
    letter-spacing: 0.01em;
    color: var(--text);
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  .sub {
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.04em;
  }

  .sub.dim {
    margin-left: auto;
    opacity: 0.75;
  }

  @media (max-width: 640px) {
    .sub.dim {
      margin-left: 0;
    }
  }
</style>
