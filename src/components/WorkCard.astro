---
import '../styles/work-card-interactions.css';
import DeferredPreview from './DeferredPreview.astro';
import type { Work } from '../data/works';
import type { Lang } from '../i18n/ui';
import { previewImage } from '../data/work-images';
import { localizePath } from '../i18n/utils';

interface Props {
  work: Work;
  lang: Lang;
  eager?: boolean;
  deferPreview?: boolean;
  reveal?: boolean;
  titleOnly?: boolean;
  sizes?: string;
}

const { work, lang, eager = false, deferPreview = false, reveal = true, titleOnly = false, sizes = '(max-width: 760px) 68vw, 780px' } = Astro.props;
const href = localizePath(`/works/${work.slug}`, lang);
const year = work.date.slice(0, 4);
---

<a class:list={['work-card', 'work-card-interaction', { reveal, 'title-only': titleOnly }]} href={href} style={`--tint:${work.color}`}>
  <span class="media" style={`aspect-ratio:${work.width} / ${work.height}`}>
    <DeferredPreview deferred={deferPreview}>
      <img
        {...previewImage(work)}
        sizes={eager ? sizes : `auto, ${sizes}`}
        alt={work.title[lang]}
        width={work.width}
        height={work.height}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    </DeferredPreview>
  </span>
  <span class="meta">
    <span class="name">
      {work.title[lang]}
      {!titleOnly && <span class="arrow" aria-hidden="true">↗</span>}
    </span>
    {!titleOnly && <>
      <span class="sub mono">{work.location[lang]}</span>
      <span class="sub mono dim">{year}</span>
    </>}
  </span>
</a>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: transparent;
  }

  .title-only {
    min-width: 0;
    gap: var(--caption-gap, 4px);
  }

  .title-only .meta { display: block; }

  .title-only .name {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 14px;
    line-height: var(--caption-line-height, 18px);
    letter-spacing: normal;
  }

  .media { background: var(--tint); }
  .title-only .media img { object-fit: contain; }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .meta {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  .name {
    font-size: 15px;
    letter-spacing: 0.01em;
    color: var(--text);
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  .sub {
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.04em;
  }

  .sub.dim {
    margin-left: auto;
    opacity: 0.75;
  }

  @media (max-width: 640px) {
    .sub.dim {
      margin-left: 0;
    }
  }
</style>
