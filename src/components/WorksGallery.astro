---
import WorkCard from './WorkCard.astro';
import { getWork, type Work } from '../data/works';
import type { Lang } from '../i18n/ui';

const { lang, worksByDate } = Astro.props as { lang: Lang; worksByDate: Work[] };
const equalHeightRows = [
  { left: getWork('under-the-milky-way')!, right: getWork('galactic-arch-snow-mountain')! },
  { left: getWork('plank-road-star-bridge')!, right: getWork('prairie-starry-night')!, leftShare: 0.4260954439096759 },
  { left: getWork('star-trails-river')!, right: getWork('stars-fall-on-village')! },
];
const upperLeft = getWork('twin-arches-jade')!;
const upperRight = getWork('meteor-over-ridge')!;
const lowerLeft = getWork('winter-milky-way')!;
const lowerRight = getWork('eaves-of-time')!;
const ratio = (work: Work) => work.width / work.height;
const upperLeftShare = 68;
const upperRightShare = 30;
const displayWidths: Record<string, string> = {
  [upperLeft.slug]: `${upperLeftShare}cqw`,
  [upperRight.slug]: `${upperRightShare}cqw`,
  [lowerLeft.slug]: 'var(--lower-left-width)',
  [lowerRight.slug]: 'calc(100cqw - var(--photo-gap) - var(--lower-left-width))',
};

for (const { left, right, leftShare } of equalHeightRows) {
  const leftRatio = ratio(left);
  const rightRatio = ratio(right);
  if (leftShare === undefined) {
    const usableWidth = '100cqw - var(--photo-gap)';
    displayWidths[left.slug] = `calc((${usableWidth}) * ${leftRatio / (leftRatio + rightRatio)})`;
    displayWidths[right.slug] = `calc(${usableWidth} - ${displayWidths[left.slug]})`;
  } else {
    displayWidths[left.slug] = `${100 * leftShare}cqw`;
    displayWidths[right.slug] = `calc(${displayWidths[left.slug]} * ${rightRatio / leftRatio})`;
  }
}

const pairColumns = (left: Work, right: Work) => `${displayWidths[left.slug]} ${displayWidths[right.slug]}`;

// 移动端排版：横幅作品逐行单列居中，统一按「银河落入雪山」铺满页面后的高度呈现；
// 两张竖图并排于「星落古寨」之后，两图宽度加间距正好铺满页面。
const mobileAnchor = getWork('galactic-arch-snow-mountain')!;
const mobileBaseRatio = mobileAnchor.height / mobileAnchor.width;
const mobileOrder = [
  'galactic-arch-snow-mountain',
  'star-trails-river',
  'stars-fall-on-village',
  'under-the-milky-way',
  'meteor-over-ridge',
  'twin-arches-jade',
  'winter-milky-way',
  'eaves-of-time',
  'plank-road-star-bridge',
  'prairie-starry-night',
];
// 单幅作品相对基准高度的放大倍数
const mobileScale: Record<string, number> = {
  'stars-fall-on-village': 1.25,
};
const mobileVars = (work: Work) => {
  const portrait = work.height > work.width;
  const scale = mobileScale[work.slug] ?? 1;
  const width = portrait ? '100%' : `${(mobileBaseRatio * ratio(work) * scale * 100).toFixed(4)}cqw`;
  const span = portrait ? 'auto' : '1 / -1';
  return `--mobile-order:${mobileOrder.indexOf(work.slug) + 1};--mobile-w:${width};--mobile-span:${span}`;
};
---

<div class="works-layout" style={{
  '--upper-left-height': `calc(${displayWidths[upperLeft.slug]} / ${ratio(upperLeft)})`,
  '--upper-right-height': `calc(${displayWidths[upperRight.slug]} / ${ratio(upperRight)})`,
  '--lower-left-ratio': ratio(lowerLeft),
  '--lower-right-ratio': ratio(lowerRight),
}}>
  <div class="curated-works" id="curated-works">
    {equalHeightRows.map(({ left, right }, index) => (
      <div class="pair reveal" style={{ '--columns': pairColumns(left, right) }}>
        <WorkCard work={left} {lang} titleOnly reveal={false} eager={index === 0} vars={mobileVars(left)} />
        <WorkCard work={right} {lang} titleOnly reveal={false} eager={index === 0} vars={mobileVars(right)} />
      </div>
    ))}
    <div class="staggered">
      <div class="pair upper-pair reveal" style={{ '--columns': pairColumns(upperLeft, upperRight) }}>
        <WorkCard work={upperLeft} {lang} titleOnly reveal={false} vars={mobileVars(upperLeft)} />
        <WorkCard work={upperRight} {lang} titleOnly reveal={false} vars={mobileVars(upperRight)} />
      </div>
      <div class="pair lower-pair reveal" style={{ '--columns': pairColumns(lowerLeft, lowerRight) }}>
        <WorkCard work={lowerLeft} {lang} titleOnly reveal={false} vars={mobileVars(lowerLeft)} />
        <WorkCard work={lowerRight} {lang} titleOnly reveal={false} vars={mobileVars(lowerRight)} />
      </div>
    </div>
  </div>
  <div class="filtered-works" id="works-grid" hidden>
    {worksByDate.map(work => (
      <div
        class="work-item"
        data-series={work.series}
        data-date={work.date}
        style={{ '--work-width': displayWidths[work.slug] }}
        hidden
      >
        <WorkCard {work} {lang} />
      </div>
    ))}
  </div>
</div>

<style>
  .works-layout {
    --photo-gap: 32px;
    --caption-gap: 4px;
    --caption-line-height: 16px;
    --caption-height: calc(var(--caption-gap) + var(--caption-line-height));
    --left-top: calc(var(--upper-left-height) + var(--caption-height) + var(--photo-gap));
    --right-top: calc(var(--upper-right-height) + var(--caption-height) + var(--photo-gap));
    /* Solve the final pair's widths so different top edges share one bottom edge. */
    --lower-left-height: calc((100cqw - var(--photo-gap) + var(--lower-right-ratio) * (var(--right-top) - var(--left-top))) / (var(--lower-left-ratio) + var(--lower-right-ratio)));
    --lower-left-width: calc(var(--lower-left-height) * var(--lower-left-ratio));
    container-type: inline-size;
  }

  .curated-works {
    display: grid;
    gap: var(--photo-gap);
  }

  .pair {
    display: grid;
    grid-template-columns: var(--columns);
    align-items: start;
    gap: var(--photo-gap);
  }

  .staggered { display: grid; }
  .staggered .pair { grid-area: 1 / 1; }

  .upper-pair {
    justify-content: space-between;
    gap: 0;
  }

  .lower-pair { pointer-events: none; }
  .lower-pair > :global(a) { pointer-events: auto; }
  .lower-pair > :global(a:first-child) { margin-top: var(--left-top); }
  .lower-pair > :global(a:last-child) { margin-top: var(--right-top); }

  .filtered-works {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--photo-gap);
  }

  .work-item {
    flex: 0 0 auto;
    min-width: 0;
    width: var(--work-width, 100%);
  }

  [hidden] { display: none; }

  @media (max-width: 640px) {
    .works-layout { --photo-gap: 24px; }

    /* 移动端：横幅作品一行一张、按「银河落入雪山」的高度居中；两张竖图并排铺满页面 */
    .curated-works {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-items: center;
      gap: var(--photo-gap);
    }

    /* 分组容器设为 display: contents 后，卡片在布局上成为网格项，但 DOM 层级不变 */
    .curated-works :global(a) {
      order: var(--mobile-order, 0);
      grid-column: var(--mobile-span, 1 / -1);
      width: var(--mobile-w, 100%);
    }

    .pair,
    .staggered,
    .upper-pair,
    .lower-pair { display: contents; }

    .lower-pair > :global(a:first-child),
    .lower-pair > :global(a:last-child) { margin-top: 0; }
  }
</style>
