---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { works } from '../data/works';
import { useTranslations, localizePath, withBase } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

const { lang = 'zh' } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
const portrait = works.find((w) => w.slug === 'stars-fall-on-village')!;

const gear = [
  { kind: '机身', items: ['Sony A7C', 'Sony A7R III'] },
  { kind: '镜头', items: ['Brightin Star 12mm f/2.8', 'Viltrox 16mm f/1.8', 'Sigma 28-70mm f/2.8'] },
  { kind: '后期', items: ['PTGui（拼接）', 'Photoshop（堆栈与调色）'] },
];

// 星联 CSVA 普鲁斯特问卷：问题 + 可收起回答
const qa: { q: string; a: string[] }[] = [
  {
    q: '你是如何与星空结缘的？第一次拍星的经历还记得吗？',
    a: [
      '我与星空的结缘并非源于某个时刻，而是长久的兴趣。童年的插画书启蒙了我对天文的兴趣，从初中起，我便长期关注「每日一天文图」（APOD）、《中国国家天文》以及星联 CSVA 等平台，对星野摄影作品的印象尤其深刻，那种深邃宏大、自然相融的感觉，让我兴奋。为了探索星空，我深入阅读了《时间简史》与苏宜老师的《天文学新概论》。',
      '高考后，为了离星空更近，我填报志愿考入西北的西安石油大学学习物理专业，并加入了校天文协会。通过协会，我有机会把天文的知识进行实践，望远镜的操作，星空拍摄地的考察和选取，在校内进行天文的公益讲座等等，是我们社团的日常活动。通过社团的学长，我有幸结识了陕西高校天文联合会的很多同好和朋友，并代表协会参与汉中留坝火烧店镇乡村天文台地开幕仪式，在此期间有幸向多位星联的老师交流学习，我深度认识到自己摄影技术的欠缺，于是后来主动关注星空摄影的知识，同时把旧单反换成了全画幅微单，技术从此得到飞速进步。',
      '后来有幸留在天文协会担任会长。在担任会长期间，我多次带队带领缺乏暗区观星经验的学弟学妹前往优质暗区，让他们亲眼看见璀璨银河，在这个过程中我也积累了大量的实践经验。同时，我也经常在线下去联络摄影器材厂商，与他们交流是否有意愿合作举办星空主题的摄影讲座甚至组织实践拍摄星空，虽然并未成功举办星空主题活动，却是成为了佳能的高校影像官，与佳能和永诺合作举办过人像摄影会活动，但至今我仍然在期待星空主题摄影讲座甚至实践拍摄的合作活动机会，希望加入星联后能通过星联的平台有更好的机会去合作组织这些活动。',
      '从高中拿着手机专业模式和廉价的三脚架，对着头顶的北斗七星摆弄，再到现在带着一身装备，提前好久看云图，长途跋涉到合适的暗区，在几乎无人的半夜，经历漫长的等待，拍下无数张令我激动的照片，兴尽而归，坐在电脑桌前把它们处理成一张张满意的作品……一路走来，结识了很多伙伴和老师，正是在与他们的交流和学习之中，我才有了诸多感触和进步，才让我成为了今天更好的自己。尤其是我的女朋友，非常感谢她的支持和付出，从汉中小镇，到宁夏银川贺兰山，再到四川九寨沟，然后到秦岭，宝鸡关山，甘肃张家川，这拍星的一路上有她相伴，并且承担了我们两个出行全部的自驾任务。',
    ],
  },
  {
    q: '你最满意的星空作品是哪幅？与大伙分享一下创作过程？',
    a: [
      '我最满意的星空作品是银河落入雪地那张。',
      '这张照片来之不易，拍摄它的经历也是我最难忘的拍星经历，当时我们早上从西安出发，一路开到宝鸡关山脚下，到山脚的时候天开始黑了，上山的路是30公里的山路，路上全是雪，只有我们一个车，路下面是落差极大的山谷，车也没有上防滑链，甚至多次打滑，从晚上7点到10点，我们摸着黑打着滑硬生生开上去了。',
      '上来之后把车停到民宿就步行开始上观星台，我女朋友一路跟着，我们从中午就没有休息吃饭，一直挨到当时在观星台的冰天雪地里才吃了我们那天的第一顿饭，我记得很清楚，一个自热锅一个自热米饭，那简直是这辈子吃过的最好吃的自热锅，寒风不断吹，但绝美的星野景色却让我们兴奋至极，身体虽然寒冷，却并不难受。',
      '其实本来是去拍延时的，没打算能出银拱的图，是最后打算要走的时候，觉得来都来了多拍点类型，于是临时匆匆拍摄的，接片时只有7张，后期的时候我打算采用ptgui接片，然后在ps中做调整和强化，之前一直在追求对称的拱桥构图，因为头顶和右侧的的画面拍摄不够，接片导出后怎么看怎么怪，银河被拉的很难看，怎么尝试都不自然，构图也很狭隘，于是就想着还原当时的画面出一张记录一下，没想到却非常好看，挺让人感慨，人有时候太过相信自己的改造，却忘记了，大自然进化亿万年的美，有时候我们只需要去记录就好了。',
    ],
  },
  {
    q: '你是什么星座？最喜欢的星座或天体是什么？为什么？',
    a: [
      '星座：巨蟹座',
      '最喜欢的天体：北极星',
      '为什么：',
      '无论是在山东老家的院落、大学深夜的操场，还是如今奔赴各地的每一个星空机位，只要抬头，北极星总在北方的夜空中沉静伫立。',
      '小时候对它的认知是朴素的「指引方向」；后来深入星空摄影，才真正理解它是地轴在北天的投影，漫天回旋的星轨皆以它为圆心。对我而言，它更像是一位贯穿时空的恒常挚友，串联起了我生命的不同章节。',
      '从童年、求学到经历人生的每一次转折与变故，有时回望过去，会觉得不同阶段的自己割裂得像是在经历几段不同的人生。但每一次在暗夜中重新找到北极星，那些散落在不同岁月里的记忆碎片就会被悄然归整。它像苍穹之上一个永恒的锚点，在时间的流转中提醒着我：无论身处何地、迈向哪个阶段，所有走过的痕迹，最终构成的都是同一个真实的自己。',
    ],
  },
  {
    q: '讲个故事吧，就是最难忘的那次拍星经历？',
    a: [
      '至今仍然清楚的记得，我和我女朋友去拍冬季银河的时候，那一次是去拍摄作品，没有带队，只有我们一个车，有30公里的山路，路上全是雪，路下面是落差极大的山谷，而且天已经完全黑了，车也没有上防滑链，甚至多次打滑，即使开到后面她心态崩溃，她也开着车安全上山又在次日安全下山，这对她一个取得驾驶证但并没有多少实践经验的人来说是一件非常了不起的事，她付出了很多，也亲眼见证了我一步步的成长，我的很多作品里应该有她的一半。',
    ],
  },
  {
    q: '拍星这么久了，最深的感悟是什么？',
    a: [
      '最深的感悟是：「星空摄影是严谨理性的极致追求，也是感性浪漫的终极表达，更是一群人的双向奔赴。」',
      '从看云图、选暗区，到后期的动态范围与色彩平滑控制，它需要极度严谨的物理与摄影技术支撑；但当你在几乎无人的半夜漫长等待，收获一张满意的作品时，那种对自然的敬畏又是极其浪漫的。更重要的是，从自己摸索到担任校天协会长带学弟学妹去优质暗区，再到作为佳能高校影像官推动摄影交流，我发现「分享星空」带来的快乐，远大于一个人单打独斗。',
    ],
  },
  {
    q: '星空，对你意味着什么？',
    a: [
      '对我而言，星空既是探索宇宙物理规律的终极实验室，也是沉淀心灵、传递美好的精神领地。',
      '我深度认同星联「推动更多人仰望星空」的理念。当我在校内公益讲座上展示自己拍摄的作品，看到同学们眼中闪烁的好奇与向往时；当我有幸参与汉中留坝火烧店镇乡村天文台开幕、向各位前辈交流学习时，我更加坚信星空属于每一个人。星空不仅治愈了我，也给予了我用摄影、技术与组织能力去感染更多人的力量。',
    ],
  },
];
---

<BaseLayout lang={lang} title={t('about.title')} description={t('about.lead')} section="neutral" preserveWorldNav={true}>
  <section class="head container-wide">
    <div class="head-text reveal">
      <p class="kicker">{t('about.title')}</p>
      <h1 class="display">{SITE.author[lang]}</h1>
      <p class="role mono">{t('about.lead')}</p>
      <p class="lead head-lead">
        星空摄影是严谨理性的极致追求，也是感性浪漫的终极表达。
      </p>
    </div>
    <figure class="head-photo reveal" style={`background:${portrait.color}`}>
      <img
        src={withBase('/images/about-portrait.webp')}
        alt={portrait.title[lang]}
        width="1400"
        height="1120"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </section>

  <section class="container-wide block">
    <div class="block-head reveal">
      <span class="mono num">01</span>
      <div class="block-title">
        <h2 class="h2">{t('about.storyTitle')}</h2>
        <p class="block-subtitle mono">星联CSVA普鲁斯特问卷</p>
      </div>
    </div>
    <div class="qa-list reveal">
      {qa.map((item, i) => (
        <details class="qa" open={i === 0}>
          <summary class="qa-q">
            <span class="qa-q-num mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="qa-q-text">{item.q}</span>
            <span class="qa-toggle" aria-hidden="true"></span>
          </summary>
          <div class="qa-a-wrap">
            <div class="qa-a prose">
              {item.a.map((p) => <p>{p}</p>)}
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="container-wide block">
    <div class="block-head reveal">
      <span class="mono num">02</span>
      <h2 class="h2">{t('about.gearTitle')}</h2>
    </div>
    <div class="gear">
      {gear.map((g) => (
        <div class="gear-col reveal">
          <span class="mono gear-kind">{g.kind}</span>
          <ul>
            {g.items.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="container-wide block">
    <div class="block-head reveal">
      <span class="mono num">03</span>
      <h2 class="h2">{t('about.nowTitle')}</h2>
    </div>
    <div class="now reveal">
      <p class="now-text">
        大四，物理专业。在把摄影与工程两件事都做成能拿出来的东西：一边继续拍，一边写代码。
      </p>
      <div class="now-links">
        <a class="btn" href={localizePath('/works', lang)}>{t('photo.viewAll')} <span class="arrow">→</span></a>
        <a class="btn" href={localizePath('/projects', lang)}>{t('nav.projects')} <span class="arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .head {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    padding-top: clamp(56px, 9vw, 110px);
    padding-bottom: clamp(40px, 6vw, 80px);
    border-bottom: 1px solid var(--line);
  }

  .head .display {
    margin-top: 20px;
  }

  .role {
    margin-top: 18px;
    color: var(--text-dim);
    letter-spacing: 0.06em;
  }

  .head-lead {
    margin-top: 24px;
    color: var(--text-dim);
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.9;
  }

  .head-photo {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--card-shadow);
  }

  .head-photo img {
    width: 100%;
    height: auto;
  }

  .head-photo figcaption {
    margin-top: 12px;
    color: var(--text-faint);
  }

  .block {
    padding-block: clamp(40px, 6vw, 76px);
    border-top: 1px solid var(--line);
  }

  .block:first-of-type {
    border-top: 0;
  }

  .block-head {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: clamp(26px, 3.4vw, 44px);
  }

  .num {
    color: var(--accent, var(--warm));
  }

  .block-title {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .block-subtitle {
    letter-spacing: 0.18em;
    color: var(--text-faint);
  }

  /* ---------- 星联 CSVA 普鲁斯特问卷：可收起问答 ---------- */
  .qa-list {
    max-width: 72ch;
    border-bottom: 1px solid var(--line);
  }

  .qa {
    border-top: 1px solid var(--line);
  }

  .qa-q {
    list-style: none;
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.2vw, 26px);
    padding-block: clamp(20px, 2.8vw, 32px);
    cursor: pointer;
    color: var(--text);
  }

  .qa-q::-webkit-details-marker {
    display: none;
  }

  .qa-q-num {
    flex-shrink: 0;
    color: var(--accent, var(--warm));
  }

  .qa-q-text {
    flex: 1;
    min-width: 0;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.55;
    font-weight: 600;
    text-wrap: pretty;
  }

  .qa-toggle {
    position: relative;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--accent, var(--warm));
    transition: transform 0.42s var(--ease);
  }

  .qa-toggle::before {
    content: '';
    position: absolute;
    inset: 2px 0 0;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
  }

  .qa[open] .qa-toggle {
    transform: rotate(180deg);
  }

  /* grid-rows 0fr→1fr 实现丝滑展开，内层 overflow 裁剪 */
  .qa-a-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.42s var(--ease);
  }

  .qa[open] .qa-a-wrap {
    grid-template-rows: 1fr;
  }

  .qa-a {
    overflow: hidden;
    min-height: 0;
    opacity: 0;
    padding: 4px 0 30px 24px;
    border-left: 2px solid var(--line);
    transition: opacity 0.3s ease, border-color 0.42s ease;
  }

  .qa[open] .qa-a {
    opacity: 1;
    border-color: var(--accent, var(--warm));
    transition: opacity 0.42s ease 0.08s, border-color 0.42s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .qa-a-wrap,
    .qa-a,
    .qa-toggle {
      transition: none;
    }
  }

  .gear {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 3vw, 48px);
  }

  .gear-kind {
    display: block;
    margin-bottom: 14px;
    color: var(--text-faint);
  }

  .gear ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }

  .gear li {
    font-size: 13.5px;
    color: var(--text-dim);
    padding-bottom: 9px;
    border-bottom: 1px solid var(--line);
  }

  .now {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }

  .now-text {
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.8;
    color: var(--text);
    max-width: 34ch;
  }

  .now-links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .head {
      grid-template-columns: 1fr;
    }
    .gear {
      grid-template-columns: 1fr;
    }
  }
</style>
