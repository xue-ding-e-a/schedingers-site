---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { works } from '../data/works';
import { useTranslations, localizePath, withBase } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

const { lang = 'zh' } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
const portrait = works.find((w) => w.slug === 'stars-fall-on-village')!;

const gear = [
  { kind: '机身', items: ['Sony A7C', 'Sony A7R III'] },
  { kind: '镜头', items: ['Brightin Star 12mm f/2.8', 'Viltrox 16mm f/1.8', 'Sigma 28-70mm f/2.8'] },
  { kind: '后期', items: ['PTGui（拼接）', 'Photoshop（堆栈与调色）'] },
];
---

<BaseLayout lang={lang} title={t('about.title')} description={t('about.lead')} section="neutral">
  <section class="head container-wide">
    <div class="head-text">
      <p class="kicker">{t('about.title')}</p>
      <h1 class="display">{SITE.author[lang]}</h1>
      <p class="role mono">{t('about.lead')}</p>
      <p class="lead head-lead">
        星空摄影是严谨理性的极致追求，也是感性浪漫的终极表达，更是一群人的双向奔赴。
      </p>
    </div>
    <figure class="head-photo" style={`background:${portrait.color}`}>
      <img src={withBase(portrait.thumb)} alt={portrait.title[lang]} loading="lazy" decoding="async" />
      <figcaption class="mono">{portrait.title[lang]} · {portrait.region[lang]}</figcaption>
    </figure>
  </section>

  <section class="container-wide block">
    <div class="block-head">
      <span class="mono num">01</span>
      <h2 class="h2">{t('about.storyTitle')}</h2>
    </div>
    <div class="prose story">
      <p>
        我与星空的结缘并非源于某个时刻，而是长久的兴趣。童年的插画书启蒙了我对天文的兴趣。从初中起，我长期关注 NASA 的「每日一天文图」、《中国国家天文》以及星联 CSVA，对星野摄影那种深邃宏大、与自然相融的感觉印象尤其深刻。
      </p>
      <p>
        高考后，为了离星空更近，我报考了西安石油大学物理专业，并加入校天文协会。通过协会，我第一次把天文知识落到实处：操作望远镜、考察并选取拍摄地、在校内做天文公益讲座。后来我担任协会会长，多次带缺乏暗区经验的学弟学妹前往优质暗区，让他们亲眼看见银河。
      </p>
      <p>
        也是在这个阶段，我成为佳能高校影像官，与佳能、永诺合作举办过人像摄影会。我的很多作品背后还有一个人——从汉中小镇到宁夏贺兰山，再到四川九寨沟、秦岭、宝鸡关山、甘肃张家川，她承担了我们全部的驾驶。
      </p>
      <p>
        星空对我而言，既是探索宇宙物理规律的终极实验室，也是沉淀心灵、传递美好的精神领地。当我在校内讲座上展示自己拍的作品，看到同学们眼里那点好奇与向往时，我更确信：星空属于每一个人。
      </p>
    </div>
  </section>

  <section class="container-wide block">
    <div class="block-head">
      <span class="mono num">02</span>
      <h2 class="h2">{t('about.gearTitle')}</h2>
    </div>
    <div class="gear">
      {gear.map((g) => (
        <div class="gear-col reveal">
          <span class="mono gear-kind">{g.kind}</span>
          <ul>
            {g.items.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="container-wide block">
    <div class="block-head">
      <span class="mono num">03</span>
      <h2 class="h2">{t('about.nowTitle')}</h2>
    </div>
    <div class="now">
      <p class="now-text">
        大四，物理专业。在把摄影与工程两件事都做成能拿出来的东西：一边继续拍，一边写代码。
      </p>
      <div class="now-links">
        <a class="btn" href={localizePath('/works', lang)}>{t('photo.viewAll')} <span class="arrow">→</span></a>
        <a class="btn" href={localizePath('/projects', lang)}>{t('nav.projects')} <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <section class="container-wide block">
    <div class="block-head">
      <span class="mono num">04</span>
      <h2 class="h2">{t('about.contactTitle')}</h2>
    </div>
    <div class="contact-row">
      <a href={`mailto:${SITE.email}`} class="contact-link">{SITE.email}</a>
      <span class="mono">WeChat · {SITE.wechat}</span>
      <a class="btn" href={localizePath('/contact', lang)}>{t('nav.contact')} <span class="arrow">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .head {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    padding-top: clamp(56px, 9vw, 110px);
    padding-bottom: clamp(40px, 6vw, 80px);
    border-bottom: 1px solid var(--line);
  }

  .head .display {
    margin-top: 20px;
  }

  .role {
    margin-top: 18px;
    color: var(--text-dim);
    letter-spacing: 0.06em;
  }

  .head-lead {
    margin-top: 24px;
    color: var(--text-dim);
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.9;
  }

  .head-photo {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--card-shadow);
  }

  .head-photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .head-photo figcaption {
    margin-top: 12px;
    color: var(--text-faint);
  }

  .block {
    padding-block: clamp(40px, 6vw, 76px);
    border-top: 1px solid var(--line);
  }

  .block:first-of-type {
    border-top: 0;
  }

  .block-head {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: clamp(26px, 3.4vw, 44px);
  }

  .num {
    color: var(--warm);
  }

  .story {
    max-width: 72ch;
  }

  .gear {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 3vw, 48px);
  }

  .gear-kind {
    display: block;
    margin-bottom: 14px;
    color: var(--text-faint);
  }

  .gear ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }

  .gear li {
    font-size: 13.5px;
    color: var(--text-dim);
    padding-bottom: 9px;
    border-bottom: 1px solid var(--line);
  }

  .now {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }

  .now-text {
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.8;
    color: var(--text);
    max-width: 34ch;
  }

  .now-links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .contact-row {
    display: flex;
    align-items: center;
    gap: 26px;
    flex-wrap: wrap;
  }

  .contact-link {
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 3px;
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
  }

  .contact-link:hover {
    color: var(--warm);
    border-color: var(--warm);
  }

  @media (max-width: 900px) {
    .head {
      grid-template-columns: 1fr;
    }
    .gear {
      grid-template-columns: 1fr;
    }
  }
</style>
