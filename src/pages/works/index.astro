---
import WorksGallery from '../../components/WorksGallery.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { works, sortByDate } from '../../data/works';
import { series } from '../../data/series';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

const { lang = 'zh' } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
const list = sortByDate(works);

---

<BaseLayout lang={lang} title={t('works.title')} description={t('works.lead')} section="photo">
  <section class="page-head container-wide reveal">
    <p class="kicker">{t('photo.kicker')}</p>
    <h1 class="display">{t('works.title')}</h1>
    <p class="lead head-lead">{t('works.lead')}</p>
  </section>

  <div class="filter-bar">
    <div class="container-wide filter-inner reveal">
      <span class="mono filter-label">{t('works.filter')}</span>
      <div class="chips" role="group" aria-label={t('works.filter')}>
        <button class="chip is-active" data-filter="all" aria-pressed="true">{t('works.all')}</button>
        {series.map((s) => (
          <button class="chip" data-filter={s.slug} aria-pressed="false">{s.name[lang]}</button>
        ))}
      </div>
      <span class="mono numeric count"><span id="work-count">{list.length}</span> {t('works.count')}</span>
    </div>
  </div>

  <section class="container-wide works-wrap">
    <WorksGallery {lang} worksByDate={list} />
    <p class="empty" id="empty" hidden>{t('works.empty')}</p>
    <p class="note mono" id="works-sort-note" hidden>{t('works.sortNote')}</p>
  </section>
</BaseLayout>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip[data-filter]'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('.work-item'));
  const count = document.getElementById('work-count');
  const empty = document.getElementById('empty');

  const grid = document.querySelector<HTMLElement>('#works-grid')!;
  const curated = document.getElementById('curated-works')!;
  const sortNote = document.getElementById('works-sort-note')!;
  let packedWidth = 0;

  function packFilteredWorks() {
    if (grid.hidden) return;

    const width = grid.getBoundingClientRect().width;
    packedWidth = width;
    const gap = parseFloat(getComputedStyle(grid).columnGap);
    const byDate = new Map<string, { item: HTMLElement; width: number; index: number }[]>();

    for (const [index, item] of items.entries()) {
      if (item.hidden) continue;
      const date = item.dataset.date ?? '';
      const cards = byDate.get(date) ?? [];
      cards.push({ item, width: item.getBoundingClientRect().width, index });
      byDate.set(date, cards);
    }

    const order = [...byDate.values()].flatMap(cards => {
      const rows: { remaining: number; cards: typeof cards }[] = [];
      // Place wider works first, then use each row's leftover space for narrower works.
      for (const card of cards.sort((a, b) => b.width - a.width)) {
        const row = rows.find(row => row.remaining >= gap + card.width);
        if (row) {
          row.cards.push(card);
          row.remaining -= gap + card.width;
        } else {
          rows.push({ remaining: width - card.width, cards: [card] });
        }
      }
      return rows.flatMap(row => row.cards.sort((a, b) => a.index - b.index).map(card => card.item));
    });

    const displayed = Array.from(grid.children).filter(child => !(child as HTMLElement).hidden);
    if (order.some((item, index) => item !== displayed[index])) {
      const focus = document.activeElement;
      grid.append(...order);
      if (focus instanceof HTMLElement && grid.contains(focus)) focus.focus({ preventScroll: true });
    }
  }

  const sizeObserver = new ResizeObserver(() => {
    if (!grid.hidden && grid.getBoundingClientRect().width !== packedWidth) packFilteredWorks();
  });
  sizeObserver.observe(grid);

  const apply = (filter: string) => {
    const showAll = filter === 'all';
    curated.hidden = !showAll;
    grid.hidden = showAll;
    sortNote.hidden = showAll;
    let visible = 0;
    for (const item of items) {
      const show = item.dataset.series === filter;
      item.hidden = !show;
      if (show) visible += 1;
    }
    if (!showAll) packFilteredWorks();
    if (count) count.textContent = String(showAll ? items.length : visible);
    if (empty) empty.hidden = showAll || visible > 0;
  };

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      chips.forEach((c) => {
        c.classList.toggle('is-active', c === chip);
        c.setAttribute('aria-pressed', String(c === chip));
      });
      apply(chip.dataset.filter || 'all');
    });
  }
</script>

<style>
  .page-head {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 10px clamp(18px, 2vw, 32px);
    padding-block: clamp(28px, 4vw, 56px) clamp(20px, 2.5vw, 36px);
  }

  .page-head .kicker {
    grid-column: 1 / -1;
  }

  .filter-bar {
    position: sticky;
    top: var(--nav-h);
    z-index: 40;
    background: rgba(6, 7, 11, 0.82);
    backdrop-filter: blur(16px);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .filter-inner {
    display: flex;
    align-items: center;
    gap: 22px;
    padding-block: 10px;
  }

  .filter-label {
    flex-shrink: 0;
  }

  .chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-block: 2px;
  }

  .chips::-webkit-scrollbar {
    display: none;
  }

  .count {
    margin-left: auto;
    flex-shrink: 0;
  }

  .works-wrap {
    padding-block: clamp(18px, 2vw, 30px) 40px;
  }

  .empty {
    padding-block: 80px;
    text-align: center;
    color: var(--text-faint);
    font-size: 14px;
  }

  .note {
    margin-top: 20px;
    text-align: right;
    color: var(--text-faint);
  }

  @media (max-width: 640px) {
    .page-head {
      grid-template-columns: 1fr;
      row-gap: 8px;
    }

    .filter-label,
    .count {
      display: none;
    }
  }
</style>
