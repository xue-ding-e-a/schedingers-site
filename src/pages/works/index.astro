---
import PhotoArranger from '../../components/PhotoArranger.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { works, sortByDate } from '../../data/works';
import { series } from '../../data/series';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

const { lang = 'zh' } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
const list = sortByDate(works);

---

<BaseLayout lang={lang} title={t('works.title')} description={t('works.lead')} section="photo">
  <section class="page-head container-wide">
    <p class="kicker">{t('photo.kicker')}</p>
    <h1 class="display">{t('works.title')}</h1>
    <p class="lead head-lead">{t('works.lead')}</p>
  </section>

  <div class="filter-bar">
    <div class="container-wide filter-inner">
      <span class="mono filter-label">{t('works.filter')}</span>
      <div class="chips" role="group" aria-label={t('works.filter')}>
        <button class="chip is-active" data-filter="all" aria-pressed="true">{t('works.all')}</button>
        {series.map((s) => (
          <button class="chip" data-filter={s.slug} aria-pressed="false">{s.name[lang]}</button>
        ))}
      </div>
      <span class="mono numeric count"><span id="work-count">{list.length}</span> {t('works.count')}</span>
    </div>
  </div>

  <section class="container-wide works-wrap">
    <PhotoArranger scope="works" {lang} photos={list.map(work => ({ work }))} />
    <div class="works-grid" id="works-grid" data-arranger-original>
      {list.map((w, i) => (
        <div
          class="work-item"
          style={`--ratio:${w.width / w.height}`}
          data-series={w.series}
        >
          <WorkCard work={w} lang={lang} eager={i < 3} />
        </div>
      ))}
    </div>
    <p class="empty" id="empty" hidden>{t('works.empty')}</p>
  </section>

  <p class="container-wide note mono">{t('works.sortNote')}</p>
</BaseLayout>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip[data-filter]'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('.work-item'));
  const count = document.getElementById('work-count');
  const empty = document.getElementById('empty');

  const grid = document.querySelector<HTMLElement>('#works-grid')!;
  const desktop = window.matchMedia('(min-width: 641px)');

  // Count the caption as part of each card, including wrapped translations.
  const fitRows = () => {
    if (!desktop.matches || !('ResizeObserver' in window)) return;
    const style = getComputedStyle(grid);
    const gap = parseFloat(style.columnGap);
    const unit = parseFloat(style.getPropertyValue('--row-unit'));
    const rows = items.map(item => Math.ceil((item.offsetHeight + gap) / unit));
    items.forEach((item, i) => {
      if (!item.hidden) item.style.setProperty('--rows', String(rows[i]));
    });
    grid.classList.add('packed');
  };

  if ('ResizeObserver' in window) {
    const observer = new ResizeObserver(fitRows);
    items.forEach(item => observer.observe(item));
    desktop.addEventListener('change', fitRows);
    fitRows();
  }

  const apply = (filter: string) => {
    let visible = 0;
    for (const item of items) {
      const show = filter === 'all' || item.dataset.series === filter;
      item.hidden = !show;
      if (show) visible += 1;
    }
    fitRows();
    if (count) count.textContent = String(visible);
    if (empty) empty.hidden = visible > 0;
  };

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      chips.forEach((c) => {
        c.classList.toggle('is-active', c === chip);
        c.setAttribute('aria-pressed', String(c === chip));
      });
      apply(chip.dataset.filter || 'all');
    });
  }
</script>

<style>
  .page-head {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 10px clamp(18px, 2vw, 32px);
    padding-block: clamp(28px, 4vw, 56px) clamp(20px, 2.5vw, 36px);
  }

  .page-head .kicker {
    grid-column: 1 / -1;
  }

  .filter-bar {
    position: sticky;
    top: var(--nav-h);
    z-index: 40;
    background: rgba(6, 7, 11, 0.82);
    backdrop-filter: blur(16px);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .filter-inner {
    display: flex;
    align-items: center;
    gap: 22px;
    padding-block: 10px;
  }

  .filter-label {
    flex-shrink: 0;
  }

  .chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-block: 2px;
  }

  .chips::-webkit-scrollbar {
    display: none;
  }

  .count {
    margin-left: auto;
    flex-shrink: 0;
  }

  .works-wrap {
    padding-top: clamp(18px, 2vw, 30px);
  }

  .works-grid {
    --row-unit: 4px;
    --gallery-gap: clamp(16px, 1.8vw, 28px);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gallery-gap);
    align-items: start;
  }

  .work-item {
    min-width: 0;
  }

  @media (min-width: 641px) {
    .works-grid.packed {
      grid-auto-rows: var(--row-unit);
      grid-auto-flow: row dense;
      row-gap: 0;
    }

    .packed > .work-item {
      grid-row-end: span var(--rows, 1);
    }

    .work-item {
      grid-column: span 6;
    }
  }

  .work-item[hidden] {
    display: none;
  }

  .empty {
    padding-block: 80px;
    text-align: center;
    color: var(--text-faint);
    font-size: 14px;
  }

  .note {
    padding-bottom: 40px;
    text-align: right;
    color: var(--text-faint);
  }

  @media (max-width: 640px) {
    .page-head {
      grid-template-columns: 1fr;
      row-gap: 8px;
    }

    .works-grid {
      justify-items: center;
      grid-template-columns: minmax(0, 1fr);
      row-gap: 32px;
    }

    .work-item {
      width: 100%;
    }

    .work-item {
      max-width: calc(var(--ratio) * 56svh);
    }

    .filter-label,
    .count {
      display: none;
    }
  }
</style>
