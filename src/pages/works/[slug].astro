---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { works } from '../../data/works';
import { getSeries } from '../../data/series';
import { useTranslations, localizePath, formatDate, withBase } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return works.map((work, i) => ({
    params: { slug: work.slug },
    props: { work, index: i },
  }));
}

const { work, index } = Astro.props;
const { lang = 'zh' } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
const s = getSeries(work.series);
const prev = works[(index - 1 + works.length) % works.length];
const next = works[(index + 1) % works.length];

const exifRows = [
  { label: t('work.camera'), value: work.gear.camera },
  { label: t('work.lens'), value: work.gear.lens },
  { label: t('work.aperture'), value: work.exif.aperture },
  { label: t('work.iso'), value: work.exif.iso },
  { label: t('work.shutter'), value: work.exif.shutter },
  { label: t('work.focal'), value: work.exif.focal },
  { label: t('work.frames'), value: work.exif.frames },
  { label: t('work.technique'), value: work.technique[lang] },
];

// 详情页按视口挑档：手机用已有缩略图，桌面用 1600 中间档，只有大屏才取原图
const stageSrcset = [
  `${withBase(work.thumb)} 1100w`,
  work.width > 1600 ? `${withBase(work.image.replace(/\.webp$/, '-1600.webp'))} 1600w` : null,
  `${withBase(work.image)} ${work.width}w`,
]
  .filter(Boolean)
  .join(', ');
---

<BaseLayout lang={lang} title={work.title[lang]} description={work.story[lang].slice(0, 90)} section="photo" image={work.thumb}>
  <Fragment slot="head">
    <script is:inline>document.documentElement.classList.add('js');</script>
  </Fragment>

  <article class="work">
    <div class="container-wide work-top">
      <a class="back mono" href={localizePath('/works', lang)}>← {t('work.back')}</a>
      <div class="title-row">
        <h1 class="display work-title">{work.title[lang]}</h1>
        <div class="title-meta">
          <span class="mono">{formatDate(work.date, lang)}</span>
          <span class="mono">{work.location[lang]}</span>
        </div>
      </div>
    </div>

    <figure class="stage container-wide">
      <img
        src={withBase(work.image)}
        srcset={stageSrcset}
        sizes="(min-width: 1728px) 1600px, (min-width: 1280px) calc(100vw - 128px), calc(100vw - 40px)"
        alt={work.title[lang]}
        width={work.width}
        height={work.height}
        fetchpriority="high"
        decoding="async"
        style={`background:${work.color}`}
      />
      <figcaption class="mono">{work.title[lang]} · {work.region[lang]}</figcaption>
    </figure>

    <div class="container-wide body">
      <div class="story">
        <p class="kicker">{t('work.story')}</p>
        <div class="prose">
          {work.story[lang].split('\n\n').map((p) => <p>{p}</p>)}
        </div>
      </div>

      <aside class="aside">
        <p class="kicker">{t('work.exif')}</p>
        <dl class="exif">
          {exifRows.map((row) => (
            <div class="exif-row">
              <dt class="mono">{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
        </dl>

        {s && (
          <a class="series-link" href={localizePath(`/collections/${s.slug}`, lang)}>
            <span class="mono">{t('work.seriesOf')}</span>
            <span class="series-link-name">{s.name[lang]} →</span>
          </a>
        )}

        <div class="coords mono">
          {work.coords[0].toFixed(2)}°N / {work.coords[1].toFixed(2)}°E
        </div>
      </aside>
    </div>

    <nav class="container-wide pager">
      <a class="pager-link" href={localizePath(`/works/${prev.slug}`, lang)}>
        <span class="mono">← {t('work.prev')}</span>
        <span class="pager-name">{prev.title[lang]}</span>
      </a>
      <a class="pager-link right" href={localizePath(`/works/${next.slug}`, lang)}>
        <span class="mono">{t('work.next')} →</span>
        <span class="pager-name">{next.title[lang]}</span>
      </a>
    </nav>
  </article>

  <div class="work-loader" id="work-loader" aria-hidden="true">
    <div class="loader-inner">
      <div class="loader-meta mono">
        <span>{lang === 'zh' ? '正在显影' : 'DEVELOPING'}</span>
        <span class="loader-pct">00</span>
      </div>
      <div class="loader-track"><i></i></div>
    </div>
  </div>

  <script is:inline>
    (() => {
      const loader = document.getElementById('work-loader');
      const img = document.querySelector('.stage img');
      if (!loader || !img) return;

      const stage = img.closest('.stage');
      const fill = loader.querySelector('.loader-track i');
      const pct = loader.querySelector('.loader-pct');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const startedAt = performance.now();

      let raf = 0;
      let done = false;
      let timer = 0;

      const render = (value) => {
        fill.style.width = value + '%';
        pct.textContent = String(Math.round(value)).padStart(2, '0');
      };

      const markReady = () => stage.classList.add('is-ready');

      const hideLoader = (instant) => {
        if (done) return;
        done = true;
        cancelAnimationFrame(raf);
        clearTimeout(timer);
        if (instant) loader.style.transition = 'none';
        loader.classList.add('is-done');
      };

      const finish = () => {
        render(100);
        // 最短展示 420ms，避免过渡层一闪而过
        setTimeout(() => hideLoader(false), Math.max(0, 420 - (performance.now() - startedAt)));
      };

      if (reduce) {
        markReady();
        hideLoader(true);
        return;
      }

      stage.classList.add('is-gated');

      // 命中缓存：直接放行，不播过渡
      if (img.complete && img.naturalWidth) {
        markReady();
        hideLoader(true);
        return;
      }

      img.addEventListener(
        'load',
        () => {
          markReady();
          finish();
        },
        { once: true }
      );
      img.addEventListener(
        'error',
        () => {
          markReady();
          finish();
        },
        { once: true }
      );

      const step = (now) => {
        const t = Math.min(1, (now - startedAt) / 2400);
        render(Math.min(92, 6 + 86 * (1 - Math.pow(1 - t, 3))));
        if (t < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);

      // 慢网兜底：最多遮 4s，先放正文出来，图片继续加载
      timer = setTimeout(() => hideLoader(false), 4000);
    })();
  </script>
</BaseLayout>

<style>
  .work-top {
    padding-top: clamp(40px, 6vw, 84px);
    padding-bottom: clamp(28px, 3vw, 44px);
  }

  .back {
    color: var(--text-faint);
    transition: color 0.3s var(--ease);
  }

  .back:hover {
    color: var(--text);
  }

  .title-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    flex-wrap: wrap;
    margin-top: 26px;
  }

  .work-title {
    max-width: 20ch;
  }

  .title-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-end;
    text-align: right;
    padding-bottom: 10px;
  }

  .stage {
    margin: 0 auto;
  }

  .stage img {
    width: 100%;
    height: auto;
    max-height: 86svh;
    object-fit: contain;
    margin-inline: auto;
  }

  .stage figcaption {
    margin-top: 14px;
    color: var(--text-faint);
    display: flex;
    justify-content: flex-end;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(260px, 0.75fr);
    gap: clamp(40px, 6vw, 100px);
    padding-block: clamp(48px, 7vw, 96px);
  }

  .story .kicker {
    margin-bottom: 26px;
  }

  .aside {
    border-left: 1px solid var(--line);
    padding-left: clamp(24px, 3vw, 44px);
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-self: start;
    position: sticky;
    top: calc(var(--nav-h) + 32px);
  }

  .exif {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .exif-row {
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 14px;
    padding-block: 11px;
    border-bottom: 1px solid var(--line);
  }

  .exif-row:first-child {
    border-top: 1px solid var(--line);
  }

  .exif-row dt {
    color: var(--text-faint);
    font-size: 11px;
    padding-top: 2px;
  }

  .exif-row dd {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: #cdd3e1;
  }

  .series-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 3px;
    transition: border-color 0.4s var(--ease), background 0.4s var(--ease);
  }

  .series-link:hover {
    border-color: var(--line-strong);
    background: rgba(255, 255, 255, 0.03);
  }

  .series-link-name {
    font-size: 14px;
  }

  .coords {
    color: var(--text-faint);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    border-top: 1px solid var(--line);
    padding-block: 36px 60px;
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: color 0.3s var(--ease);
  }

  .pager-link.right {
    align-items: flex-end;
    text-align: right;
  }

  .pager-name {
    font-size: 17px;
    transition: color 0.3s var(--ease);
  }

  .pager-link:hover .pager-name {
    color: var(--warm);
  }

  @media (max-width: 900px) {
    .body {
      grid-template-columns: 1fr;
    }
    .aside {
      position: static;
      border-left: 0;
      border-top: 1px solid var(--line);
      padding-left: 0;
      padding-top: 28px;
    }
    .title-meta {
      align-items: flex-start;
      text-align: left;
    }
  }

  /* ---------- 进入详情页的全屏显影过渡 ---------- */
  .work-loader {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    place-items: center;
    background: #000000;
    transition: opacity 0.55s var(--ease), visibility 0.55s var(--ease);
  }

  /* 无脚本时直接放行内容 */
  html:not(.js) .work-loader {
    display: none;
  }

  .work-loader.is-done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .loader-inner {
    width: min(420px, 62vw);
    display: grid;
    gap: 14px;
  }

  .loader-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--text-dim);
  }

  .loader-pct {
    color: var(--primary);
    font-variant-numeric: tabular-nums;
  }

  .loader-track {
    height: 1px;
    background: rgba(255, 255, 255, 0.16);
    overflow: hidden;
  }

  .loader-track i {
    display: block;
    width: 0;
    height: 100%;
    background: var(--primary);
    box-shadow: 0 0 14px rgba(229, 201, 164, 0.55);
  }

  .stage.is-gated img {
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }

  .stage.is-gated.is-ready img {
    opacity: 1;
  }
</style>
