---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { useTranslations, localizePath, withBase } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import headingFont from '../assets/fonts/up-job-heading-subset.woff2';
import numericFont from '../assets/fonts/up-job-numeric-subset.woff2';

const { lang = 'zh' } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
const langHref = withBase(otherLang === 'en' ? '/en/' : '/');
const langLabel = otherLang === 'zh' ? '中文' : 'EN';
---

<BaseLayout lang={lang} title={t('portal.title')} chrome={false} accent="warm">
  <Fragment slot="head">
    <link rel="preload" as="script" href={withBase('/vendor/three-bg.js')} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={headingFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={numericFont} crossorigin />
  </Fragment>
  <canvas id="three-canvas" aria-hidden="true"></canvas>
  <div class="portal">
    <div class="veil" aria-hidden="true"></div>

    <header class="portal-top">
      <span class="mono">{t('portal.overline')}</span>
      <div class="top-links">
        <a class="lang-mini" href={localizePath('/index', lang)}>{t('nav.index')}</a>
        <a class="lang-mini" href={langHref} hreflang={otherLang} lang={otherLang}>{langLabel}</a>
      </div>
    </header>

    <div class="portal-core">
      <p class="kicker">{t('site.tagline')}</p>
      <h1 class="portal-title">
        <span class="typewriter-text grad-text" id="typewriter">{t('portal.title')}</span><span class="typewriter-cursor" aria-hidden="true"></span>
      </h1>
      <p class="portal-lead">{t('portal.desc')}</p>
    </div>

    <nav class="doors" aria-label="Choose a track">
      <a class="door door-photo" href={localizePath('/photo', lang)}>
        <span class="door-index mono numeric">01</span>
        <span class="door-body">
          <span class="door-en">{t('portal.photoEn')}</span>
          <span class="door-title">{t('portal.photo')}</span>
          <span class="door-desc">{t('portal.photoDesc')}</span>
        </span>
        <span class="door-arrow" aria-hidden="true">→</span>
      </a>

      <a class="door door-dev" href={localizePath('/dev', lang)}>
        <span class="door-index mono numeric">02</span>
        <span class="door-body">
          <span class="door-en">{t('portal.devEn')}</span>
          <span class="door-title">{t('portal.dev')}</span>
          <span class="door-desc">{t('portal.devDesc')}</span>
        </span>
        <span class="door-arrow" aria-hidden="true">→</span>
      </a>
    </nav>

    <footer class="portal-foot">
      <span class="mono">{t('portal.footer')}</span>
      <span class="mono">© {new Date().getFullYear()} {SITE.author[lang]}</span>
    </footer>
  </div>

  <script src={withBase('/vendor/three-bg.js')} type="module" is:inline></script>
  <script>
    const el = document.getElementById('typewriter');
    if (el) {
      const texts = ['薛定谔的站点', "Schedinger's site"];
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced) {
        el.textContent = texts[0];
      } else {
        let wordIndex = 0;
        let charIndex = texts[0].length;
        let isDeleting = false;
        let timer;

        const step = () => {
          const word = texts[wordIndex];
          if (!isDeleting) {
            if (charIndex < word.length) {
              charIndex += 1;
              el.textContent = word.slice(0, charIndex);
              timer = setTimeout(step, 90);
              return;
            }
            isDeleting = true;
            timer = setTimeout(step, 1600);
            return;
          }
          if (charIndex > 0) {
            charIndex -= 1;
            el.textContent = word.slice(0, charIndex);
            timer = setTimeout(step, 55);
            return;
          }
          isDeleting = false;
          wordIndex = (wordIndex + 1) % texts.length;
          timer = setTimeout(step, 260);
        };

        timer = setTimeout(step, 1800);

        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            clearTimeout(timer);
          } else {
            step();
          }
        });
        window.addEventListener('beforeunload', () => clearTimeout(timer));
      }
    }
  </script>
</BaseLayout>

<style>
  .portal {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding: 26px var(--gutter) 26px;
    overflow: hidden;
    --accent: #e5c9a4;
  }

  .veil {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(60% 48% at 24% 42%, rgba(236, 72, 153, 0.12), transparent 70%),
      radial-gradient(62% 50% at 78% 48%, rgba(6, 182, 212, 0.1), transparent 72%),
      radial-gradient(90% 80% at 50% 110%, rgba(2, 6, 23, 0.92), transparent 60%);
    pointer-events: none;
  }

  .portal-top,
  .portal-core,
  .doors,
  .portal-foot {
    position: relative;
    z-index: 2;
  }

  .portal-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-faint);
  }

  .top-links {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .lang-mini {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--text-faint);
    transition: color 0.3s var(--ease);
  }

  .lang-mini:hover {
    color: var(--text);
  }

  .portal-core {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    max-width: 900px;
    padding-block: 8vh 4vh;
    animation: rise 1.1s var(--ease) both;
  }

  .portal-title {
    margin-top: 22px;
    font-size: clamp(3rem, 9.5vw, 7.6rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 900;
    white-space: nowrap;
  }

  .typewriter-cursor {
    display: inline-block;
    width: clamp(3px, 0.55vw, 6px);
    height: 0.82em;
    background: var(--accent, var(--warm));
    border-radius: 2px;
    margin-left: 0.06em;
    vertical-align: baseline;
    transform: translateY(0.06em);
    animation: typewriter-blink 1s ease-in-out infinite;
  }

  @keyframes typewriter-blink {
    50% {
      opacity: 0.3;
    }
  }

  .portal-lead {
    margin-top: 26px;
    max-width: 30em;
    font-size: clamp(0.98rem, 1.3vw, 1.1rem);
    line-height: 1.9;
    color: var(--text-dim);
    text-wrap: pretty;
  }

  .doors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    animation: rise 1.1s var(--ease) 0.18s both;
  }

  .door {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 20px;
    padding: 34px 28px 40px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(30, 41, 59, 0.32);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    overflow: hidden;
    transition: background 0.35s var(--ease), border-color 0.35s var(--ease),
      transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }

  .door-photo:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: 0 18px 40px rgba(229, 201, 164, 0.18);
  }

  .door-photo:focus-visible {
    outline-color: var(--accent);
  }

  .door-dev:hover {
    border-color: var(--cool);
    transform: translateY(-3px);
    box-shadow: 0 18px 40px rgba(6, 182, 212, 0.16);
  }

  .door::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.5s var(--ease);
    pointer-events: none;
  }

  .door-photo::before {
    background: radial-gradient(70% 120% at 20% 100%, rgba(229, 201, 164, 0.18), transparent 70%);
  }

  .door-dev::before {
    background: radial-gradient(70% 120% at 80% 100%, rgba(6, 182, 212, 0.16), transparent 70%);
  }

  .door:hover::before {
    opacity: 1;
  }

  .door-index {
    font-size: 11px;
    color: var(--text-faint);
    padding-top: 6px;
    transition: color 0.4s var(--ease);
  }

  .door-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .door-en {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.24em;
    color: var(--text-faint);
    transition: color 0.4s var(--ease);
  }

  .door-title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    letter-spacing: -0.02em;
    font-weight: 900;
    line-height: 1.2;
  }

  .door-desc {
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--text-dim);
    max-width: 28em;
    text-wrap: balance;
  }

  .door-arrow {
    font-size: 18px;
    color: var(--text-faint);
    transition: transform 0.45s var(--ease), color 0.45s var(--ease);
    padding-top: 4px;
  }

  .door:hover .door-arrow {
    transform: translateX(8px);
    color: var(--text);
  }

  .door-photo:hover .door-index,
  .door-photo:hover .door-en {
    color: var(--accent);
  }

  .door-dev:hover .door-index,
  .door-dev:hover .door-en {
    color: var(--cool);
  }

  .portal-foot {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding-top: 20px;
    color: var(--text-faint);
    border-top: 1px solid var(--line);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .doors {
      grid-template-columns: 1fr;
    }
    .portal-core {
      padding-block: 10vh 4vh;
    }
  }
</style>
