---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { useTranslations, localizePath, withBase } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

const { lang = 'zh' } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
const langHref = withBase(otherLang === 'en' ? '/en/' : '/');
const langLabel = otherLang === 'zh' ? '中文' : 'EN';
---

<BaseLayout lang={lang} title={t('portal.title')} chrome={false} accent="warm">
  <canvas id="three-canvas" aria-hidden="true"></canvas>
  <div class="portal">
    <div class="veil" aria-hidden="true"></div>

    <header class="portal-top">
      <span class="mono">{t('portal.overline')}</span>
      <a class="lang-mini" href={langHref} hreflang={otherLang} lang={otherLang}>{langLabel}</a>
    </header>

    <div class="portal-core">
      <p class="kicker">{t('site.tagline')}</p>
      <h1 class="portal-title grad-text">{t('portal.title')}</h1>
      <p class="portal-lead">{t('portal.desc')}</p>
    </div>

    <nav class="doors" aria-label="Choose a track">
      <a class="door door-photo" href={localizePath('/photo', lang)}>
        <span class="door-index mono">01</span>
        <span class="door-body">
          <span class="door-en">{t('portal.photoEn')}</span>
          <span class="door-title">{t('portal.photo')}</span>
          <span class="door-desc">{t('portal.photoDesc')}</span>
        </span>
        <span class="door-arrow" aria-hidden="true">→</span>
      </a>

      <a class="door door-dev" href={localizePath('/dev', lang)}>
        <span class="door-index mono">02</span>
        <span class="door-body">
          <span class="door-en">{t('portal.devEn')}</span>
          <span class="door-title">{t('portal.dev')}</span>
          <span class="door-desc">{t('portal.devDesc')}</span>
        </span>
        <span class="door-arrow" aria-hidden="true">→</span>
      </a>
    </nav>

    <footer class="portal-foot">
      <span class="mono">{t('portal.footer')}</span>
      <span class="mono">© {new Date().getFullYear()} {SITE.author[lang]}</span>
    </footer>
  </div>

  <script src={withBase('/vendor/three-bg.js')} type="module" is:inline></script>
</BaseLayout>

<style>
  .portal {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding: 26px var(--gutter) 26px;
    overflow: hidden;
    --accent: var(--warm);
  }

  .veil {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(60% 48% at 24% 42%, rgba(236, 72, 153, 0.12), transparent 70%),
      radial-gradient(62% 50% at 78% 48%, rgba(6, 182, 212, 0.1), transparent 72%),
      radial-gradient(90% 80% at 50% 110%, rgba(2, 6, 23, 0.92), transparent 60%);
    pointer-events: none;
  }

  .portal-top,
  .portal-core,
  .doors,
  .portal-foot {
    position: relative;
    z-index: 2;
  }

  .portal-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-faint);
  }

  .lang-mini {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--text-faint);
    transition: color 0.3s var(--ease);
  }

  .lang-mini:hover {
    color: var(--text);
  }

  .portal-core {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    max-width: 900px;
    padding-block: 8vh 4vh;
    animation: rise 1.1s var(--ease) both;
  }

  .portal-title {
    margin-top: 22px;
    font-size: clamp(3rem, 9.5vw, 7.6rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 700;
  }

  .portal-lead {
    margin-top: 26px;
    max-width: 44ch;
    font-size: clamp(0.98rem, 1.3vw, 1.1rem);
    line-height: 1.9;
    color: var(--text-dim);
  }

  .doors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    animation: rise 1.1s var(--ease) 0.18s both;
  }

  .door {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 20px;
    padding: 34px 28px 40px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(30, 41, 59, 0.32);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    overflow: hidden;
    transition: background 0.35s var(--ease), border-color 0.35s var(--ease),
      transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }

  .door-photo:hover {
    border-color: var(--warm);
    transform: translateY(-3px);
    box-shadow: 0 18px 40px rgba(236, 72, 153, 0.18);
  }

  .door-dev:hover {
    border-color: var(--cool);
    transform: translateY(-3px);
    box-shadow: 0 18px 40px rgba(6, 182, 212, 0.16);
  }

  .door::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.5s var(--ease);
    pointer-events: none;
  }

  .door-photo::before {
    background: radial-gradient(70% 120% at 20% 100%, rgba(236, 72, 153, 0.18), transparent 70%);
  }

  .door-dev::before {
    background: radial-gradient(70% 120% at 80% 100%, rgba(6, 182, 212, 0.16), transparent 70%);
  }

  .door:hover::before {
    opacity: 1;
  }

  .door-index {
    font-size: 11px;
    color: var(--text-faint);
    padding-top: 6px;
    transition: color 0.4s var(--ease);
  }

  .door-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .door-en {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.24em;
    color: var(--text-faint);
    transition: color 0.4s var(--ease);
  }

  .door-title {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    letter-spacing: -0.02em;
    font-weight: 600;
    line-height: 1.2;
  }

  .door-desc {
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--text-dim);
    max-width: 34ch;
  }

  .door-arrow {
    font-size: 18px;
    color: var(--text-faint);
    transition: transform 0.45s var(--ease), color 0.45s var(--ease);
    padding-top: 4px;
  }

  .door:hover .door-arrow {
    transform: translateX(8px);
    color: var(--text);
  }

  .door-photo:hover .door-index,
  .door-photo:hover .door-en {
    color: var(--warm);
  }

  .door-dev:hover .door-index,
  .door-dev:hover .door-en {
    color: var(--cool);
  }

  .portal-foot {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding-top: 20px;
    color: var(--text-faint);
    border-top: 1px solid var(--line);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .doors {
      grid-template-columns: 1fr;
    }
    .portal-core {
      padding-block: 10vh 4vh;
    }
  }
</style>
