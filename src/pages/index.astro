---
import BaseLayout from '../layouts/BaseLayout.astro';
import DevelopingOverlay from '../components/DevelopingOverlay.astro';
import { SITE } from '../consts';
import { useTranslations, localizePath, withBase } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import headingFont from '../assets/fonts/up-job-heading-subset.woff2';
import numericFont from '../assets/fonts/up-job-numeric-subset.woff2';
import portalSkyScript from '../scripts/portal-sky.js?raw';

const { lang = 'zh' } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
const langHref = withBase(otherLang === 'en' ? '/en/' : '/');
const langLabel = otherLang === 'zh' ? '中文' : 'EN';
const photoHref = localizePath('/photo/', lang);
---

<BaseLayout lang={lang} title={t('portal.title')} chrome={false} accent="warm">
  <Fragment slot="head">
    <link rel="preload" as="font" type="font/woff2" href={headingFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={numericFont} crossorigin />
    <script is:inline set:html={portalSkyScript}></script>
  </Fragment>
  <div class="portal-sky" aria-hidden="true">
    <div class="portal-stars"></div>
    <canvas id="portal-canvas"></canvas>
  </div>
  <div class="portal">
    <div class="veil" aria-hidden="true"></div>

    <header class="portal-top">
      <span class="portal-brand">
        <svg
          class="portal-mark"
          viewBox="0 0 64 64"
          width="26"
          height="26"
          aria-hidden="true"
          focusable="false"
        >
          <g class="mark-track mark-track--photo" transform="rotate(30 32 32)">
            <ellipse class="mark-orbit" cx="32" cy="32" rx="27" ry="10.5" />
            <circle class="mark-dot mark-dot--photo" cx="5" cy="32" r="3.4" />
          </g>
          <g class="mark-track mark-track--dev" transform="rotate(-30 32 32)">
            <ellipse class="mark-orbit" cx="32" cy="32" rx="27" ry="10.5" />
            <circle class="mark-dot mark-dot--dev" cx="59" cy="32" r="3.4" />
          </g>
          <circle class="mark-core" cx="32" cy="32" r="8" />
        </svg>
        <span class="portal-word">S<span class="portal-cut">C</span>H<span class="portal-cut">E</span>DINGER</span>
      </span>
      <div class="top-links">
        <a class="lang-mini" href={localizePath('/index', lang)}>{t('nav.index')}</a>
        <a class="lang-mini" href={langHref} hreflang={otherLang} lang={otherLang}>{langLabel}</a>
      </div>
    </header>

    <div class="portal-core">
      <p class="kicker">{t('site.tagline')}</p>
      <h1 class="portal-title">
        <span class="typewriter-text grad-text" id="typewriter">{t('portal.title')}</span><span class="typewriter-cursor" aria-hidden="true"></span>
      </h1>
      <p class="portal-lead">{t('portal.desc')}</p>
    </div>

    <nav class="doors" aria-label="Choose a track">
      <a class="door door-photo" href={photoHref}>
        <span class="door-index mono numeric">01</span>
        <span class="door-body">
          <span class="door-en">{t('portal.photoEn')}</span>
          <span class="door-title">{t('portal.photo')}</span>
          <span class="door-desc">{t('portal.photoDesc')}</span>
        </span>
        <span class="door-arrow" aria-hidden="true">→</span>
      </a>

      <a class="door door-dev" href={localizePath('/dev', lang)}>
        <span class="door-index mono numeric">02</span>
        <span class="door-body">
          <span class="door-en">{t('portal.devEn')}</span>
          <span class="door-title">{t('portal.dev')}</span>
          <span class="door-desc">{t('portal.devDesc')}</span>
        </span>
        <span class="door-arrow" aria-hidden="true">→</span>
      </a>
    </nav>

    <script is:inline>startPortalSky();</script>

    <footer class="portal-foot">
      <span class="mono">{t('portal.footer')}</span>
      <span class="mono">© {new Date().getFullYear()} {SITE.author[lang]}</span>
    </footer>
  </div>

  <DevelopingOverlay id="photo-entry-loader" lang={lang} />

  <script is:inline define:vars={{ photoHref }}>
    (() => {
      const door = document.querySelector('.door-photo');
      const loader = document.getElementById('photo-entry-loader');
      const entryKey = 'sch-photo-entry';

      door.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey ||
            event.shiftKey || event.altKey) return;

        try {
          sessionStorage.setItem(entryKey, new URL(door.href).pathname.replace(/\/$/, ''));
          loader.classList.remove('is-done');
        } catch {
          // 存储不可用时，链接照常打开摄影页。
        }
      });
      window.addEventListener('pageshow', (event) => {
        if (!event.persisted) return;
        loader.classList.add('is-done');
        try { sessionStorage.removeItem(entryKey); } catch {}
      });

      // 门户加载完成后，低优先级预热摄影首页
      const loaded = new Promise((resolve) => {
        if (document.readyState === 'complete') resolve();
        else window.addEventListener('load', resolve, { once: true });
      });
      const fonts = document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve();

      Promise.all([loaded, fonts]).then(() => {
        const conn = navigator.connection;
        if (conn && (conn.saveData || /2g$/.test(conn.effectiveType || ''))) return;

        const link = document.createElement('link');
        link.rel = 'prefetch';
        link.href = photoHref;
        document.head.appendChild(link);
      });
    })();
  </script>
  <script>
    const el = document.getElementById('typewriter');
    if (el) {
      const texts = ['薛定谔的站点', "Schedinger's site"];

      let wordIndex = 0;
      let charIndex = texts[0].length;
      let isDeleting = false;
      let timer;
      const step = () => {
        const word = texts[wordIndex];
        if (!isDeleting) {
          if (charIndex < word.length) {
            charIndex += 1;
            el.textContent = word.slice(0, charIndex);
            timer = setTimeout(step, 90);
            return;
          }
          isDeleting = true;
          timer = setTimeout(step, 1600);
          return;
        }
        if (charIndex > 0) {
          charIndex -= 1;
          el.textContent = word.slice(0, charIndex);
          timer = setTimeout(step, 55);
          return;
        }
        isDeleting = false;
        wordIndex = (wordIndex + 1) % texts.length;
        timer = setTimeout(step, 260);
      };
      timer = setTimeout(step, 1800);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          clearTimeout(timer);
        } else {
          step();
        }
      });
      window.addEventListener('beforeunload', () => clearTimeout(timer));
    }
  </script>
</BaseLayout>

<style>
  .portal-sky {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .portal-stars,
  #portal-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .portal-stars {
    /* 星点随首屏样式一同绘制。不同大小的重复图层打散星点间距。 */
    background-image:
      radial-gradient(circle at 17% 32%, #b89be4 0.7px, transparent 1.5px),
      radial-gradient(circle at 62% 81%, #a66e9f 0.8px, transparent 1.7px),
      radial-gradient(circle at 77% 24%, #7998d7 0.6px, transparent 1.4px),
      radial-gradient(circle at 38% 63%, #705c9c 0.55px, transparent 1.2px),
      radial-gradient(circle at 72% 46%, #b699cc 1px, transparent 2px),
      radial-gradient(circle at 33% 17%, #6284b9 0.55px, transparent 1.3px);
    background-size: 163px 127px, 211px 173px, 131px 181px, 97px 119px, 347px 271px, 123px 149px;
  }

  .portal-stars {
    inset: -20px;
    width: auto;
    height: auto;
    animation: stars-drift 8s linear infinite alternate;
  }

  #portal-canvas,
  .portal-sky.is-rendered .portal-stars {
    visibility: hidden;
  }

  .portal-sky.is-rendered #portal-canvas {
    visibility: visible;
  }

  .portal-sky.is-rendered .portal-stars {
    animation: none;
  }

  @keyframes stars-drift {
    to { transform: translate(16px, -12px); }
  }

  .portal {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding: 26px var(--gutter) 26px;
    overflow: hidden;
    --accent: #e5c9a4;
  }

  .veil {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(60% 48% at 24% 42%, rgba(236, 72, 153, 0.12), transparent 70%),
      radial-gradient(62% 50% at 78% 48%, rgba(6, 182, 212, 0.1), transparent 72%),
      radial-gradient(90% 80% at 50% 110%, rgba(2, 6, 23, 0.92), transparent 60%);
    pointer-events: none;
  }

  .portal-top,
  .portal-core,
  .doors,
  .portal-foot {
    position: relative;
    z-index: 2;
  }

  .portal-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-faint);
  }

  /* 门户左上角品牌：与摄影、工程页 header 同款图案 + 字标，静态呈现，不做展开动画 */
  .portal-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
  }

  .portal-mark {
    width: 26px;
    height: 26px;
    display: block;
    flex-shrink: 0;
    overflow: visible;
  }

  /* 门户标识 = 摄影与工程两条高亮轨道的叠加 */
  .portal-mark .mark-orbit {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 3;
    opacity: 0.86;
  }

  .portal-mark .mark-core {
    fill: currentColor;
  }

  /* 两轨叠加同样包含两枚主题色轨道点，覆盖全局默认的隐藏态 */
  .portal-mark .mark-dot {
    opacity: 1;
  }

  .portal-mark .mark-dot--photo {
    fill: #e4ab63;
  }

  .portal-mark .mark-dot--dev {
    fill: #7c67e4;
  }

  .portal-word {
    font-family: var(--font-heading);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1;
    white-space: nowrap;
  }

  .portal-cut {
    display: inline-block;
    -webkit-mask-image: linear-gradient(60deg, #000 0 45%, transparent 45.1% 55%, #000 55.1%);
    mask-image: linear-gradient(60deg, #000 0 45%, transparent 45.1% 55%, #000 55.1%);
  }

  .top-links {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .lang-mini {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--text-faint);
    transition: color 0.3s var(--ease);
  }

  .lang-mini:hover {
    color: var(--text);
  }

  .portal-core {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    max-width: 900px;
    padding-block: 8vh 4vh;
  }

  .portal-core {
    animation: rise 1.1s var(--ease) both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .portal-title {
    margin-top: 22px;
    font-size: clamp(3rem, 9.5vw, 7.6rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 900;
    white-space: nowrap;
  }

  .typewriter-cursor {
    display: inline-block;
    width: clamp(3px, 0.55vw, 6px);
    height: 0.82em;
    background: var(--accent, var(--warm));
    border-radius: 2px;
    margin-left: 0.06em;
    vertical-align: baseline;
    transform: translateY(0.06em);
    animation: typewriter-blink 1s ease-in-out infinite;
  }

  @keyframes typewriter-blink {
    50% {
      opacity: 0.3;
    }
  }

  .portal-lead {
    margin-top: 26px;
    max-width: 30em;
    font-size: clamp(0.98rem, 1.3vw, 1.1rem);
    line-height: 1.9;
    color: var(--text-dim);
    text-wrap: pretty;
  }

  .doors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    /* Avoid animating ancestor opacity so the glass can sample the sky on the first paint. */
  }

  .door {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 20px;
    padding: 34px 28px 40px;
    border-radius: 16px;
    background: rgba(30, 41, 59, 0.32);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    overflow: hidden;
    transition: background 0.35s var(--ease), transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }

  .door-photo:hover,
  .door-dev:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px rgba(2, 6, 23, 0.45);
  }

  .door-photo:focus-visible,
  .door-dev:focus-visible {
    outline-color: var(--text);
  }

  .door-index {
    font-size: 11px;
    color: var(--text-faint);
    padding-top: 6px;
    transition: color 0.4s var(--ease);
  }

  .door-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .door-en {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.24em;
    color: var(--text-faint);
    transition: color 0.4s var(--ease);
  }

  .door-title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    letter-spacing: -0.02em;
    font-weight: 900;
    line-height: 1.2;
  }

  .door-desc {
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--text-dim);
    max-width: 28em;
    text-wrap: balance;
  }

  .door-arrow {
    font-size: 18px;
    color: var(--text-faint);
    transition: transform 0.45s var(--ease), color 0.45s var(--ease);
    padding-top: 4px;
  }

  .door:hover .door-arrow {
    transform: translateX(8px);
    color: var(--text);
  }

  .door:hover .door-index,
  .door:hover .door-en {
    color: var(--text);
  }

  .portal-foot {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding-top: 20px;
    color: var(--text-faint);
  }

  @media (max-width: 760px) {
    .doors {
      grid-template-columns: 1fr;
    }
    .portal-core {
      padding-block: 10vh 4vh;
    }
  }
</style>
