---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

const { lang = 'zh' } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('contact.title')} description={t('contact.lead')} section="neutral">
  <section class="container-wide head">
    <p class="kicker">{t('contact.title')}</p>
    <h1 class="display">{t('contact.lead')}</h1>
  </section>

  <section class="container-wide rows">
    <div class="row">
      <span class="mono label">{t('contact.email')}</span>
      <a class="value" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <button class="copy mono" data-copy={SITE.email} data-label={t('contact.copy')} data-done={t('contact.copied')}>
        {t('contact.copy')}
      </button>
    </div>

    <div class="row">
      <span class="mono label">{t('contact.wechat')}</span>
      <span class="value">{SITE.wechat}</span>
      <button class="copy mono" data-copy={SITE.wechat} data-label={t('contact.copy')} data-done={t('contact.copied')}>
        {t('contact.copy')}
      </button>
    </div>

    <div class="row">
      <span class="mono label">LOCATION</span>
      <span class="value">{SITE.location[lang]}</span>
      <span class="copy mono"></span>
    </div>
  </section>

  <section class="container-wide note">
    <p>{t('contact.note')}</p>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy || '';
      const label = btn.dataset.label || '';
      const done = btn.dataset.done || 'Copied';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = done;
        setTimeout(() => (btn.textContent = label), 1600);
      } catch {
        btn.textContent = text;
      }
    });
  });
</script>

<style>
  .head {
    padding-top: clamp(64px, 10vw, 130px);
    padding-bottom: clamp(36px, 5vw, 56px);
  }

  .head .display {
    margin-top: 22px;
    max-width: 16ch;
  }

  .rows {
    border-top: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: 120px 1fr 110px;
    gap: 24px;
    align-items: center;
    padding-block: clamp(22px, 3vw, 34px);
    border-bottom: 1px solid var(--line);
  }

  .label {
    color: var(--text-faint);
    font-size: 11px;
  }

  .value {
    font-size: clamp(1.2rem, 2.6vw, 1.9rem);
    letter-spacing: -0.01em;
    transition: color 0.3s var(--ease);
  }

  a.value:hover {
    color: var(--warm);
  }

  .copy {
    justify-self: end;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
  }

  .copy:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }

  .note {
    padding-block: clamp(36px, 5vw, 60px) 40px;
  }

  .note p {
    font-size: 13px;
    line-height: 1.9;
    color: var(--text-faint);
    max-width: 62ch;
  }

  @media (max-width: 720px) {
    .row {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .copy {
      justify-self: start;
    }
  }
</style>
