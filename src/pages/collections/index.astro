---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { series } from '../../data/series';
import { works } from '../../data/works';
import { useTranslations, localizePath, withBase } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

const { lang = 'zh' } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);

const points = series.map((s) => {
  const items = works.filter((w) => w.series === s.slug);
  return {
    slug: s.slug,
    name: s.name[lang],
    region: s.region[lang],
    coords: s.coords,
    count: items.length,
    href: localizePath(`/collections/${s.slug}`, lang),
  };
});
---

<BaseLayout lang={lang} title={t('series.title')} description={t('series.lead')} section="photo">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <section class="page-head container-wide">
    <p class="kicker">{t('photo.series')}</p>
    <h1 class="display">{t('series.title')}</h1>
    <p class="lead head-lead">{t('series.lead')}</p>
  </section>

  <section class="container-wide map-sec">
    <div class="map-head">
      <p class="kicker">{t('atlas.title')}</p>
      <p class="map-lead">{t('atlas.lead')}</p>
      <p class="mono hint">{t('atlas.hint')}</p>
    </div>
    <div class="map-wrap">
      <div
        id="map"
        style="height: clamp(360px, 58vh, 620px)"
        data-points={JSON.stringify(points)}
        data-no-network={t('atlas.noNetwork')}
      ></div>
      <p class="map-fallback mono" id="map-fallback">{t('atlas.loading')}</p>
    </div>
  </section>

  <section class="container-wide list">
    {series.map((s, i) => {
      const cover = works.find((w) => w.slug === s.cover)!;
      const count = works.filter((w) => w.series === s.slug).length;
      return (
        <a class="row reveal" href={localizePath(`/collections/${s.slug}`, lang)}>
          <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="thumb" style={`background:${s.color}`}>
            <img src={withBase(cover.thumb)} alt={s.name[lang]} loading="lazy" decoding="async" />
          </span>
          <span class="text">
            <span class="name">{s.name[lang]}</span>
            <span class="region mono">{s.region[lang]} · {count} {t('series.works')}</span>
            <span class="desc">{s.desc[lang]}</span>
          </span>
          <span class="go" aria-hidden="true">→</span>
        </a>
      );
    })}
  </section>

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    const el = document.getElementById('map');
    const fallback = document.getElementById('map-fallback');
    const noNetwork = el?.dataset.noNetwork || '';

    const init = () => {
      const L = (window as any).L;
      if (!L || !el) {
        if (fallback) fallback.textContent = noNetwork;
        return;
      }

      const points = JSON.parse(el.dataset.points || '[]');
      const map = L.map(el, {
        zoomControl: true,
        scrollWheelZoom: false,
        attributionControl: true,
      }).setView([34.4, 105.6], 5);

      L.tileLayer(
        'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}',
        {
          attribution: 'Tiles &copy; Esri &mdash; Esri, DeLorme, NAVTEQ',
          maxZoom: 16,
        }
      ).addTo(map);

      for (const p of points) {
        const marker = L.circleMarker([p.coords[0], p.coords[1]], {
          radius: 7,
          color: '#ec4899',
          weight: 1.5,
          fillColor: '#ec4899',
          fillOpacity: 0.35,
        }).addTo(map);

        marker.bindPopup(
          `<a href="${p.href}" style="color:#111;font-family:var(--font-body);text-decoration:none;">
             <strong>${p.name}</strong><br/>
             <span style="font-size:12px;opacity:.7">${p.region} · ${p.count}</span>
           </a>`
        );
      }

      if (fallback) fallback.remove();
    };

    if ((window as any).L) init();
    else window.addEventListener('load', init, { once: true });
  </script>
</BaseLayout>

<style>
  .page-head {
    padding-top: clamp(56px, 9vw, 110px);
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  .page-head .display {
    margin-top: 20px;
  }

  .head-lead {
    margin-top: 22px;
  }

  .map-sec {
    padding-bottom: clamp(36px, 5vw, 64px);
  }

  .map-head {
    display: flex;
    align-items: baseline;
    gap: 8px 24px;
    flex-wrap: wrap;
    padding-bottom: 18px;
  }

  .map-head .kicker {
    margin: 0;
  }

  .map-lead {
    color: var(--text-dim);
    font-size: 14px;
  }

  .hint {
    margin-left: auto;
    color: var(--text-faint);
  }

  .map-wrap {
    position: relative;
  }

  #map {
    border: 1px solid var(--line);
    background: #0a0d14;
    z-index: 1;
    scroll-margin-top: calc(var(--head-h, var(--nav-h)) + 16px);
  }

  #map :global(.leaflet-container) {
    background: #0a0d14;
  }

  #map :global(.leaflet-popup-content-wrapper),
  #map :global(.leaflet-popup-tip) {
    background: #f3f4f8;
    border-radius: 3px;
  }

  #map :global(.leaflet-control-attribution) {
    background: rgba(6, 7, 11, 0.7);
    color: #626a7d;
    font-size: 10px;
  }

  #map :global(.leaflet-control-attribution a) {
    color: #9aa2b4;
  }

  #map :global(.leaflet-bar a) {
    background: #0c0f18;
    color: #eef0f6;
    border-color: rgba(255, 255, 255, 0.12);
  }

  .map-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-faint);
    pointer-events: none;
  }

  .list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: 48px 220px 1fr 32px;
    gap: clamp(20px, 3vw, 44px);
    align-items: center;
    padding-block: clamp(24px, 3vw, 38px);
    border-bottom: 1px solid var(--line);
    transition: background 0.4s var(--ease);
  }

  .row:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .num {
    color: var(--text-faint);
    align-self: start;
    padding-top: 6px;
  }

  .thumb {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
    opacity: 0.9;
  }

  .row:hover .thumb img {
    transform: scale(1.05);
    opacity: 1;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .name {
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    letter-spacing: -0.02em;
  }

  .region {
    color: var(--text-faint);
  }

  .desc {
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--text-dim);
    max-width: 52ch;
  }

  .go {
    color: var(--text-faint);
    transition: transform 0.4s var(--ease), color 0.4s var(--ease);
  }

  .row:hover .go {
    transform: translateX(6px);
    color: var(--warm);
  }

  @media (max-width: 820px) {
    .row {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .num {
      display: none;
    }
    .go {
      display: none;
    }
    .hint {
      margin-left: 0;
    }
  }
</style>
