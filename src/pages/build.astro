---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import type { Localized } from '../data/works';

const { lang = 'zh' } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);

const stack: { name: string; why: Localized }[] = [
  {
    name: 'Astro 5',
    why: {
      zh: '页面静态生成。导航、筛选和动效由原生脚本处理。',
      en: 'Pages are generated statically. Native scripts handle navigation, filters and motion.',
    },
  },
  {
    name: 'TypeScript',
    why: {
      zh: '10 幅作品的字段一旦写错，页面会静默变丑。用类型把 EXIF、坐标、双语字段锁死。',
      en: 'A typo in the 10-work data silently breaks a page. Types lock down EXIF, coordinates and bilingual fields.',
    },
  },
  {
    name: '原生 CSS',
    why: {
      zh: '画幅比例差异极大，从 0.67 到 2.14。自己写栅格和列布局，比调框架的断点更直接。',
      en: 'Aspect ratios run from 0.67 to 2.14. Hand-written grids beat fighting a framework’s breakpoints.',
    },
  },
  {
    name: 'WebGL + CSS / MP4',
    why: {
      zh: '门户内联 WebGL 星空，和标题、入口一起首绘。摄影首页先显示封面，星轨视频走独立缓存。',
      en: 'The portal inlines its WebGL starfield so it can render with the title and entry cards. The photography homepage shows a poster while the star-trail video loads as a separately cacheable asset.',
    },
  },
  {
    name: 'Python / Pillow',
    why: {
      zh: '原始文件最大 144MB、1.68 亿像素。构建前用脚本批量生成 WebP 与缩略图，别让构建器去啃它。',
      en: 'The largest original is 144MB at 168 megapixels. A script pre-generates WebP and thumbnails so the bundler never has to chew on it.',
    },
  },
];

const flow: { step: Localized; ai: Localized; me: Localized }[] = [
  {
    step: { zh: '需求拆解与调研', en: 'Requirements & research' },
    ai: { zh: '检索 2026 年摄影作品集模板、真实星空摄影站与设计趋势，输出带取舍理由的清单。', en: 'Searched 2026 portfolio templates, real astrophotography sites and design trends, and produced a shortlist with trade-offs.' },
    me: { zh: '判断「不套模板」，把项目定位定在「可写进简历的作品」。', en: 'Decided against a template and positioned the project as a résumé-grade work.' },
  },
  {
    step: { zh: '信息架构', en: 'Information architecture' },
    ai: { zh: '把「摄影 + 工程」两条线展开成路由树、页面清单与优先级。', en: 'Expanded the photo/engineering split into a route tree, page list and priorities.' },
    me: { zh: '否掉融合式首页，选择双入口分流，并确定导航不再加第七项。', en: 'Rejected a merged homepage for dual entry, and capped navigation at six items.' },
  },
  {
    step: { zh: '内容建模', en: 'Content modelling' },
    ai: { zh: '把 10 张作品的描述整理成结构化字段：地点、坐标、机身、镜头、EXIF、堆栈方式。', en: 'Restructured ten descriptions into fields: place, coordinates, camera, lens, EXIF, stacking method.' },
    me: { zh: '校对参数与作品标题，补写英文版本，统一术语。', en: 'Verified settings and titles, wrote the English versions, normalised terminology.' },
  },
  {
    step: { zh: '实现与自测', en: 'Build & self-test' },
    ai: { zh: '按页生成组件、样式与数据绑定，处理双语路由镜像。', en: 'Generated components, styles and data binding per page, and mirrored the bilingual routes.' },
    me: { zh: '逐页在浏览器里看间距、断点与图片裁切，改掉不合适的地方。', en: 'Reviewed spacing, breakpoints and cropping page by page in the browser and fixed what did not hold up.' },
  },
];

const timeline: { date: string; title: Localized; desc: Localized }[] = [
  {
    date: '2026.11',
    title: { zh: '先看别人怎么做', en: 'Look at what exists' },
    desc: {
      zh: '把 Framer、Webflow 模板和真实的星空摄影站放在一起看，结论是：模板能做出好看的页面，但做不出可讲述的过程。',
      en: 'Put Framer and Webflow templates next to real astrophotography sites. Conclusion: templates produce good-looking pages, not a story worth telling.',
    },
  },
  {
    date: '2026.11',
    title: { zh: '从单主线改成双主线', en: 'From one track to two' },
    desc: {
      zh: '最初只有摄影。加上三个线上项目后，站点重新定为双入口门户，摄影与工程各自拥有独立导航。',
      en: 'The first version was photography only. With three live projects added, it became a dual-entry portal with independent navigation per track.',
    },
  },
  {
    date: '2026.11',
    title: { zh: '先处理素材，再写代码', en: 'Assets first, code second' },
    desc: {
      zh: '扫描 10 张原图，读出尺寸、比例与平均色，生成 WebP 与缩略图。最大的一张从 144MB 压到 700KB。',
      en: 'Scanned ten originals for size, ratio and average colour, then generated WebP and thumbnails. The largest went from 144MB to 700KB.',
    },
  },
  {
    date: '2026.11',
    title: { zh: '内容先于视觉', en: 'Content before visuals' },
    desc: {
      zh: '先把 10 段拍摄故事和参数录进数据文件，再设计页面。这样布局是被内容推出来的，不是反过来。',
      en: 'Loaded all ten stories and settings into data first, then designed. The layout follows the content, not the other way around.',
    },
  },
  {
    date: '2026.11',
    title: { zh: '双语镜像', en: 'Bilingual mirror' },
    desc: {
      zh: '中文为默认语言、无前缀；英文走 /en 前缀。内容字段一律成对，避免上线后补翻译。',
      en: 'Chinese as default without a prefix, English under /en. Every content field is paired from the start, so no after-the-fact translation.',
    },
  },
  {
    date: '2026.11.17',
    title: { zh: '先让部署跑通', en: 'Ship the pipeline first' },
    desc: {
      zh: '确定 GitHub Pages 子路径 /schedingers-site，接入 Actions 推送即构建。先把 base 与资源路径对齐，再谈视觉，避免上线后整站 404。',
      en: 'Fixed the GitHub Pages subpath /schedingers-site and wired Actions to build on every push — aligning base and asset paths before touching visuals, so the launch would not 404.',
    },
  },
  {
    date: '2026.11.17',
    title: { zh: '换掉通用深色模板', en: 'Replace the generic dark template' },
    desc: {
      zh: '改为玻璃按钮、蓝紫配色与 Space Grotesk / DM Sans 的 Darkness 体系，首页加 Three.js 粒子背景；随后把背景限制为仅首页按需加载，不让每页为它付包体成本。',
      en: 'Moved to a Darkness system of glass buttons, blue-violet accents and Space Grotesk / DM Sans, with a Three.js particle backdrop on the homepage — then limited it to on-demand homepage loading so every page did not pay the bundle cost.',
    },
  },
  {
    date: '2026.11.17',
    title: { zh: '中文字体不再「混血」', en: 'Stop mixed Chinese glyphs' },
    desc: {
      zh: '回退链补进 Noto Sans SC，并把标题、正文、数字、等宽拆成四套字体栈。子集字体缺字导致同一字段出现两种字形，最终换回全量字体解决。',
      en: 'Added Noto Sans SC to the fallback chain and split heading, body, numeric and mono into four stacks. Subset fonts dropped glyphs and mixed two shapes in one field, so full fonts replaced them.',
    },
  },
  {
    date: '2026.11.17',
    title: { zh: '拆成两条主线', en: 'Split into two tracks' },
    desc: {
      zh: '摄影黑、工程白，各自拥有独立导航与首页节奏，只共享字体、栅格、页脚与索引页。摄影导航统一毛玻璃与浮起阴影，并让首屏图覆盖到导航顶部。',
      en: 'Photography in black, engineering in white, each with its own navigation and homepage rhythm, sharing only type, grid, footer and the neutral index. Photo navigation gained a consistent glass and lift effect, with the hero image extending under it.',
    },
  },
  {
    date: '2026.11.18',
    title: { zh: '精选作品只保留横滑', en: 'Curated works, horizontal only' },
    desc: {
      zh: '取消摄影精选作品的上下入场动效与对应导航条，只保留横向滑动；卡片尺寸继续按原始照片的存储体积排序，文件越大卡片越大。',
      en: 'Removed the vertical entrance motion and its rail from the curated works, keeping horizontal scrolling only; card size still follows original file weight, larger files getting larger cards.',
    },
  },
  {
    date: '2026.11.18',
    title: { zh: '补上「联系」入口', en: 'Add the contact entry' },
    desc: {
      zh: '摄影导航增加到六项，末位补「联系」，与工程导航保持一致；门户页脚同步更新城市与身份信息。',
      en: 'The photo navigation now has six items, ending with Contact to match engineering, while the portal footer updated its locations and credentials.',
    },
  },
  {
    date: '2026.11.18',
    title: { zh: '把地图和大图放到需要它们的地方', en: 'Move maps and large images where they are needed' },
    desc: {
      zh: '观星地图并入系列总览，摄影首页把注意力留给精选作品。为标题和数字字体生成子集，作品详情增加 1600px 图像档位，浏览器可按屏幕选择合适资源。',
      en: 'Moved the stargazing map to the series index so the photography homepage could focus on featured works. Subset the heading and numeric fonts and added a 1,600px image size so browsers could pick a suitable asset for each screen.',
    },
  },
  {
    date: '2026.11.19',
    title: { zh: '让工程项目的成果可见', en: 'Make the engineering work visible' },
    desc: {
      zh: '为四个项目补齐封面，把 WowLand 招募宣讲整理成案例。导航胶囊改用独立底色，减少 Firefox 和内置浏览器与其他浏览器的色差。',
      en: 'Added covers to all four projects and wrote up the WowLand Campus Deck as a case study. Gave the navigation pills their own background colour to reduce differences across Firefox, in-app browsers and other browsers.',
    },
  },
  {
    date: '2026.11.20',
    title: { zh: '分开讲摄影与工程，也让浏览有来有回', en: 'Give each track its own story and keep the way back' },
    desc: {
      zh: '摄影关于页完整展示天文插画，工程关于页独立讲项目和履历。跨主线时原子 Logo 衔接加载和正文入场，透明站点图标随浏览器配色切换。系列页加入显影过渡，作品详情按照片原始比例展示，也可返回上一页。',
      en: 'The photography About page shows the full astronomical illustration, while engineering gets its own About page for projects and experience. The atom logo carries the transition between tracks, and the transparent favicon adapts to the browser colour scheme. Series pages gained an image reveal, while work details keep the original aspect ratio and offer a Back action.',
    },
  },
  {
    date: '2026.11.21',
    title: { zh: '先让首屏出现，再加载后面的照片', en: 'Show the hero first, then load the previews' },
    desc: {
      zh: '门户用内联 WebGL 绘制动态星空，并为不支持的设备提供 CSS 星野。摄影首页先显示 WebP 封面，再播放可缓存的循环星轨视频。精选作品和系列预览等视频开始播放后再加载。减少动效、暂停或播放失败时，直接放行预览。',
      en: 'The portal renders its animated starfield with inline WebGL, with CSS stars available as a fallback. The photography homepage shows a WebP poster before playing a cacheable star-trail loop. Featured work and series previews wait until the video starts. Reduced-motion mode, pausing and playback errors all release the previews immediately.',
    },
  },
  {
    date: '2026.11.22',
    title: { zh: '定稿摄影作品的浏览顺序与排版', en: 'Finalise the gallery layout and browsing order' },
    desc: {
      zh: '作品总览的「全部」视图采用三组等高并排与下方错落组合，保留原始画幅。筛选系列时，先按拍摄日期分组，再用窄图填补同日宽图所在行的余量，画廊宽度变化后重新排布。作品总览和系列详情也共用卡片交互。',
      en: 'The All view uses three equal-height pairs above a staggered group and keeps the original aspect ratios. Series filters group works by capture date, use narrower cards to fill remaining space alongside wider ones from the same day and repack when the gallery width changes. The works index and series details also share card interactions.',
    },
  },
  {
    date: '2026.11.22',
    title: { zh: '把联系方式统一收到页脚', en: 'Move contact details into the shared footer' },
    desc: {
      zh: '独立联系页和导航项合并为页脚联系区。摄影和工程页面底部都能找到联系方式，邮箱和微信支持一键复制。',
      en: 'Folded the standalone Contact page and navigation entry into a shared footer section. Both tracks now show contact details at the bottom of their pages, with copy buttons for email and WeChat.',
    },
  },
];

const lessons: { q: Localized; a: Localized }[] = [
  {
    q: { zh: '144MB、1.68 亿像素的原图怎么处理？', en: 'What do you do with a 144MB, 168-megapixel original?' },
    a: {
      zh: '用 Pillow 离线生成 WebP 大图、1600px 中间档与缩略图。详情页让浏览器按显示宽度选择资源，并用照片平均色占位，保持加载时的视觉连贯。',
      en: 'Pillow prepares large WebP images, a 1,600px intermediate size and thumbnails offline. The browser picks a size for the displayed width, and an average-colour placeholder fills the space while the image loads.',
    },
  },
  {
    q: { zh: '画幅从竖幅 0.67 到横幅 2.14，网格怎么排？', en: 'Ratios from 0.67 portrait to 2.14 panorama — how do you grid that?' },
    a: {
      zh: '作品总览按画幅配对，筛选后在同日作品内紧凑排布。系列详情按比例分配同排照片的宽度，单幅作品详情用原始比例控制画框。',
      en: 'The works index pairs photos by aspect ratio and packs same-day photos together when filtered. Series details size photos in each row by aspect ratio, and individual work pages use the original ratio to size the frame.',
    },
  },
  {
    q: { zh: '另外三个项目都没有公开仓库，GitHub 作品集怎么做？', en: 'The other three projects have no public repos — how does the GitHub portfolio work?' },
    a: {
      zh: '放弃实时 API，改用策展式卡片：手写定位、角色、技术栈与线上链接，卡片用浏览器窗口框架统一视觉。站点源码已公开在 GitHub，读者可以直接查看实现。',
      en: 'Drop the live API and curate instead: positioning, role, stack and live link are written by hand, with a shared browser-frame treatment. The public GitHub repository lets readers inspect how this site works.',
    },
  },
];

const facts = [
  { k: { zh: '作品', en: 'Works' }, v: '10' },
  { k: { zh: '系列', en: 'Series' }, v: '4' },
  { k: { zh: '每种语言的页面', en: 'Pages per language' }, v: '29' },
  { k: { zh: '语言', en: 'Languages' }, v: '2' },
];
---

<BaseLayout lang={lang} title={t('build.title')} description={t('build.lead')} section="dev" accent="cool">
  <section class="head container-wide reveal">
    <p class="kicker">Build Log / 2026.11</p>
    <h1 class="display-lg head-title">{t('build.title')}</h1>
    <p class="lead head-lead">{t('build.lead')}</p>

    <div class="facts">
      {facts.map((f) => (
        <div class="fact">
          <span class="fact-v">{f.v}</span>
          <span class="mono">{f.k[lang]}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="container-wide block">
    <div class="block-head reveal">
      <span class="mono numeric num">01</span>
      <h2 class="h2">{t('build.stackTitle')}</h2>
    </div>
    <div class="stack-table">
      {stack.map((s) => (
        <div class="stack-row reveal">
          <span class="stack-name">{s.name}</span>
          <span class="stack-why">{s.why[lang]}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="container-wide block">
    <div class="block-head reveal">
      <span class="mono numeric num">02</span>
      <h2 class="h2">{t('build.flowTitle')}</h2>
    </div>
    <div class="flow">
      {flow.map((f, i) => (
        <div class="flow-row reveal">
          <span class="flow-step mono">{String(i + 1).padStart(2, '0')} / {f.step[lang]}</span>
          <div class="flow-col">
            <span class="flow-label mono">AI</span>
            <p>{f.ai[lang]}</p>
          </div>
          <div class="flow-col">
            <span class="flow-label mono">ME</span>
            <p>{f.me[lang]}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="container-wide block">
    <div class="block-head reveal">
      <span class="mono numeric num">03</span>
      <h2 class="h2">{t('build.timelineTitle')}</h2>
    </div>
    <div class="timeline">
      {timeline.map((item) => (
        <div class="tl-item reveal">
          <span class="tl-date mono numeric">{item.date}</span>
          <div class="tl-body">
            <h3 class="tl-title">{item.title[lang]}</h3>
            <p>{item.desc[lang]}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="container-wide block">
    <div class="block-head reveal">
      <span class="mono numeric num">04</span>
      <h2 class="h2">{t('build.lessonsTitle')}</h2>
    </div>
    <div class="qa">
      {lessons.map((l) => (
        <div class="qa-item reveal">
          <h3 class="qa-q">{l.q[lang]}</h3>
          <p class="qa-a">{l.a[lang]}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-wide cta reveal">
    <div class="cta-inner">
      <p class="kicker">{t('nav.projects')}</p>
      <h2 class="h2">{t('projects.lead')}</h2>
      <a class="btn" href={localizePath('/projects', lang)}>
        {t('nav.projects')}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .head {
    padding-top: clamp(56px, 9vw, 110px);
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  .head-title {
    margin-top: 22px;
  }

  .head-lead {
    margin-top: 24px;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 5vw, 72px);
    margin-top: clamp(36px, 5vw, 60px);
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }

  .fact {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .fact-v {
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    letter-spacing: -0.02em;
    color: var(--cool);
  }

  .block {
    padding-block: clamp(40px, 6vw, 76px);
    border-top: 1px solid var(--line);
  }

  .block-head {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-bottom: clamp(28px, 3.5vw, 46px);
  }

  .num {
    color: var(--cool);
  }

  .stack-row {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 28px;
    padding-block: 20px;
    border-bottom: 1px solid var(--line);
  }

  .stack-row:first-child {
    border-top: 1px solid var(--line);
  }

  .stack-name {
    font-size: 14px;
    color: var(--text);
  }

  .stack-why {
    font-size: 13.5px;
    line-height: 1.85;
    color: var(--text-dim);
    max-width: 70ch;
  }

  .flow {
    display: grid;
    gap: 0;
  }

  .flow-row {
    display: grid;
    grid-template-columns: 200px 1fr 1fr;
    gap: clamp(20px, 3vw, 44px);
    padding-block: 24px;
    border-bottom: 1px solid var(--line);
  }

  .flow-row:first-child {
    border-top: 1px solid var(--line);
  }

  .flow-step {
    color: var(--text-dim);
  }

  .flow-col {
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .flow-label {
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--cool);
  }

  .flow-col p {
    font-size: 13.5px;
    line-height: 1.85;
    color: var(--text-dim);
  }

  .timeline {
    display: grid;
    position: relative;
  }

  .tl-item {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: clamp(20px, 3vw, 44px);
    padding-block: 22px;
    border-bottom: 1px solid var(--line);
  }

  .tl-item:first-child {
    border-top: 1px solid var(--line);
  }

  .tl-date {
    color: var(--text-faint);
    padding-top: 5px;
  }

  .tl-title {
    font-size: 16px;
    font-weight: 900;
    margin-bottom: 8px;
  }

  .tl-body p {
    font-size: 13.5px;
    line-height: 1.85;
    color: var(--text-dim);
    max-width: 72ch;
  }

  .qa {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(20px, 3vw, 40px);
  }

