---
import BaseLayout from '../layouts/BaseLayout.astro';
import heroVideo from '../assets/photo/star-trails-loop.mp4?url';
import heroPoster from '../assets/photo/star-trails-poster.webp?url';
import mobileHeroVideo from '../assets/photo/star-trails-mobile.mp4?url';
import WorkCard from '../components/WorkCard.astro';
import { works, featuredWorks } from '../data/works';
import { series } from '../data/series';
import { useTranslations, localizePath, withBase } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

const { lang = 'zh' } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
const hero = works.find((w) => w.slug === 'star-trails-river')!;

// 精选条固定顺序：双拱如玉、银河落入雪山置于末两位
const featuredOrder = [
  'meteor-over-ridge',
  'stars-fall-on-village',
  'under-the-milky-way',
  'twin-arches-jade',
  'galactic-arch-snow-mountain',
];
const featuredRank = (slug: string) => {
  const index = featuredOrder.indexOf(slug);
  return index === -1 ? featuredOrder.length : index;
};
const featuredByOrder = [...featuredWorks].sort((a, b) => featuredRank(a.slug) - featuredRank(b.slug));
// 手机端精选条按「最宽的一张 = 页面内容宽」反推统一高度，其余卡片按各自比例同步缩窄
const stripMaxRatio = Math.max(...featuredByOrder.map((w) => w.width / w.height));
---

<BaseLayout lang={lang} title={t('nav.photo')} description={t('photo.lead')} section="photo">
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroPoster} fetchpriority="high" />
  </Fragment>
  <section class="hero" data-hero>
    <video
      class="hero-video"
      data-src={heroVideo}
      data-mobile-src={mobileHeroVideo}
      autoplay
      preload="auto"
      poster={heroPoster}
      aria-label={hero.title[lang]}
      muted
      playsinline
      loop
    ></video>
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="hero-inner container-wide reveal">
      <p class="kicker">{t('photo.kicker')}</p>
      <h1 class="display-lg hero-title">{t('photo.title')}</h1>
      <p class="hero-lead">{t('photo.lead')}</p>
    </div>
    <div class="hero-meta container-wide reveal">
      <span class="mono">{hero.location[lang]}</span>
      <span class="mono">{hero.exif.aperture} · ISO {hero.exif.iso} · {hero.exif.shutter}</span>
      <button
        class="hero-motion-toggle"
        type="button"
        data-pause-label={t('photo.pauseMotion')}
        data-play-label={t('photo.playMotion')}
        hidden
      >{t('photo.pauseMotion')}</button>
      <span class="scroll-cue mono">SCROLL ↓</span>
    </div>
  </section>

  <section class="section container-wide">
    <div class="sec-head reveal">
      <div>
        <p class="kicker">{t('photo.featured')}</p>
        <h2 class="h2 sec-title">{t('photo.featuredDesc')}</h2>
      </div>
      <a class="btn" href={localizePath('/works', lang)}>
        {t('photo.viewAll')}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="strip reveal" style={`--strip-max-ratio:${stripMaxRatio.toFixed(4)}`}>
      <div class="strip-track">
        {[false, true].map((duplicate) => (
          <div class="strip-group" aria-hidden={duplicate ? 'true' : undefined}>
            {featuredByOrder.map((w) => (
              <div class="strip-item" style={`--ratio:${(w.width / w.height).toFixed(3)}`}>
                <WorkCard work={w} lang={lang} reveal={false} />
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section container-wide">
    <div class="sec-head reveal">
      <div>
        <p class="kicker">{t('photo.series')}</p>
        <h2 class="h2 sec-title">{t('photo.seriesDesc')}</h2>
      </div>
      <a class="btn" href={localizePath('/collections', lang)}>
        {t('photo.viewSeries')}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="series-grid">
      {series.map((s) => {
        const cover = works.find((w) => w.slug === s.cover)!;
        const count = works.filter((w) => w.series === s.slug).length;
        return (
          <a class="series-card reveal" href={localizePath(`/collections/${s.slug}`, lang)}>
            <span class="series-media" style={`background:${s.color}`}>
              <img src={withBase(cover.thumb)} alt={s.name[lang]} width={cover.width} height={cover.height} loading="lazy" decoding="async" />
            </span>
            <span class="series-info">
              <span class="series-top">
                <span class="series-name">{s.name[lang]}</span>
                <span class="mono">{count} {t('series.works')}</span>
              </span>
              <span class="series-region mono">{s.region[lang]}</span>
              <span class="series-desc">{s.desc[lang]}</span>
            </span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="atlas-band">
    <div class="container-wide atlas-inner">
      <div>
        <p class="kicker">{t('photo.atlasTitle')}</p>
        <h2 class="h2">{t('photo.atlasDesc')}</h2>
      </div>
      <a class="btn" href={`${localizePath('/collections', lang)}#map`}>
        {t('photo.atlasTitle')}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    /* 向上延伸，让首屏图覆盖到导航栏顶部 */
    margin-top: calc(var(--head-h, var(--nav-h)) * -1);
    padding-top: var(--head-h, var(--nav-h));
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0.25;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    padding-bottom: 40px;
  }

  .hero-title {
    margin-top: 20px;
    max-width: 20em;
    font-size: clamp(2.1rem, 4.6vw, 3.9rem);
    line-height: 1.14;
    letter-spacing: -0.02em;
    font-weight: 900;
    text-wrap: balance;
  }

  .hero-lead {
    margin-top: 22px;
    max-width: 38em;
    font-size: clamp(0.95rem, 1.25vw, 1.08rem);
    line-height: 1.9;
    color: rgba(232, 236, 246, 0.78);
    text-wrap: pretty;
  }

  .hero-meta {
    position: relative;
    display: flex;
    gap: 28px;
    align-items: center;
    flex-wrap: wrap;
    padding-block: 18px;
  }

  .scroll-cue {
    margin-left: auto;
    color: rgba(255, 255, 255, 0.5);
  }

  .hero-motion-toggle {
    margin: -6px 0 -6px auto;
    padding: 6px 10px;
    border: 0;
    border-radius: 4px;
    background: rgb(8 16 28 / 72%);
    color: #eef2fa;
    font: inherit;
    font-size: 12px;
    white-space: nowrap;
    cursor: pointer;
  }

  .hero-motion-toggle:hover {
    background: rgb(16 27 43 / 92%);
  }

  .hero-motion-toggle:focus-visible {
    outline: 2px solid #eef2fa;
    outline-offset: 3px;
  }

  .hero-motion-toggle:not([hidden]) + .scroll-cue {
    margin-left: 0;
  }

  .sec-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .sec-title {
    margin-top: 16px;
    max-width: 24em;
    color: var(--text);
    font-weight: 900;
    text-wrap: balance;
  }

  /* 精选条自动向左匀速滚动：内容成组复制一份，位移一组宽度后无缝衔接 */
  .strip {
    --strip-gap: clamp(16px, 2vw, 28px);
    overflow: hidden;
    padding-bottom: 18px;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    /* 以自身内容宽为查询容器，手机端据此让最宽的一张刚好铺满页面内容宽 */
    container-type: inline-size;
  }

  .strip-track {
    display: flex;
    width: max-content;
    animation: strip-scroll 60s linear infinite;
  }

  .strip-group {
    display: flex;
    align-items: start;
    gap: var(--strip-gap);
    padding-right: var(--strip-gap);
  }

  @keyframes strip-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .strip-item {
    --card-h: 427px;
    flex: 0 0 auto;
    width: calc(var(--card-h) * var(--ratio, 1));
  }

  /* 精选条内统一为单行说明，避免文字折行影响卡片整体高度 */
  .strip-item :global(.meta) {
    flex-wrap: nowrap;
  }

  .strip-item :global(.name) {
    font-size: 12px;
  }

  .strip-item :global(.meta > .sub:not(.dim)) {
    display: none;
  }

  .series-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(20px, 3vw, 44px);
  }

  .series-card {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 22px;
    align-items: stretch;
    border-top: 1px solid var(--line);
    padding-top: 22px;
  }

  .series-media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .series-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease);
    opacity: 0.92;
  }

  .series-card:hover .series-media img {
    transform: scale(1.05);
    opacity: 1;
  }

  .series-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-block: 4px;
  }

  .series-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .series-name {
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .series-region {
    color: var(--text-faint);
  }

  .series-desc {
    font-size: 13px;
    line-height: 1.75;
    color: var(--text-dim);
    text-wrap: pretty;
  }

  .atlas-band {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(40px, 6vw, 72px);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.015), transparent);
  }

  .atlas-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    flex-wrap: wrap;
  }

  .atlas-inner .h2 {
    margin-top: 14px;
    max-width: 30em;
    font-weight: 900;
    color: var(--text-dim);
    text-wrap: balance;
  }

  /* 首屏图已铺到导航背后：顶部直接使用与滚动后一致的玻璃效果 */
  :global(html[data-world='photo'] .site-head) {
    background: var(--glass-bg-scrolled);
    -webkit-backdrop-filter: blur(28px) saturate(190%);
    backdrop-filter: blur(28px) saturate(190%);
    box-shadow: var(--glass-shadow), inset 0 1px 0 var(--glass-highlight),
      0 12px 28px -22px rgba(0, 0, 0, 0.6);
  }

  /* 手机端：首屏动画按设备宽度完整呈现，避免 3:2 横屏画面被纵向放大后裁掉两侧 */
  @media (max-width: 768px) {
    .hero {
      min-height: 0;
      padding-top: 0;
      justify-content: flex-start;
    }

    /* 动画顶到页面最上方，与导航栏顶部对齐 */
    .hero-video,
    .hero-veil {
      inset: 0 0 auto;
      height: auto;
      aspect-ratio: 3 / 2;
    }

    .hero-veil {
      opacity: 1;
      background: linear-gradient(to bottom, rgb(0 0 0 / 0%) 58%, #000 100%);
    }

    /* 照片信息合成一行，滚动提示紧贴其下方右对齐 */
    .hero-meta {
      order: -1;
      margin: calc(66.6667% + 12px) auto 0;
      padding-block: 0;
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px 12px;
      text-align: left;
    }

    .hero-meta > .mono:not(.scroll-cue) {
      white-space: nowrap;
    }

    /* 暂停按钮贴在动画右下角 */
    .hero-motion-toggle {
      position: absolute;
      top: 0;
      right: 0;
      left: auto;
      margin: 0;
      transform: translateY(calc(-100% - 22px));
    }

    .scroll-cue {
      flex-basis: 100%;
      margin: 0;
      text-align: right;
    }

    /* 标题上移贴近信息区，标题下方的留白同步收紧 */
    .hero-inner {
      padding-top: 44px;
      padding-bottom: 48px;
    }
  }

  @media (max-width: 960px) {
    .series-grid {
      grid-template-columns: 1fr;
    }
    .strip-item {
      --card-h: 292px;
    }
  }

  @media (max-width: 600px) {
    .series-card {
      grid-template-columns: 1fr;
    }
  }

  /* 手机端：精选条最宽的一张铺满页面内容宽，其余卡片同高、按原比例缩窄；模块间距整体收紧 */
  @media (max-width: 768px) {
    .strip-item {
      --card-h: calc(100cqw / var(--strip-max-ratio, 2.1429));
    }

    .section {
      padding-block: 44px;
    }

    .sec-head {
      margin-bottom: 20px;
      gap: 16px;
    }

    .atlas-band {
      padding-block: 36px;
    }
  }
</style>

<script>
  import { attachVideoLoop } from '../scripts/video-loop';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const toggle = hero?.querySelector<HTMLButtonElement>('.hero-motion-toggle');
  const video = hero?.querySelector<HTMLVideoElement>('.hero-video');
  function setupPlayback(video: HTMLVideoElement, toggle: HTMLButtonElement) {
    // The star trails are the hero work itself. The page button controls playback.
    let wantsPlayback = true;
    let playbackAttempt = 0;
    let sourceReady: Promise<void> | undefined;

    async function downloadVideo(url: string) {
      const response = await fetch(url, { cache: 'force-cache', priority: 'high' });
      if (!response.ok) throw new Error(`Video request failed (${response.status})`);
      return response.blob();
    }

    function prepareSource(manual: boolean) {
      // A native, fast-start MP4 can play on touch devices as bytes arrive.
      if (matchMedia('(pointer: coarse), (max-width: 1024px)').matches) {
        video.src = video.dataset.mobileSrc!;
        return;
      }
      const url = video.dataset.src!;
      const useNativeSource = (source: string | Blob) => {
        video.loop = true;
        video.src = typeof source === 'string' ? source : URL.createObjectURL(source);
      };
      const attachLoop = (source: string | Blob) => attachVideoLoop(video, source, (file) => {
        useNativeSource(file ?? url);
        if (wantsPlayback) void syncPlayback();
      });

      if (attachLoop(url)) return;
      if (manual) {
        useNativeSource(url);
        return;
      }
      return downloadVideo(url).then((file) => {
        if (wantsPlayback && !video.hasAttribute('src')) useNativeSource(file);
      });
    }

    function updateLabel() {
      toggle.textContent = (wantsPlayback ? toggle.dataset.pauseLabel : toggle.dataset.playLabel) ?? '';
    }

    async function syncPlayback(manual = false) {
      const attempt = ++playbackAttempt;
      updateLabel();
      if (!wantsPlayback) {
        video.pause();
        return;
      }
      try {
        if (!video.hasAttribute('src')) {
          if (manual) prepareSource(true);
          else {
            sourceReady ??= prepareSource(false) || undefined;
            if (sourceReady) await sourceReady;
          }
        }
        if (attempt !== playbackAttempt) return;
        await video.play();
      } catch {
        // A pause or a fallback source can interrupt an older play() request.
        if (attempt !== playbackAttempt) return;
        if (video.error) {
          URL.revokeObjectURL(video.src);
          video.removeAttribute('src');
          video.load();
        }
        if (!video.hasAttribute('src')) sourceReady = undefined;
        wantsPlayback = false;
        updateLabel();
      }
    }

    video.muted = true;
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      wantsPlayback = !wantsPlayback;
      void syncPlayback(true);
    });

    void syncPlayback();
  }
  if (video && toggle) setupPlayback(video, toggle);
</script>
