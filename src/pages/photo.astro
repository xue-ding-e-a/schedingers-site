---
import BaseLayout from '../layouts/BaseLayout.astro';
import heroVideo from '../assets/photo/star-trails-loop.mp4?url';
import heroPoster from '../assets/photo/star-trails-poster.webp?url';
import mobilePoster from '../assets/photo/star-trails-poster-mobile.webp?url';
import DeferredPreview from '../components/DeferredPreview.astro';
import WorkCard from '../components/WorkCard.astro';
import { works, featuredWorks } from '../data/works';
import { series } from '../data/series';
import { previewImage } from '../data/work-images';
import { useTranslations, localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

const { lang = 'zh' } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
const hero = works.find((w) => w.slug === 'star-trails-river')!;

// 精选条固定顺序：双拱如玉、银河落入雪山置于末两位
const featuredOrder = [
  'meteor-over-ridge',
  'stars-fall-on-village',
  'under-the-milky-way',
  'twin-arches-jade',
  'galactic-arch-snow-mountain',
];
const featuredRank = (slug: string) => {
  const index = featuredOrder.indexOf(slug);
  return index === -1 ? featuredOrder.length : index;
};
const featuredByOrder = [...featuredWorks].sort((a, b) => featuredRank(a.slug) - featuredRank(b.slug));
---

<BaseLayout lang={lang} title={t('nav.photo')} description={t('photo.lead')} section="photo">
  <section class="hero" data-hero>
    <picture class="hero-poster">
      <source media="(max-width: 760px) and (orientation: portrait)" srcset={mobilePoster} />
      <img src={heroPoster} alt={hero.title[lang]} width="1280" height="854" fetchpriority="high" />
    </picture>
    <video class="hero-video" data-src={heroVideo} preload="none" aria-hidden="true" muted playsinline loop></video>
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="hero-inner container-wide">
      <p class="kicker">{t('photo.kicker')}</p>
      <h1 class="display-lg hero-title">{t('photo.title')}</h1>
      <p class="hero-lead">{t('photo.lead')}</p>
    </div>
    <div class="hero-meta container-wide">
      <span class="mono">{hero.location[lang]}</span>
      <span class="mono">{hero.exif.aperture} · ISO {hero.exif.iso} · {hero.exif.shutter}</span>
      <button
        class="hero-motion-toggle"
        type="button"
        data-pause-label={t('photo.pauseMotion')}
        data-play-label={t('photo.playMotion')}
        hidden
      >{t('photo.playMotion')}</button>
      <span class="scroll-cue mono">SCROLL ↓</span>
    </div>
  </section>

  <section class="section container-wide">
    <div class="sec-head reveal">
      <div>
        <p class="kicker">{t('photo.featured')}</p>
        <h2 class="h2 sec-title">{t('photo.featuredDesc')}</h2>
      </div>
      <a class="btn" href={localizePath('/works', lang)}>
        {t('photo.viewAll')}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="strip reveal" data-photo-previews>
      <div class="strip-track">
        {[false, true].map((duplicate) => (
          <div class="strip-group" aria-hidden={duplicate ? 'true' : undefined}>
            {featuredByOrder.map((w) => (
              <div class="strip-item" style={`--ratio:${(w.width / w.height).toFixed(3)}`}>
                <WorkCard work={w} lang={lang} reveal={false} deferPreview
                  sizes={`(max-width: 960px) ${Math.ceil(292 * w.width / w.height)}px, ${Math.ceil(427 * w.width / w.height)}px`} />
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section container-wide">
    <div class="sec-head reveal">
      <div>
        <p class="kicker">{t('photo.series')}</p>
        <h2 class="h2 sec-title">{t('photo.seriesDesc')}</h2>
      </div>
      <a class="btn" href={localizePath('/collections', lang)}>
        {t('photo.viewSeries')}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="series-grid" data-photo-previews>
      {series.map((s) => {
        const cover = works.find((w) => w.slug === s.cover)!;
        const count = works.filter((w) => w.series === s.slug).length;
        return (
          <a class="series-card reveal" href={localizePath(`/collections/${s.slug}`, lang)}>
            <span class="series-media" style={`background:${s.color}`}>
              <DeferredPreview>
                <img {...previewImage(cover)} sizes="(max-width: 600px) 90vw, (max-width: 960px) 40vw, 21vw"
                  alt={s.name[lang]} width={cover.width} height={cover.height} loading="lazy" decoding="async" />
              </DeferredPreview>
            </span>
            <span class="series-info">
              <span class="series-top">
                <span class="series-name">{s.name[lang]}</span>
                <span class="mono">{count} {t('series.works')}</span>
              </span>
              <span class="series-region mono">{s.region[lang]}</span>
              <span class="series-desc">{s.desc[lang]}</span>
            </span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="atlas-band">
    <div class="container-wide atlas-inner reveal">
      <div>
        <p class="kicker">{t('photo.atlasTitle')}</p>
        <h2 class="h2">{t('photo.atlasDesc')}</h2>
      </div>
      <a class="btn" href={`${localizePath('/collections', lang)}#map`}>
        {t('photo.atlasTitle')}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    background: #10151f;
    /* 向上延伸，让首屏图覆盖到导航栏顶部 */
    margin-top: calc(var(--head-h, var(--nav-h)) * -1);
    padding-top: var(--head-h, var(--nav-h));
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
  }

  .hero-poster, .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-poster img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-video { opacity: 0; }
  .hero-video.is-visible { opacity: 1; }

  .hero-veil {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0.25;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    padding-bottom: 40px;
  }

  .hero-title {
    margin-top: 20px;
    max-width: 20em;
    font-size: clamp(2.1rem, 4.6vw, 3.9rem);
    line-height: 1.14;
    letter-spacing: -0.02em;
    font-weight: 900;
    text-wrap: balance;
  }

  .hero-lead {
    margin-top: 22px;
    max-width: 38em;
    font-size: clamp(0.95rem, 1.25vw, 1.08rem);
    line-height: 1.9;
    color: rgba(232, 236, 246, 0.78);
    text-wrap: pretty;
  }

  .hero-meta {
    position: relative;
    display: flex;
    gap: 28px;
    align-items: center;
    flex-wrap: wrap;
    padding-block: 18px;
  }

  .scroll-cue {
    margin-left: auto;
    color: rgba(255, 255, 255, 0.5);
  }

  .hero-motion-toggle {
    margin: -6px 0 -6px auto;
    padding: 6px 10px;
    border: 0;
    border-radius: 4px;
    background: rgb(8 16 28 / 72%);
    color: #eef2fa;
    font: inherit;
    font-size: 12px;
    white-space: nowrap;
    cursor: pointer;
  }

  .hero-motion-toggle:hover {
    background: rgb(16 27 43 / 92%);
  }

  .hero-motion-toggle:focus-visible {
    outline: 2px solid #eef2fa;
    outline-offset: 3px;
  }

  .hero-motion-toggle:not([hidden]) + .scroll-cue {
    margin-left: 0;
  }

  .sec-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .sec-title {
    margin-top: 16px;
    max-width: 24em;
    color: var(--text);
    font-weight: 900;
    text-wrap: balance;
  }

  /* 精选条自动向左匀速滚动：内容成组复制一份，位移一组宽度后无缝衔接 */
  .strip {
    --strip-gap: clamp(16px, 2vw, 28px);
    overflow: hidden;
    padding-bottom: 18px;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
  }

  .strip-track {
    display: flex;
    width: max-content;
    animation: strip-scroll 60s linear infinite;
  }

  .strip-group {
    display: flex;
    align-items: start;
    gap: var(--strip-gap);
    padding-right: var(--strip-gap);
  }

  @keyframes strip-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .strip-item {
    --card-h: 427px;
    flex: 0 0 auto;
    width: calc(var(--card-h) * var(--ratio, 1));
  }

  /* 精选条内统一为单行说明，避免文字折行影响卡片整体高度 */
  .strip-item :global(.meta) {
    flex-wrap: nowrap;
  }

  .strip-item :global(.meta > .sub:not(.dim)) {
    display: none;
  }

  .series-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(20px, 3vw, 44px);
  }

  .series-card {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 22px;
    align-items: stretch;
    border-top: 1px solid var(--line);
    padding-top: 22px;
  }

  .series-media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .series-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease);
    opacity: 0.92;
  }

  .series-card:hover .series-media img {
    transform: scale(1.05);
    opacity: 1;
  }

  .series-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-block: 4px;
  }

  .series-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .series-name {
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .series-region {
    color: var(--text-faint);
  }

  .series-desc {
    font-size: 13px;
    line-height: 1.75;
    color: var(--text-dim);
    text-wrap: pretty;
  }

  .atlas-band {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(40px, 6vw, 72px);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.015), transparent);
  }

  .atlas-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    flex-wrap: wrap;
  }

  .atlas-inner .h2 {
    margin-top: 14px;
    max-width: 30em;
    font-weight: 900;
    color: var(--text-dim);
    text-wrap: balance;
  }

  /* 首屏图已铺到导航背后：顶部直接使用与滚动后一致的玻璃效果 */
  :global(html[data-world='photo'] .site-head) {
    background: var(--glass-bg-scrolled);
    -webkit-backdrop-filter: blur(28px) saturate(190%);
    backdrop-filter: blur(28px) saturate(190%);
    box-shadow: var(--glass-shadow), inset 0 1px 0 var(--glass-highlight),
      0 12px 28px -22px rgba(0, 0, 0, 0.6);
  }

  @media (max-width: 960px) {
    .series-grid {
      grid-template-columns: 1fr;
    }
    .strip-item {
      --card-h: 292px;
    }
  }

  @media (max-width: 600px) {
    .series-card {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { preferLightMotion } from '../scripts/page-performance';
  import { attachVideoLoop } from '../scripts/video-loop';

  const poster = document.querySelector<HTMLImageElement>('.hero-poster img');
  const toggle = document.querySelector<HTMLButtonElement>('.hero-motion-toggle');
  const video = document.querySelector<HTMLVideoElement>('.hero-video');

  if (video && toggle && poster) {
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const lightMotion = preferLightMotion();
    let userControlled = false;
    let wantsPlayback = false;
    let playAttempt = 0;

    const updateLabel = () => {
      toggle.textContent = (wantsPlayback ? toggle.dataset.pauseLabel : toggle.dataset.playLabel) ?? '';
    };

    const useNativeLoop = (url: string) => {
      video.loop = true;
      video.src = url;
    };

    const prepareSource = () => {
      const url = video.dataset.src!;
      try {
        if (attachVideoLoop(video, url, (file) => {
          video.classList.remove('is-visible');
          useNativeLoop(file ? URL.createObjectURL(file) : url);
          if (wantsPlayback) void play();
        })) return;
      } catch {
        // If continuous playback cannot be initialized, use the MP4 directly.
      }
      useNativeLoop(url);
    };

    const play = async () => {
      const attempt = ++playAttempt;
      wantsPlayback = true;
      updateLabel();
      try {
        if (!video.getAttribute('src')) prepareSource();
        await video.play();
      } catch {
        if (attempt !== playAttempt) return;
        if (video.error) resetPlayback();
        else pause();
      }
    };

    const pause = () => {
      playAttempt++;
      wantsPlayback = false;
      video.pause();
      updateLabel();
    };

    const resetPlayback = () => {
      pause();
      video.classList.remove('is-visible');
      if (video.src.startsWith('blob:')) URL.revokeObjectURL(video.src);
      video.removeAttribute('src');
      video.load();
    };

    video.addEventListener('error', () => {
      if (video.loop && video.error) resetPlayback();
    });
    video.addEventListener('playing', () => {
      if (!video.paused) video.classList.add('is-visible');
    });
    toggle.addEventListener('click', () => {
      userControlled = true;
      if (wantsPlayback) pause();
      else void play();
    });
    const autoplay = () => {
      if (motion.matches || userControlled || lightMotion) return;
      requestAnimationFrame(() => requestAnimationFrame(() => {
        if (!userControlled && !wantsPlayback && !motion.matches && !document.hidden &&
            poster.naturalWidth && video.getBoundingClientRect().bottom > 0) void play();
      }));
    };

    motion.addEventListener?.('change', () => {
      if (motion.matches) {
        pause();
        video.classList.remove('is-visible');
      } else if (poster.complete) {
        autoplay();
      }
    });
    toggle.hidden = false;
    if (poster.complete) autoplay();
    else poster.addEventListener('load', autoplay, { once: true });
  }

  const showPreviews = (section: Element) => {
    for (const preview of section.querySelectorAll<HTMLTemplateElement>('template[data-photo-preview]')) {
      preview.replaceWith(preview.content);
    }
  };
  const sections = document.querySelectorAll('[data-photo-previews]');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const { target, isIntersecting } of entries) {
        if (!isIntersecting) continue;
        observer.unobserve(target);
        showPreviews(target);
      }
    }, { rootMargin: '64px 0px' });
    sections.forEach((section) => observer.observe(section));
  } else {
    sections.forEach(showPreviews);
  }
</script>
